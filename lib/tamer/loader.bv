// 2026-07-25: Tamer loader — parse .bounty and .lair binary formats.
// Pure Briev, no Alloc# needed. Uses Ptr<Int> for raw byte access.

// ── Bytecode read helpers ────────────────────────────────────────────────
// NOTE: Inline implementation to avoid VM call mechanism bugs.
// Function calls within the VM don't properly return values for
// subsequent calls from the same caller. All reads are inlined.

defn read_u8(bc: Ptr<Int>, addr: Int) -> Int {
    let word = bc[addr / 8];
    let byte_off = addr % 8;
    term (word >> (byte_off * 8)) & 0xFF;
};

defn read_i8(bc: Ptr<Int>, addr: Int) -> Int {
    let raw = read_u8(bc, addr);
    when raw >= 128 { term raw - 256; };
    term raw;
};

// 2026-08-23: every multi-byte reader stitches BYTES via read_u8 — the old
// word-shift forms broke on unaligned offsets that span two words (e.g.
// byte offset 567: 567%8==7 put the operand past the word edge and
// read_i16 returned junk). To undo: restore the word-shift bodies.
defn read_u16(bc: Ptr<Int>, addr: Int) -> Int {
    term read_u8(bc, addr) | (read_u8(bc, addr + 1) << 8);
};

import { POW2_15, POW2_16, POW2_31, POW2_32 } from "std/constants.bv";

defn read_i16(bc: Ptr<Int>, addr: Int) -> Int {
    let raw = read_u16(bc, addr);
    when raw >= POW2_15 { term raw - POW2_16; };
    term raw;
};

defn read_u32(bc: Ptr<Int>, addr: Int) -> Int {
    term read_u8(bc, addr)
        | (read_u8(bc, addr + 1) << 8)
        | (read_u8(bc, addr + 2) << 16)
        | (read_u8(bc, addr + 3) << 24);
};

defn read_i32(bc: Ptr<Int>, addr: Int) -> Int {
    let raw = read_u32(bc, addr);
    when raw >= POW2_31 { term raw - POW2_32; };
    term raw;
};

defn read_i64(bc: Ptr<Int>, addr: Int) -> Int {
    let lo = read_u32(bc, addr);
    let hi = read_u32(bc, addr + 4);
    term lo | (hi << 32);
};

// ── Function table entries ───────────────────────────────────────────────
// Each entry: name_idx(4) + bc_offset(8) + bc_len(4) + local_count(2) + arg_count(2) = 20 bytes

defn fn_bc_offset(fn_table: Ptr<Int>, foff: Int, fn_idx: Int) -> Int {
    term read_i64(fn_table, foff + fn_idx * 20 + 4);
};

defn fn_bc_len(fn_table: Ptr<Int>, foff: Int, fn_idx: Int) -> Int {
    term read_u32(fn_table, foff + fn_idx * 20 + 12);
};

defn fn_local_count(fn_table: Ptr<Int>, foff: Int, fn_idx: Int) -> Int {
    term read_u16(fn_table, foff + fn_idx * 20 + 16);
};

defn fn_arg_count(fn_table: Ptr<Int>, foff: Int, fn_idx: Int) -> Int {
    term read_u16(fn_table, foff + fn_idx * 20 + 18);
};

