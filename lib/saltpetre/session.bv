// session.bv — Saltpetre's arena lifecycle owner.
//
// The library owns the two request-scoped arenas so service code stays RPC
// glue: one tensor-arena block for activations (ml_arena_* in tensor.bv)
// and one request coll block for generic coll backing stores (the C request
// arena behind coll_alloc). Begin once at service start, reset per request,
// end on shutdown. sp_run resets the inference arena per run and copies the
// requested output out of the request arena, so a returned Tensor survives
// the next reset.

import "./tensor.bv";
import "./exec.bv";
import "std/result.bv";

// sp_begin — allocate the tensor-arena block and open the request coll
// arena. Call once per service lifetime, from a NODE-ENTRY context: the
// Alloc# picks the entry region allocator, which lives for the program, so
// the activation block survives every request reset (the kiosk daemon's
// identical node-entry pattern is the reference use). Calling sp_begin
// inside a per-tick txn would tie the block to a per-tick region — do not.
// tensor_cap sizes the activation block; coll_cap sizes the request coll
// block (kiosk uses 512 MiB / 64 MiB).
defn sp_begin(tensor_cap: Int, coll_cap: Int)
    [tensor_cap > 0 && coll_cap >= 0][ml_arena_off_bytes() == 0]
    -> Void {
    let base: Int = Alloc#(tensor_cap) as Int;
    ml_arena_install(base, tensor_cap);
    coll_arena_begin(coll_cap);
    term;
};

// sp_request_reset — per-request valve: both arenas rewind without freeing.
defn sp_request_reset() [ml_arena_off_bytes() >= 0][ml_arena_off_bytes() == 0] -> Void {
    ml_arena_reset();
    coll_arena_reset();
    term;
};

// sp_run — one inference at out_index, with the per-run arena reset and an
// owned copy of the output so the result outlives the next reset.
defn sp_run(graph: OnnxGraph, input: Tensor, out_index: Int)
    [out_index >= 0][ml_arena_off_bytes() >= 0]
    -> Result<Tensor, String>
{
    ml_arena_reset();
    let result: Result<Tensor, String> = execute(graph, input, out_index);
    when is_ok(result) {
        let owned: Tensor = tensor_copy_owned(unwrap(result));
        term Ok(owned);
    };
    term result;
};

// sp_run_env — whole-graph run (every output), per-run arena reset. Outputs
// live in the request arena; copy out (tensor_copy_owned) anything that must
// survive the next reset.
defn sp_run_env(graph: OnnxGraph, input: Tensor)
    [graph.outs.Count#() >= 0][ml_arena_off_bytes() >= 0]
    -> Result<List<Tensor>, String>
{
    ml_arena_reset();
    term execute_env(graph, input);
};

// sp_end — close the request coll arena and disarm the tensor arena.
defn sp_end() [ml_arena_off_bytes() >= 0][ml_arena_off_bytes() == 0] -> Void {
    coll_arena_end();
    ml_arena_install(0, 0);
    term;
};
