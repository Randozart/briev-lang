// tensor.bv — flat f32 tensors with NCHW-style shape metadata.
//
// Storage is [ptr: Int] to a heap block with `n` f32 slots at stride 4 bytes.
// Activations allocate from the per-inference arena when one is installed;
// model weights/temporaries use owned Malloc blocks. Dims carry the logical
// shape; kernels index flat and read shape as needed.

// 2026-11-22 (op-backend ledger plan, S2): shape arithmetic and word decoding
// are no longer defined here — they are Tensor-free leaves and now live on the
// stdlib floor. See lib/std/tensor_util.bv and lib/std/bits.bv.
import "std/tensor_util.bv";
import "std/bits.bv";

obj Tensor {
    name: String;
    dims: List<Int>;
    // 2026-11-12 (dims owner slot): 1 = this Tensor built (and owns) its
    // dims list; tensor_drop destroys the list. 0 = the dims list is
    // borrowed (elementwise views, copy_owned, rename, cached-graph input
    // wraps) and must outlive this handle.
    owns_dims: Int;
    n: Int;
    ptr: Int;
    arena: Bool;
};

// ── Per-inference arena ────────────────────────────────────────────────
// Backing block is one plain `Alloc#()` in the node/test entry; the compiler
// selects the tick arena (cell transaction analysis). This layer bumps
// offsets within that block and resets after the request.
let ml_arena_base: Int = 0;
let ml_arena_off: Int = 0;
let ml_arena_cap: Int = 0;
let ml_arena_on: Int = 0;

defn ml_arena_install(base: Int, cap: Int) -> Void {
    ml_arena_base = base;
    ml_arena_off = 0;
    ml_arena_cap = cap;
    ml_arena_on = 0; when cap > 0 && base != 0 { ml_arena_on = 1; };
    term;
};

defn ml_arena_reset() -> Void {
    ml_arena_off = 0;
    term;
};

// 2026-11-15: the getter's `[term >= 0]` is unprovable and stays so — the body
// reads a module global, and globals are outside the state-free analysis model
// (the prover reports this body as *skipped*, not unproven). Stating
// `[ml_arena_off >= 0]` as a precondition was tried and reverted: it puts a
// global into a contract, which changes how the global is lowered, for a fact
// the prover cannot consume anyway. The invariant is instead documented here —
// every writer keeps it (install/reset store 0; tensor_alloc adds a
// non-negative `need`) — and the postcondition is left intact rather than
// weakened to make a skipped body look clean.
defn ml_arena_off_bytes() [true][term >= 0] -> Int {
    term ml_arena_off;
};

defn tensor_alloc(n: Int) -> (Int, Bool) {
    let need: Int = n * 4;
    when ml_arena_on != 0 && ml_arena_off + need <= ml_arena_cap {
        let p: Int = ml_arena_base + ml_arena_off;
        ml_arena_off = ml_arena_off + need;
        term (p, true);
    };
    term (Malloc#(need) as Int, false);
};

defn tensor_alloc_owned(n: Int) -> Int {
    term Malloc#(n * 4) as Int;
};

defn tensor_empty() -> Tensor {
    let dims: List<Int> = [];
    term Tensor { name: "", dims: dims, owns_dims: 1, n: 0, ptr: 0, arena: false };
};

defn tensor_new(n: Int) [n >= 0][true] -> Tensor {
    let (addr, in_arena) = tensor_alloc(n);
    let dims: List<Int> = [];
    term Tensor { name: "", dims: dims, owns_dims: 1, n: n, ptr: addr, arena: in_arena };
};

// tensor_named — BORROW constructor: the dims list is not owned; the handle
// must outlive the returned Tensor (elementwise views wrap the input's
// dims; execute_env_inputs wraps cached-graph dims). Builders with a fresh
// list use tensor_take.
defn tensor_named(name: String, dims: List<Int>, n: Int) -> Tensor {
    let (addr, in_arena) = tensor_alloc(n);
    term Tensor { name: name, dims: dims, owns_dims: 0, n: n, ptr: addr, arena: in_arena };
};

// tensor_take — OWNING constructor: the returned Tensor owns the dims list
// and tensor_drop destroys it. For freshly built shape lists.
// 2026-11-20 (issue #149 fallout): the post states `n` — the element count
// the caller already knows — so `tensor_set(t, i, v)`'s `i < t.n` bound is
// provable from the same bound the caller used to size the loop.
defn tensor_take(name: String, dims: List<Int>, n: Int) [true][term.n == n] -> Tensor {
    let (addr, in_arena) = tensor_alloc(n);
    term Tensor { name: name, dims: dims, owns_dims: 1, n: n, ptr: addr, arena: in_arena };
};

// 2026-11-20 (issue #149 fallout): the post states `n` — the element count
// the caller already knows — so `tensor_set(t, i, v)`'s `i < t.n` bound is
// provable from the same bound the caller used to size the loop.
defn tensor_named_owned(name: String, dims: List<Int>, n: Int) [true][term.n == n] -> Tensor {
    let addr: Int = tensor_alloc_owned(n);
    term Tensor { name: name, dims: dims, owns_dims: 1, n: n, ptr: addr, arena: false };
};

// 2026-11-20 (issue #149 fallout): the post states `n` — the element count
// the caller already knows — so `tensor_set(t, i, v)`'s `i < t.n` bound is
// provable from the same bound the caller used to size the loop.
defn tensor_named4(name: String, dims: List<Int>, n: Int) [true][term.n == n] -> Tensor {
    let addr: Int = tensor_alloc_owned(n);
    term Tensor { name: name, dims: dims, owns_dims: 1, n: n, ptr: addr, arena: false };
};

defn string_free(s: String) -> Void {
    when (s ^^Length) > 0 {
        Free#(((s as Data) as Int) as Ptr<Bit<8>>);
    };
    term;
};

defn tensor_drop(t: Tensor) -> Void {
    tensor_free(t);
    // Dims owner slot: destroy the shape list only when this handle built
    // it. coll_destroy is arena-aware — request-arena list blocks are
    // skipped (the block owns them), malloc'd ones are freed.
    when t.owns_dims != 0 {
        let dims_handle: Int = (t.dims as Data) as Int;
        // The `as Int` is load-bearing for the H4.2 comparison view: pass-
        // inserted releases are bare-identifier calls, authored ones carry a
        // cast — the view strips only the bare shape.
        // 2026-11-20: an address is 0 or positive, so `> 0` is the same test as
        // `!= 0` and it is the one that proves `coll_destroy`'s
        // `dims >= 0` precondition from a dominating fact.
        when dims_handle > 0 { coll_destroy(dims_handle as Int); };
    };
    when t.ptr != 0 {
        Free#(((t as Data) as Int) as Ptr<Bit<8>>);
    };
    term;
};

defn tensor_copy_owned(t: Tensor) -> Tensor {
    let addr: Int = tensor_alloc_owned(t.n);
    let copy: Tensor = Tensor { name: t.name, dims: t.dims, owns_dims: 0, n: t.n, ptr: addr, arena: false };
    foreach i in 0..t.n { tensor_set(copy, i, tensor_get(t, i)); };
    term copy;
};

defn tensor_free(t: Tensor) -> Void {
    when t.ptr != 0 && !t.arena {
        Free#(t.ptr as Ptr<Bit<8>>);
    };
    term;
};

defn tensor_get(t: Tensor, i: Int) [i >= 0 && i < t.n][true] -> Float {
    let base: Ptr<Float> = t.ptr as Ptr<Float>;
    term base[i];
};

defn tensor_set(t: Tensor, i: Int, v: Float) [i >= 0 && i < t.n][true] -> Void {
    let base: Ptr<Float> = t.ptr as Ptr<Float>;
    base[i] = v;
    term;
};

defn tensor_rename(t: Tensor, name: String) -> Tensor {
    term Tensor { name: name, dims: t.dims, owns_dims: 0, n: t.n, ptr: t.ptr, arena: t.arena };
};

defn tensor_byte_store(t: Tensor, at: Int, v: Int) -> Void {
    let base: Ptr<Bit<8>> = t.ptr as Ptr<Bit<8>>;
    base[at] = v as Bit<8>;
    term;
};
