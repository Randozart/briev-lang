// JSON - Pure-Briev JSON parser/writer (RFC 8259 subset)
// Authored in part by Otto Westerlund (@odecode); adopted with attribution,
// see docs/contributors/otto-westerlund.md.
// Tier 2: String & Text Processing
//
// STATUS 2026-10-21: bounded recursive descent. The 2026-10-05 callable-txn
// migration established interpreter/backend parity; malformed-input probes
// subsequently exposed progress and framing errors. The strict parser below
// preserves that parity while consuming input or returning an error per step.
//
// 2026-08-23 (Leg 2, json.bv migration): restored from the archive and
// migrated to current idioms: stdlib char_at/is_digit/is_hex_digit/
// digit_to_int/hex_digit_to_int, tuple element access via `.0`/`.1`
// (not the old `[0]`), `Err` for the hex-escape failure, and single
// wrapping of the Array/Object frames. Local `parse_int_digits` renamed
// to `json_int_digits` (collided with std/cast_lanes). API:
//   json_parse(s) -> Result<JsonValue, String>
//   json_get(v, key) -> Result<String, String>      (string values)
//   json_get_by_index(v, i) -> Result<JsonValue, String>
//   json_is_array(v) -> Bool ; json_length(v) -> Int
//   json_stringify(value) -> Result<String, String>

import "std/char";
import "std/collections.bv";
import "std/iterator.bv";
// 2026-10-21: the builder conversion shares a spelling with integer string
// conversion. Give this dependency an explicit local name so JSON composes
// with database/string users; keep the alias if builder internals change.
import { StringBuilder, new_builder, append_char, append_str, json_builder_string: to_string } from "std/string_builder";
import "std/result";

obj ParseFrame {
    value: JsonValue;
    pos: Int;
};

enum JsonValue {
    Null,
    BoolVal(Bool),
    IntVal(Int),
    FloatVal(Float),
    StrVal(String),
    Array(List<JsonValue>),
    Object(List<(String, JsonValue)>)
};

defn err_value(x: String) -> Result<JsonValue, String> { term Err(x); };
defn ok_value(x: JsonValue) -> Result<JsonValue, String> { term Ok(x); };
defn err_frame(x: String) -> Result<ParseFrame, String> { term Err(x); };

defn e_utoken() -> String { term "unexpected_token"; };
defn e_invnum() -> String { term "invalid_number"; };
defn e_invesc() -> String { term "invalid_escape"; };
defn e_unexpend() -> String { term "unexpected_end"; };
defn e_expcolon() -> String { term "expected_colon"; };
defn e_expcomma() -> String { term "expected_comma"; };
defn e_expkey() -> String { term "expected_object_key"; };

// ===== Top-Level API =====

defn json_parse(s: String) -> Result<JsonValue, String> {
    let r = parse_value(s, 0);
    match r {
        Ok(f) => json_complete(s,f),
        Err(e) => Err(e),
    }
};

defn json_complete(text: String, frame: ParseFrame) -> Result<JsonValue,String> {
    when skip_ws(text,frame.pos) != text .^Length { term Err("trailing_input"); };
    term Ok(frame.value);
};

defn json_is_array(v: JsonValue) -> Bool {
    match v {
        Array(_) => true,
        _ => false,
    }
};

defn json_length(v: JsonValue) -> Int {
    match v {
        Array(list) => list.Count#(),
        _ => 0,
    }
};

defn resolve_str_val(val: JsonValue) -> Result<String, String> {
    match val {
        StrVal(sv) => Ok(sv),
        _ => Err("not_a_string"),
    }
};

defn handle_object(pairs: List<(String, JsonValue)>, key: String) -> Result<String, String> {
    // find_pair's convergence loop requires a non-empty range; an empty object
    // must return Err here.
    when pairs.Count#() == 0 {
        term Err(e_utoken());
    };
    let result = find_pair(pairs, key, 0);
    match result {
        Ok(val) => resolve_str_val(val),
        Err(e) => Err(e),
    }
};

defn json_get(v: JsonValue, key: String) -> Result<String, String> {
    match v {
        Object(pairs) => handle_object(pairs, key),
        _ => Err("not_an_object"),
    }
};

txn find_pair(pairs: List<(String, JsonValue)>, key: String, i: Int)
    [i < pairs.Count#()][i >= pairs.Count#()]
    -> Result<JsonValue, String>
{
    when pairs[i].0 == key {
        let found = pairs[i].1;
        i = pairs.Count#();
        term ok_value(found);
    };
    i = i + 1;
    term err_value(e_utoken());
};

defn json_get_by_index(v: JsonValue, i: Int) -> Result<JsonValue, String> {
    match v {
        Array(list) => {
            when i >= 0 && i < list.Count#() {
                term ok_value(list[i]);
            };
            term err_value(e_utoken());
        }
        _ => err_value(e_utoken()),
    }
};

// 2026-10-21: encode the same value algebra accepted by json_parse. The depth
// bound, Unicode validation and finite-number check keep generated documents
// parseable. Preserve this contract if the builder implementation changes.
defn json_stringify(value: JsonValue) -> Result<String,String> {
    term json_encode_depth(value,0);
};

defn json_encode_depth(value: JsonValue, depth: Int) -> Result<String,String> {
    when depth > 64 { term Err("nesting_limit"); };
    match value {
        Null() => Ok("null"),
        BoolVal(flag) => {
            when flag { term Ok("true"); };
            term Ok("false");
        },
        IntVal(number) => Ok(number as String),
        FloatVal(number) => {
            when !json_finite(number) { term Err("invalid_number"); };
            term Ok(number as String);
        },
        StrVal(text) => json_encode_text(text,0,"\""),
        Array(values) => json_encode_array(values,depth+1),
        Object(pairs) => json_encode_object(pairs,depth+1),
    }
};

defn json_encode_text(text: String, pos: Int, encoded: String) -> Result<String,String> {
    when pos >= text .^Length { term Ok(encoded+"\""); };
    let byte: Int = char_at(text,pos) as Int;
    when byte == 34 || byte == 92 {
        term json_encode_text(text,pos+1,encoded+"\\"+text[pos:pos+1]);
    };
    when byte < 32 {
        let hex: String = "0123456789abcdef";
        term json_encode_text(text,pos+1,encoded+"\\u00"+hex[byte/16:byte/16+1]+hex[byte%16:byte%16+1]);
    };
    let width: Int = json_utf8_width(text,pos);
    when width < 1 { term Err("invalid_utf8"); };
    term json_encode_text(text,pos+width,encoded+text[pos:pos+width]);
};

defn json_encode_array(values: List<JsonValue>, depth: Int) -> Result<String,String> {
    let encoded: String = "[";
    foreach idx in 0..values .^Length {
        let entry: Result<String,String> = json_encode_depth(values[idx],depth);
        when is_err(entry) { term entry; };
        when idx > 0 { encoded = encoded+","; };
        encoded = encoded+unwrap(entry);
    };
    term Ok(encoded+"]");
};

defn json_encode_object(pairs: List<(String,JsonValue)>, depth: Int) -> Result<String,String> {
    let encoded: String = "{";
    foreach idx in 0..pairs .^Length {
        let key: Result<String,String> = json_encode_text(pairs[idx].0,0,"\"");
        when is_err(key) { term key; };
        let entry: Result<String,String> = json_encode_depth(pairs[idx].1,depth);
        when is_err(entry) { term entry; };
        when idx > 0 { encoded = encoded+","; };
        encoded = encoded+unwrap(key)+":"+unwrap(entry);
    };
    term Ok(encoded+"}");
};

// ===== Strict, bounded recursive descent =====
// 2026-10-21: malformed strings/objects used to leave convergence positions
// unchanged, hanging callers. Every step below either consumes input or returns
// an error. Depth is bounded at 64; integer values must fit Int. Preserve this
// progress invariant if converting helpers back to callable transactions.

defn json_space(value: Char) -> Bool {
    term value == ' ' || value == '\t' || value == '\r' || value == '\n';
};

defn skip_ws(text: String, pos: Int) [true] -> Int {
    when pos < 0 { term 0; };
    when pos >= (text .^Length) || !json_space(char_at(text,pos)) { term pos; };
    term skip_ws(text,pos+1);
};

defn json_digit_value(c: Char) [true] -> Int {
    term (c as Int) - 48;
};

defn parse_value(text: String, pos: Int) -> Result<ParseFrame,String> {
    term json_value_depth(text,pos,0);
};

defn json_value_depth(text: String, pos: Int, depth: Int) -> Result<ParseFrame,String> {
    when depth > 64 { term err_frame("nesting_limit"); };
    let cursor: Int = skip_ws(text,pos);
    when cursor >= (text .^Length) { term err_frame(e_unexpend()); };
    let token: Char = char_at(text,cursor);
    when token == '"' { term parse_string(text,cursor); };
    when token == '{' { term json_object_depth(text,cursor,depth+1); };
    when token == '[' { term json_array_depth(text,cursor,depth+1); };
    when token == '-' || is_digit(token) { term parse_number(text,cursor); };
    when token == 'n' { term parse_keyword(text,cursor,"null",Null()); };
    when token == 't' { term parse_keyword(text,cursor,"true",BoolVal(true)); };
    when token == 'f' { term parse_keyword(text,cursor,"false",BoolVal(false)); };
    term err_frame(e_utoken());
};

defn parse_keyword(text: String, pos: Int, word: String, value: JsonValue) -> Result<ParseFrame,String> {
    foreach idx in 0..CharCount#(word) {
        when pos+idx >= (text .^Length) || char_at(text,pos+idx) != char_at(word,idx) { term err_frame(e_utoken()); };
    };
    term Ok(ParseFrame { value: value, pos: pos+CharCount#(word) });
};

defn parse_string(text: String, pos: Int) -> Result<ParseFrame,String> {
    when pos >= (text .^Length) || char_at(text,pos) != '"' { term err_frame(e_utoken()); };
    term parse_str_chars(text,pos+1,new_builder());
};

defn parse_str_chars(text: String, pos: Int, builder: StringBuilder) -> Result<ParseFrame,String> {
    when pos >= (text .^Length) { term err_frame(e_unexpend()); };
    let token: Char = char_at(text,pos);
    when token == '"' { term Ok(ParseFrame { value: StrVal(json_builder_string(builder)), pos: pos+1 }); };
    when token < ' ' { term err_frame(e_invesc()); };
    when token == '\\' { term json_parse_escape(text,pos+1,builder); };
    let end: Int = json_string_run(text,pos);
    when end < 0 { term err_frame("invalid_utf8"); };
    term parse_str_chars(text,end,append_str(builder,text[pos:end]));
};

defn json_string_run(text: String, pos: Int) -> Int {
    when pos >= text .^Length { term pos; };
    let byte: Int = text[pos];
    when byte == 34 || byte == 92 || byte < 32 { term pos; };
    let width: Int = json_utf8_width(text,pos);
    when width == 0 { term -1; };
    term json_string_run(text,pos+width);
};

defn json_utf8_width(text: String, pos: Int) -> Int {
    let byte: Int = text[pos];
    when byte < 128 { term 1; };
    let width: Int = 0;
    when byte >= 194 && byte <= 223 { width = 2; };
    when byte >= 224 && byte <= 239 { width = 3; };
    when byte >= 240 && byte <= 244 { width = 4; };
    when width == 0 || pos+width > text .^Length { term 0; };
    foreach idx in (pos+1)..(pos+width) {
        let continuation: Int = text[idx];
        when continuation < 128 || continuation > 191 { term 0; };
    };
    let second: Int = text[pos+1];
    when (byte == 224 && second < 160) || (byte == 237 && second >= 160) ||
        (byte == 240 && second < 144) || (byte == 244 && second >= 144) { term 0; };
    term width;
};

defn json_parse_escape(text: String, pos: Int, builder: StringBuilder) -> Result<ParseFrame,String> {
    when pos >= (text .^Length) { term err_frame(e_unexpend()); };
    let token: Char = char_at(text,pos);
    when token == 'u' { term json_unicode(text,pos+1,builder); };
    when token == '"' || token == '\\' || token == '/' { term parse_str_chars(text,pos+1,append_char(builder,token)); };
    when token == 'n' { term parse_str_chars(text,pos+1,append_char(builder,'\n')); };
    when token == 'r' { term parse_str_chars(text,pos+1,append_char(builder,'\r')); };
    when token == 't' { term parse_str_chars(text,pos+1,append_char(builder,'\t')); };
    when token == 'b' { term parse_str_chars(text,pos+1,append_char(builder,'\b')); };
    when token == 'f' { term parse_str_chars(text,pos+1,append_char(builder,'\f')); };
    term err_frame(e_invesc());
};

defn parse_hex_escape(text: String, pos: Int) -> Result<Int,String> {
    when pos+4 > (text .^Length) { term Err(e_invesc()); };
    let code: Int = 0;
    foreach idx in pos..(pos+4) {
        let digit: Char = char_at(text,idx);
        when !is_hex_digit(digit) { term Err(e_invesc()); };
        code = code*16 + hex_digit_to_int(digit);
    };
    term Ok(code);
};

defn json_unicode(text: String, pos: Int, builder: StringBuilder) -> Result<ParseFrame,String> {
    let escaped: Result<Int,String> = parse_hex_escape(text,pos);
    when is_err(escaped) { term err_frame(e_invesc()); };
    let code: Int = unwrap(escaped);
    when code >= 56320 && code <= 57343 { term err_frame(e_invesc()); };
    when code < 55296 || code > 56319 { term parse_str_chars(text,pos+4,append_char(builder,code as Char)); };
    when pos+10 > (text .^Length) || char_at(text,pos+4) != '\\' || char_at(text,pos+5) != 'u' { term err_frame(e_invesc()); };
    let second: Result<Int,String> = parse_hex_escape(text,pos+6);
    when is_err(second) { term err_frame(e_invesc()); };
    let low: Int = unwrap(second);
    when low < 56320 || low > 57343 { term err_frame(e_invesc()); };
    let combined: Int = 65536+(code-55296)*1024+low-56320;
    term parse_str_chars(text,pos+10,append_char(builder,combined as Char));
};

defn json_digit_end(text: String, pos: Int) -> Int {
    when pos >= (text .^Length) || !is_digit(char_at(text,pos)) { term pos; };
    term json_digit_end(text,pos+1);
};

defn json_number_end(text: String, pos: Int) -> Int {
    let cursor: Int = pos;
    when cursor < (text .^Length) && char_at(text,cursor) == '-' { cursor = cursor+1; };
    when cursor >= (text .^Length) || !is_digit(char_at(text,cursor)) { term -1; };
    let begin: Int = cursor;
    cursor = json_digit_end(text,cursor);
    when cursor > begin+1 && char_at(text,begin) == '0' { term -1; };
    when cursor < (text .^Length) && char_at(text,cursor) == '.' {
        let fraction: Int = cursor+1;
        cursor = json_digit_end(text,fraction);
        when cursor == fraction { term -1; };
    };
    when cursor < (text .^Length) && (char_at(text,cursor) == 'e' || char_at(text,cursor) == 'E') {
        cursor = cursor+1;
        when cursor < (text .^Length) && (char_at(text,cursor) == '+' || char_at(text,cursor) == '-') { cursor = cursor+1; };
        let exponent: Int = cursor;
        cursor = json_digit_end(text,cursor);
        when cursor == exponent { term -1; };
    };
    term cursor;
};

defn json_signed_integer(text: String, pos: Int, end: Int, negative: Int, value: Int) -> Result<ParseFrame,String> {
    when pos >= end {
        when negative == 1 { term Ok(ParseFrame { value: IntVal(value), pos: end }); };
        term Ok(ParseFrame { value: IntVal(0-value), pos: end });
    };
    let digit: Int = json_digit_value(char_at(text,pos));
    let minimum: Int = 1 << (value .^^Bytes * 8 - 1);
    let cutoff: Int = minimum / 10;
    let last: Int = 0 - (minimum % 10);
    when negative == 0 { last = last - 1; };
    when value < cutoff || (value == cutoff && digit > last) { term err_frame(e_invnum()); };
    term json_signed_integer(text,pos+1,end,negative,value*10-digit);
};

defn parse_number(text: String, pos: Int) -> Result<ParseFrame,String> {
    let end: Int = json_number_end(text,pos);
    when end < 0 { term err_frame(e_invnum()); };
    let negative: Int = 0;
    when char_at(text,pos) == '-' { negative = 1; };
    let begin: Int = pos;
    when negative == 1 { begin = pos+1; };
    let digits: Int = json_digit_end(text,begin);
    when digits == end { term json_signed_integer(text,begin,end,negative,0); };
    let literal: String = text[pos:end];
    let value: Float = literal as Float;
    when !json_finite(value) { term err_frame(e_invnum()); };
    term Ok(ParseFrame { value: FloatVal(value), pos: end });
};

// 2026-10-21: classify IEEE encodings through the declared Data bitcast and
// physical-width reflection. Exponent-all-ones represents infinity/NaN.
// Integer classification is independent of floating reassociation/fast flags;
// remove these masks only in favor of a stdlib classification protocol.
defn json_finite(value: Float) -> Bool {
    let bits: Int = (value as Data) as Int;
    let width: Int = value .^^Bytes;
    when width == 2 { term (bits & 31744) != 31744; };
    when width == 4 { term (bits & 2139095040) != 2139095040; };
    when width == 8 { term (bits & 9218868437227405312) != 9218868437227405312; };
    term false;
};

defn parse_array(text: String, pos: Int) -> Result<ParseFrame,String> {
    term json_array_depth(text,pos,1);
};

defn json_array_depth(text: String, pos: Int, depth: Int) -> Result<ParseFrame,String> {
    let empty: List<JsonValue> = [];
    let cursor: Int = skip_ws(text,pos+1);
    when cursor < (text .^Length) && char_at(text,cursor) == ']' { term Ok(ParseFrame { value: Array(empty), pos: cursor+1 }); };
    term json_array_entries(text,cursor,empty,depth);
};

defn json_array_entries(text: String, pos: Int, entries: List<JsonValue>, depth: Int) -> Result<ParseFrame,String> {
    let parsed: Result<ParseFrame,String> = json_value_depth(text,pos,depth);
    when is_err(parsed) { term parsed; };
    let frame: ParseFrame = unwrap(parsed);
    let added: List<JsonValue> = [frame.value];
    let values: List<JsonValue> = entries + added;
    let cursor: Int = skip_ws(text,frame.pos);
    when cursor >= (text .^Length) { term err_frame(e_unexpend()); };
    when char_at(text,cursor) == ']' { term Ok(ParseFrame { value: Array(values), pos: cursor+1 }); };
    when char_at(text,cursor) != ',' { term err_frame(e_expcomma()); };
    term json_array_entries(text,skip_ws(text,cursor+1),values,depth);
};

defn parse_object(text: String, pos: Int) -> Result<ParseFrame,String> {
    term json_object_depth(text,pos,1);
};

defn json_object_depth(text: String, pos: Int, depth: Int) -> Result<ParseFrame,String> {
    let empty: List<(String,JsonValue)> = [];
    let cursor: Int = skip_ws(text,pos+1);
    when cursor < (text .^Length) && char_at(text,cursor) == '}' { term Ok(ParseFrame { value: Object(empty), pos: cursor+1 }); };
    term json_object_entries(text,cursor,empty,depth);
};

defn json_object_entries(text: String, pos: Int, pairs: List<(String,JsonValue)>, depth: Int) -> Result<ParseFrame,String> {
    let key: Result<ParseFrame,String> = parse_string(text,pos);
    when is_err(key) { term key; };
    let key_frame: ParseFrame = unwrap(key);
    let cursor: Int = skip_ws(text,key_frame.pos);
    when cursor >= (text .^Length) || char_at(text,cursor) != ':' { term err_frame(e_expcolon()); };
    let value: Result<ParseFrame,String> = json_value_depth(text,cursor+1,depth);
    when is_err(value) { term value; };
    let frame: ParseFrame = unwrap(value);
    let name: Result<String,String> = resolve_str_val(key_frame.value);
    when is_err(name) { term err_frame(e_expkey()); };
    let entry: List<(String,JsonValue)> = [(unwrap(name),frame.value)];
    let updated: List<(String,JsonValue)> = pairs + entry;
    let after: Int = skip_ws(text,frame.pos);
    when after >= (text .^Length) { term err_frame(e_unexpend()); };
    when char_at(text,after) == '}' { term Ok(ParseFrame { value: Object(updated), pos: after+1 }); };
    when char_at(text,after) != ',' { term err_frame(e_expcomma()); };
    term json_object_entries(text,skip_ws(text,after+1),updated,depth);
};
