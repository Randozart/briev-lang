// ── Briev Collections ───────────────────────────────────────────────
// 2026-07-26: Standard collection types. No compiler magic.
// Protocol bindings let the <- operator work for any collection
// via op InsertAt: fn(#Lh, #Rh) and op ExtractFrom: fn(#Rh).
// op Init: fn(#Lh, #Rh) handles let x: T = val initialization.

// ── Stack<T, N> — fixed-size stack ──────────────────────────────────

obj Stack<T, N> {
    data: T[N];
    len: Int;

    op InsertAt: push(#Lh, #Rh);
    op ExtractFrom: pop(#Rh);
    op Init: init(#Lh, #Rh);

    txn init(val: T) [true][len == 1] {
        data[0] = val;
        len = 1;
    };

    txn push(val: T) [len < N][len <= N] {
        data[len] = val;
        len = len + 1;
    };

    txn pop() -> T [len > 0][len >= 0] {
        len = len - 1;
        term data[len];
    };
};

// ── RingBuffer<T> — fixed-size circular buffer ─────────────────────

obj RingBuffer<T> {
    data: T[256];
    read: Int;
    write: Int;

    op InsertAt: push(#Lh, #Rh);
    op ExtractFrom: pop(#Rh);
    op CopyFrom: read(#Rh);
    op Init: init(#Lh, #Rh);

    txn init(val: T) [true][write == 1] {
        data[0] = val;
        write = 1;
    };

    txn push(val: T) [write - read < 256][write - read <= 256] {
        data[write % 256] = val;
        write = write + 1;
    };

    txn pop() -> T [write > read][write >= read] {
        let i = read % 256;
        read = read + 1;
        term data[i];
    };

    defn read() -> T [write > read] {
        term data[read % 256];
    };

    defn size() -> Int {
        term write - read;
    };
};

// ── List<T> — dynamic list (compiler-owned Length, heap-backed) ─────
// 2026-08-15 (coll plan §3.7): `coll obj List<T>` — the compiler scaffolds
// the op surface (`op Count`/`op At`/`op Init`/`op InitEmpty`/`op InsertAt`/
// `op ExtractFrom`/`op CopyFrom`) and appends hidden `cap`/`len` slots.
// `ListBuffer` is just the element store (`data: Ptr<T>`); capacity is
// compiler-owned. The old hand-written members (init/grow/push/pop/get/len)
// are deleted — the scaffold synthesizes equivalent ones.

struct ListBuffer<T> {
    data: Ptr<T>;
};

coll obj List<T> {
    inner: ListBuffer<T>;
};

// ── HashMap<K, V> — hash table (flat open addressing) ───────────────
// Direct hashing (no collision probing): the benchmark's keys are sequential,
// so `(key as Int) % cap` maps each to a distinct slot. The chained-bucket
// form (a Ptr array of per-bucket Lists) is a documented follow-up.

// 2026-08-17 (storage + tuple correctness, plan
// 2026-08-17-hashmap-storage-tuple-correctness.md): HashMap's element is the
// (K, V) PAIR — `m <- (k, v)`, `[(k1,v1),(k2,v2)]` literals, `m.get(k)` by
// key, `keys()`/`values()`/`entries()` scans. State fields UNPACK to SoA
// columns (the compiler's efficiency choice); locals box. The `Entry<K,V>`
// struct is RETIRED (tuple destructure + field access now work).
obj HashMap<K, V> {
    keys: Ptr<K>;
    vals: Ptr<V>;
    // 2026-08-12 (Iterable protocol, Tier 1): occupancy flags (1 = occupied)
    // — an empty slot holds garbage keys/vals, so iteration must skip
    // unoccupied slots. Int (not Bool) avoids boxed-Bool element unboxing in
    // the scan conditions.
    occupied: Ptr<Int>;
    count: Int;
    cap: Int;
    // 2026-08-18: NO `items` mirror list. A 2026-08-16 workaround kept a
    // persistent (K, V) list because `acc <- keys[i]` inside a member body
    // double-constructed the loop-carried local (scans returned 1 of N). That
    // arrow-push bug is FIXED (2026-08-18, BUGS.md), so keys()/values()/
    // entries()/foreach scan the COLUMNS directly (the compiler's efficiency
    // choice — no dead mirror writes in the hot path). Removing the mirror
    // restores the pre-workaround design; see Phase E.

    op InsertAt: insert(#Lh, #Rh);
    op ExtractFrom: remove(#Rh);
    op CopyFrom: get(#Rh);
    op Init: init(#Lh, #Rh);

    // 2026-08-16 (hashmap redesign): `op Count` = the element count — the
    // collection op surface (`Count#`/`len`/`is_empty`). This is a map's
    // OCCUPIED count, NOT the slot-array size `cap`.
    op Count() -> Int { term count; };

    // 2026-08-17: the constructor param is an honest `Int` CAPACITY — NOT a
    // `K`-typed overload (a `K` is the map's KEY type and has nothing to do
    // with table size; reinterpreting it as capacity silently truncated
    // non-Int keys). The seed (`let m: HashMap<K,V> = 2 * N`) sizes the table
    // so it never fills for a known bound. A 0 seed (the default `= 0`) falls
    // back to 256, so existing fixed-size maps keep working. The `count == 0`
    // contract runs the body only once (a map initializes from the empty state).
    // 2026-08-18: the param is `capacity`, NOT `cap` — the body writes the
    // FIELD `cap = c`, and a param named `cap` would SHADOW it. Lexical
    // scoping says a bound param wins over a same-named field on READ, so the
    // seed would read the param and the loop bounds would read the field —
    // read/write resolution must stay symmetric (see emit_stmt/emit_expr
    // shadow guards).
    txn init(capacity: Int) [true][count == 0] {
        let c: Int = match capacity {
            0 => 256,
            _ => capacity,
        };
        keys = Malloc#(c * 8) as Ptr<K>;
        vals = Malloc#(c * 8) as Ptr<V>;
        occupied = Malloc#(c * 8) as Ptr<Int>;
        cap = c;
        count = 0;
    };

    defn hash(key: K) -> Int {
        term (key as Int) % cap;
    };

    // 2026-08-17 (tuple correctness): insert takes the (K, V) PAIR as one
    // value — the `op InsertAt: insert(#Lh,#Rh)` binding passes a single RHS,
    // so `m <- (k, v)` and `[(k1,v1),(k2,v2)]` route through it. Linear
    // probing with the probe slot DERIVED from the foreach counter `q`
    // (`p = (h + q) % cap`), so the probe carries NO loop-carried position
    // register (a carried `p`/`done_slot` in an inlined member + a nested
    // foreach overflows the SSA phi bookkeeping — clang "forward referenced").
    // 2026-09-08 (rehash-on-full): precondition relaxed from [count < cap] to
    // [count <= cap][true] so insert fires even when the table is full. The
    // body checks `count >= cap` and triggers an inline rehash (allocate 2x,
    // re-insert all entries, free old arrays) before probing. The nested
    // foreach-in-if pattern was blocked by the emit_member_body state leak
    // (BUGS.md limitation #1, fixed this slice).
    txn insert(e: (K, V)) [count <= cap][true] {
        // Rehash when full: allocate new arrays at 2x, re-insert, free old.
        when count >= cap {
            let new_cap: Int = cap * 2;
            let new_keys: Ptr<K> = Malloc#(new_cap * 8) as Ptr<K>;
            let new_vals: Ptr<V> = Malloc#(new_cap * 8) as Ptr<V>;
            let new_occ: Ptr<Int> = Malloc#(new_cap * 8) as Ptr<Int>;
            foreach j in 0..new_cap {
                new_occ[j] = 0;
            };
            foreach i in 0..cap {
                when occupied[i] == 1 {
                    let rk: K = keys[i];
                    let rv: V = vals[i];
                    let rh: Int = (rk as Int) % new_cap;
                    foreach q in 0..new_cap {
                        let rp: Int = (rh + q) % new_cap;
                        when new_occ[rp] == 0 {
                            new_keys[rp] = rk;
                            new_vals[rp] = rv;
                            new_occ[rp] = 1;
                            break;
                        };
                    };
                };
            };
            Free#(keys as Ptr<Bit<8>>);
            Free#(vals as Ptr<Bit<8>>);
            Free#(occupied as Ptr<Bit<8>>);
            keys = new_keys;
            vals = new_vals;
            occupied = new_occ;
            cap = new_cap;
        };
        let (k, v) = e;
        let h: Int = (k as Int) % cap;
        let done_slot: Bool = false;
        foreach q in 0..cap {
            let p: Int = (h + q) % cap;
            when !done_slot {
                when occupied[p] == 0 || keys[p] == k {
                    keys[p] = k;
                    vals[p] = v;
                    occupied[p] = 1;
                    done_slot = true;
                    break;
                };
            };
        };
        count += 1;
    };

    defn get(key: K) -> V [count > 0][count >= 0] {
        let h: Int = (key as Int) % cap;
        let r: V = 0 as V;
        foreach q in 0..cap {
            let p: Int = (h + q) % cap;
            when occupied[p] == 1 && keys[p] == key {
                r = vals[p];
                break;
            };
        };
        term r;
    };

    defn contains(key: K) -> Bool {
        let h: Int = (key as Int) % cap;
        let found_slot: Bool = false;
        foreach q in 0..cap {
            let p: Int = (h + q) % cap;
            when occupied[p] == 1 && keys[p] == key {
                found_slot = true;
                break;
            };
        };
        term found_slot;
    };

    // 2026-08-18 (Phase E): keys()/values()/entries() column scans — unblocked
    // by the arrow-push double-construction fix (BUGS.md 2026-08-18). The
    // loop-carried local `acc` is bound to a fresh List and pushed once per
    // occupied slot; the returned list is the LIVE binding (no `[<list>]`
    // wrapper). Order is slot order, not insertion order (the C reference and
    // hash_ops_idio do not depend on it).
    defn keys() -> List<K> {
        let acc: List<K> = [];
        foreach i in 0..cap {
            when occupied[i] == 1 {
                acc <- keys[i];
            };
        };
        term acc;
    };

    defn values() -> List<V> {
        let acc: List<V> = [];
        foreach i in 0..cap {
            when occupied[i] == 1 {
                acc <- vals[i];
            };
        };
        term acc;
    };

    defn entries() -> List<(K, V)> {
        let acc: List<(K, V)> = [];
        foreach i in 0..cap {
            when occupied[i] == 1 {
                acc <- (keys[i], vals[i]);
            };
        };
        term acc;
    };

    txn remove(key: K) -> V [count > 0][count >= 0] {
        let h: Int = (key as Int) % cap;
        let r: V = 0 as V;
        let found_slot: Bool = false;
        foreach q in 0..cap {
            let p: Int = (h + q) % cap;
            when occupied[p] == 1 && keys[p] == key {
                r = vals[p];
                occupied[p] = 0;
                found_slot = true;
                break;
            };
        };
        when found_slot {
            count -= 1;
        };
        term r;
    };

    // 2026-08-18: keys()/values()/entries() are implemented as column scans
    // (above); `foreach` over the map is a normal List foreach over the
    // entries() result. The mirror list is gone — the column scan is the
    // single source of truth for iteration.
};

// 2026-08-18 (Phase D): `PiggyBank<K>` — a ONE-SHOT, OPAQUE collection.
// Money goes in (`piggy <- x`, the ONLY way in), and the ONLY way out is to
// smash it (`let all: List<K>; all ~<- piggy;` → everything at once, jar
// reset). The sealed ops (read an element, index, count, iterate) are bound
// to `Error#` members — a REACHABLE use fails at compile time with a helpful
// message (the Error# intrinsic is a compile-time failure; see SPEC §18.6).
obj PiggyBank<K> {
    items: List<K>;
    op InsertAt: put(#Lh, #Rh);
    op ExtractFrom: smash(#Lh);
    op Init: init(#Lh, #Rh);
    op CopyFrom: read_error(#Lh, #Rh);
    op At(i: Int) -> K {
        Error#("a PiggyBank is opaque — there is no indexing into a sealed jar. Smash it to extract everything at once: `let all: List<K>; all ~<- piggy;`");
    };
    op Count() -> Int {
        Error#("a PiggyBank is opaque — you cannot count what is inside without smashing it. Extract everything at once: `let all: List<K>; all ~<- piggy;`");
    };
    op Iter() -> Int {
        Error#("a PiggyBank is opaque — a sealed jar cannot be iterated. Smash it to extract everything at once: `let all: List<K>; all ~<- piggy;`");
    };

    txn init(v: K) [true][items.^Size == 0] {
        let e: List<K> = [];
        items = e;
    };
    defn put(e: K) { items <- e; };
    defn smash() -> List<K> {
        let all: List<K> = items;
        let e: List<K> = [];
        items = e;
        free items;
        term all;
    };
    defn read_error() -> K {
        Error#("a PiggyBank is opaque — individual elements cannot be read out. Smash it to extract everything at once: `let all: List<K>; all ~<- piggy;`");
    };
};
