// 2026-11-03: fixed-width histograms bound endurance-test storage. Quantiles
// return inclusive bucket upper bounds, not invented exact samples. Overflow
// samples remain counted and return the observed maximum. Replace this layout
// only with a merge-compatible representation preserving those guarantees.
obj Histogram { width: Int; bins: List<Int>; count: Int; overflow: Int; maximum: Int; };

defn histogram_new(width: Int, buckets: Int) -> Histogram {
    when width < 1 || buckets < 1 || buckets > 1000000 { trap; };
    when width > 9223372036854775807 / buckets { trap; };
    let bins: List<Int> = [];
    foreach index in 0..buckets { bins <- 0; };
    term Histogram { width: width, bins: bins, count: 0, overflow: 0, maximum: 0 };
};

defn histogram_record(histogram: Histogram, value: Int) -> Histogram {
    when value < 0 || histogram.count == 9223372036854775807 { trap; };
    let next: Histogram = histogram;
    let bucket: Int = value / next.width;
    when bucket < next.bins .^Length { next.bins[bucket] = next.bins[bucket] + 1; };
    when bucket >= next.bins .^Length { next.overflow += 1; };
    next.count += 1;
    when value > next.maximum { next.maximum = value; };
    term next;
};

defn histogram_merge(left: Histogram, right: Histogram) -> Histogram {
    when left.width != right.width || left.bins .^Length != right.bins .^Length { trap; };
    when left.count > 9223372036854775807 - right.count { trap; };
    let merged: Histogram = left;
    foreach index in 0..merged.bins .^Length {
        merged.bins[index] = merged.bins[index] + right.bins[index];
    };
    merged.count += right.count;
    merged.overflow += right.overflow;
    when right.maximum > merged.maximum { merged.maximum = right.maximum; };
    term merged;
};

// Empty distributions have no quantile and trap. permille is 1..1000.
// Decomposed multiplication keeps nearest-rank arithmetic within Int range.
defn histogram_quantile(histogram: Histogram, permille: Int) -> Int {
    when histogram.count < 1 || permille < 1 || permille > 1000 { trap; };
    let rank: Int = (histogram.count / 1000) * permille +
        ((histogram.count % 1000) * permille + 999) / 1000;
    let cumulative: Int = 0;
    foreach index in 0..histogram.bins .^Length {
        cumulative += histogram.bins[index];
        when cumulative >= rank { term (index + 1) * histogram.width - 1; };
    };
    term histogram.maximum;
};
