// numeric — declared numeric composites (Front B, plan
// 2026-09-20-metaprogrammed-composites).
//
// Algorithm shapes live HERE, in the language — never in the compiler
// (Golden Rule 24, docs/architecture/proof-vs-shape.md). The compiler's
// expansion machinery (plugin/composite.rs) substitutes parameters
// hygienically before typecheck; its general analyses prove what each
// instantiated body needs (contracts, single-reader intermediates, the
// M2 deferral); its lowerings map the proven body to hardware.

// softmax_fused! — the SHAPE-ADAPTIVE deferred softmax (plan
// 2026-09-21-comptime-fold-expansion): one declaration covers every dim
// span. The branch below is ordinary Briev — expansion comptime-folds the
// scrutinee when the caller passes a comptime span (every real program
// does) and splices only the taken structure; a runtime span keeps both
// structures as a runtime match (correct, just not specialized).
//
//   small span (dlen <= 32):  ONLINE softmax — running max + rescale in a
//     single sweep; acc stays register/smem-resident (32 floats), no
//     separate max pass, one fewer sweep over the score.
//   large span (dlen > 32):   the deferred 2-pass — running max pass,
//     unnormalized weights accumulated DIRECTLY into the consumer's slice
//     (one division at the end; algebra: a division by a loop-completed
//     scalar may move past a linear consumer), then the normalize tail.
//
// `expr` parameters (substituted at the call site):
//   score   — one score summand; may reference the binders `j` and `d`
//             (the position and dim loop variables this composite binds)
//   value   — the value operand; may reference `j` and `d`
//   jlen    — the position span (e.g. NKV)
//   dlen    — the dim span (e.g. D)
//   accbuf  — the accumulator scratch; holds `dlen` elements per head and
//             is ZERO on entry (its slice is read-modify-written)
//   outbuf  — the normalized output buffer
//   accbase — the head's slice base in accbuf
//   outbase — the head's slice base in outbuf
//
// `expr_item` parameters (exposed binders — bound by the body, never
// passed): `j` (position), `d` (dim).
//
// Across work items, slices [accbase .. accbase+dlen) must be disjoint —
// each head owns its own slice.
$defn softmax_fused(
    score: expr, value: expr,
    jlen: expr, dlen: expr,
    accbuf: expr, outbuf: expr,
    accbase: expr, outbase: expr,
    j: expr_item, d: expr_item
) {
    match dlen <= 32 {
        true => {
            // Online: at each position, rescale the running sum AND the
            // accumulator by Exp#(old_max - new_max) — the algebra that
            // lets one sweep maintain exact softmax state.
            let m_: Float = -1e30;
            let s_: Float = 0;
            foreach j in 0..jlen {
                let sc: Float = 0;
                foreach d in 0..dlen {
                    sc = sc + score;
                }
                let mn_: Float = Max#(m_, sc);
                let r_: Float = Exp#(m_ - mn_);
                let p_: Float = Exp#(sc - mn_);
                s_ = s_ * r_ + p_;
                foreach d in 0..dlen {
                    accbuf[accbase + d] = accbuf[accbase + d] * r_ + p_ * value;
                }
                m_ = mn_;
            }
            foreach d in 0..dlen {
                outbuf[outbase + d] = accbuf[accbase + d] / s_;
            }
        },
        false => {
            // Deferred: pass 1 runs the max; pass 2 accumulates
            // unnormalized weights straight into the consumer's slice;
            // the tail divides once per element.
            let m_: Float = -1e30;
            foreach j in 0..jlen {
                let sc: Float = 0;
                foreach d in 0..dlen {
                    sc = sc + score;
                }
                m_ = Max#(m_, sc);
            }
            let s_: Float = 0;
            foreach j in 0..jlen {
                let sc: Float = 0;
                foreach d in 0..dlen {
                    sc = sc + score;
                }
                let p_: Float = Exp#(sc - m_);
                s_ = s_ + p_;
                foreach d in 0..dlen {
                    accbuf[accbase + d] = accbuf[accbase + d] + p_ * value;
                }
            }
            foreach d in 0..dlen {
                outbuf[outbase + d] = accbuf[accbase + d] / s_;
            }
        },
    }
};

// softmax_fused_row! — the row-score sibling: the score arrives ALREADY
// SUMMED per position (e.g. read from a dot-producer's output buffer), so
// the composite has no score dim-loop; the value fold keeps its dim loop.
// Use this when a separate producer node computes the scores; use
// softmax_fused! when the score summand is expressible directly (then the
// score buffer and its producer vanish entirely).
//
// `expr` parameters:
//   score   — the position's score; references ONLY the binder `j`
//   value   — the value operand; references `j` and `d`
//   (jlen, dlen, accbuf, outbuf, accbase, outbase — as in softmax_fused!)
// `expr_item` binders: `j` (position), `d` (dim).
$defn softmax_fused_row(
    score: expr, value: expr,
    jlen: expr, dlen: expr,
    accbuf: expr, outbuf: expr,
    accbase: expr, outbase: expr,
    j: expr_item, d: expr_item
) {
    let m_: Float = -1e30;
    foreach j in 0..jlen {
        m_ = Max#(m_, score);
    }
    let s_: Float = 0;
    foreach j in 0..jlen {
        let p_: Float = Exp#(score - m_);
        s_ = s_ + p_;
        foreach d in 0..dlen {
            accbuf[accbase + d] = accbuf[accbase + d] + p_ * value;
        }
    }
    foreach d in 0..dlen {
        outbuf[outbase + d] = accbuf[accbase + d] / s_;
    }
};
