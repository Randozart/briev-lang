// cast_lanes.bv — the casting-graph lane defns as pure-Briev code.
//
// 2026-09-09 (Family A, briev-native runtime plan §2.2-A): the graph emits
// `call ptr @int_to_str(i64)` etc. for `x as String` casts. The C lanes came
// from briev_rt.c; these defns provide the SAME symbols so the backend's
// declare-guard (mod.rs, the `defined` set) skips the C declares and the
// lanes resolve to pure-Briev code. The prelude injects this file into every
// compilation unit.
//
// ABI contract: each defn's LLVM signature must match what the ExtCall lane
// emission produces (intrinsics.rs / emit_expr.rs ExtCall arm):
//   int_to_str/uint_to_str/bool_to_str/float_to_str/char_to_str → ptr result
//   str_to_int/str_to_uint → i64 result;  str_first_char → i64 (Char zext)
// All are `out defn` — the only caller is the backend's cast emission, never
// Briev code, so the frontend DCE must not drop them (string.ebv precedent).
//
// Deliberately lean: importing all of string.bv here would put its
// `to_string` in every unit alongside string_builder.bv's (import conflict).

import "std/float_fmt.bv";

// byte_at — the i-th BYTE of a String as an Int (0 obuf of range).
// A String IS a ptr to [len: i64][bytes]; byte i lives at addr + 8 + i.
// 2026-09-09: moved here from string.bv (was `frgn : briev_str_char_at`
// from briev_rt.c) — cast_lanes owns the raw byte accessor so string.bv and
// the lane parsers share one definition.
defn byte_at(s: String, i: Int) [s .^Length >= 0][term >= 0] -> Int {
    let addr: Int = (s as Data) as Int;
    when i < 0 || i >= s .^Length {
        term 0;
    };
    term Load#(addr + 8 + i, 1);
};

// ── value → String lanes ─────────────────────────────────────────────────

// int_to_str — decimal digits, recursion like string.ebv's proven digit loop.
// 2026-09-09: negatives accumulate DIGITS NEGATIVELY (digits_neg) — the old
// `Abs#(n)` formulation overflows on INT64_MIN (segfault in int_cases).
// 2026-09-10: digits built INTO an Alloc# buffer (two-pass: count, fill
// backwards). The earlier concat-chain formulation (`int_to_str(hi) + digit_
// char(lo)`) crashed: every `+` result is STATE-ARENA memory, but the
// concat epilogue free()s operands tagged heap — an arena pointer handed to
// libc free. The C int_to_str used malloc consistently; the buffer form is
// the equivalent Briev shape (arena memory is never freed).
out defn int_to_str(n: Int) [true][term .^Length >= 0] -> String {
    when n < 0 {
        let cnt: Int = 1 + neg_digit_count(n, 0);
        let buf: Int = Alloc#(8 + cnt + 1) as Int;
        Store#(buf, cnt, 8);
        Store#(buf + 8, 45, 1);
        term (fill_neg(n, buf, 8 + cnt, buf) as Data) as String;
    };
    let cnt: Int = pos_digit_count(n, 0);
    let buf: Int = Alloc#(8 + cnt + 1) as Int;
    Store#(buf, cnt, 8);
    term (fill_pos(n, buf, 8 + cnt, buf) as Data) as String;
};

// pos_digit_count — decimal digit count (n >= 0).
defn pos_digit_count(n: Int, acc: Int) [n >= 0 && acc >= 0][term >= 1] -> Int {
    when n < 10 { term acc + 1; };
    term pos_digit_count(n / 10, acc + 1);
};

// neg_digit_count — digit count of n <= 0's magnitude (INT64_MIN-safe).
defn neg_digit_count(n: Int, acc: Int) [n <= 0 && acc >= 0][term >= 1] -> Int {
    when n > -10 { term acc + 1; };
    term neg_digit_count(n / 10, acc + 1);
};

// fill_pos — write n's digits into buf[stop-1 ..] backwards; returns buf.
defn fill_pos(n: Int, buf: Int, stop: Int, buf_ret: Int)
    [n >= 0 && stop >= 1][term >= 0] -> Int {
    when n < 10 {
        Store#(buf + stop - 1, 48 + n, 1);
        term buf_ret;
    };
    Store#(buf + stop - 1, 48 + (n % 10), 1);
    term fill_pos(n / 10, buf, stop - 1, buf_ret);
};

// fill_neg — same for n <= 0 (srem keeps the sign; 48 - digit encodes).
defn fill_neg(n: Int, buf: Int, stop: Int, buf_ret: Int)
    [n <= 0 && stop >= 1][term >= 0] -> Int {
    when n > -10 {
        Store#(buf + stop - 1, 48 - n, 1);
        term buf_ret;
    };
    Store#(buf + stop - 1, 48 - (n % 10), 1);
    term fill_neg(n / 10, buf, stop - 1, buf_ret);
};

// uint_to_str — same representation (the C lane aliased int_to_str).
out defn uint_to_str(n: Int) [true][term .^Length >= 0] -> String {
    term int_to_str(n);
};

// bool_to_str — C: briev_cstr_to_briev(b ? "true" : "false").
out defn bool_to_str(b: Int) [true][term .^Length >= 0] -> String {
    when b != 0 {
        term "true";
    };
    term "false";
};

// float_to_str — the CAST lane uses C `%g` (6 significant digits), unlike
// the print family's `%.9g`. float_format is parametric — same engine.
out defn float_to_str(f: Float) [true][term .^Length >= 0] -> String {
    term float_format(f, 6);
};

// char_to_str — build a [len: i64][byte][NUL] buffer, then hand it through
// the Data→String encoding door (briev_bits_to_str copies it into a fresh
// heap String — the copy is replaced by pure-Briev Alloc#+Copy# in Family C;
// the UTF8 encoding here matches C char_to_str: 1-4 bytes by codepoint).
out defn char_to_str(c: Int) [c >= 0][term .^Length >= 1] -> String {
    let addr: Int = Alloc#(10) as Int;
    let n: Int = utf8_encode(addr + 8, c);
    Store#(addr, n, 8);
    term (addr as Data) as String;
};

// utf8_encode — write codepoint c's UTF8 bytes at addr, return the byte
// count (1-4). Mirror of C char_to_str's encoding table.
defn utf8_encode(addr: Int, c: Int) [addr >= 0 && c >= 0][term >= 1 && term <= 4] -> Int {
    when c < 0x80 {
        Store#(addr, c, 1);
        term 1;
    };
    when c < 0x800 {
        Store#(addr, 0xC0 | (c >> 6), 1);
        Store#(addr + 1, 0x80 | (c & 0x3F), 1);
        term 2;
    };
    when c < 0x10000 {
        Store#(addr, 0xE0 | (c >> 12), 1);
        Store#(addr + 1, 0x80 | ((c >> 6) & 0x3F), 1);
        Store#(addr + 2, 0x80 | (c & 0x3F), 1);
        term 3;
    };
    Store#(addr, 0xF0 | (c >> 18), 1);
    Store#(addr + 1, 0x80 | ((c >> 12) & 0x3F), 1);
    Store#(addr + 2, 0x80 | ((c >> 6) & 0x3F), 1);
    Store#(addr + 3, 0x80 | (c & 0x3F), 1);
    term 4;
};

// ── String → value lanes ─────────────────────────────────────────────────

// str_to_int — C strtol semantics (the parse_cases golden): skip ISSPACE,
// optional sign, digits until non-digit, 0 when no digits, clamp at the
// i64 bounds. Accumulates NEGATIVE under a minus sign so the exact INT64_MIN
// text round-trips.
out defn str_to_int(s: String) [true][term == 0 || term != 0] -> Int {
    term parse_int_ws(s, 0, 0, 1);
};

out defn str_to_uint(s: String) [true][term == 0 || term != 0] -> Int {
    term str_to_int(s);
};

// parse_int_ws — skip whitespace, then the sign.
defn parse_int_ws(s: String, i: Int, acc: Int, sign: Int)
    [i >= 0][term == 0 || term != 0]
    -> Int
{
    let b: Int = byte_at(s, i);
    when b == 32 || (b >= 9 && b <= 13) {
        term parse_int_ws(s, i + 1, acc, sign);
    };
    when b == 43 {
        term parse_int_digits(s, i + 1, acc, sign);
    };
    when b == 45 {
        term parse_int_digits(s, i + 1, acc, 0 - sign);
    };
    term parse_int_digits(s, i, acc, sign);
};

// parse_int_digits — the digit loop with strtol's clamp.
defn parse_int_digits(s: String, i: Int, acc: Int, sign: Int)
    [i >= 0][term == 0 || term != 0]
    -> Int
{
    let b: Int = byte_at(s, i);
    when b < 48 || b > 57 {
        term acc;
    };
    let d: Int = b - 48;
    when sign == 1 {
        // positive: clamp at INT64_MAX
        when acc > (9223372036854775807 - d) / 10 {
            term 9223372036854775807;
        };
        term parse_int_digits(s, i + 1, acc * 10 + d, sign);
    };
    // negative: accumulate negative, clamp at INT64_MIN
    when acc < (0 - 9223372036854775807 - 1 + d) / 10 {
        term 0 - 9223372036854775807 - 1;
    };
    term parse_int_digits(s, i + 1, acc * 10 - d, sign);
};

// str_to_bool — C: non-empty payload that is not exactly "false" → 1.
out defn str_to_bool(s: String) [true][term == true || term == false] -> Bool {
    let len: Int = s .^Length;
    when len <= 0 {
        term false;
    };
    when len == 5 {
        term !bytes_eq_at(s, 0, "false", 5);
    };
    term true;
};

// bytes_eq_at — do the `want` bytes of s at offset i equal the bytes of
// ref at offset 8 (its payload)? Byte-wise compare via byte_at.
defn bytes_eq_at(s: String, i: Int, ref: String, want: Int)
    [i >= 0 && want >= 0][term == true || term == false]
    -> Bool
{
    when want == 0 {
        term true;
    };
    when byte_at(s, i) != byte_at(ref, 0) {
        term false;
    };
    // Shift the reference window by rebuilding — recursion on want.
    term bytes_eq_shift(s, i + 1, ref, 1, want - 1);
};

// bytes_eq_shift — compare s[i] vs ref[j] for `n` bytes.
defn bytes_eq_shift(s: String, i: Int, ref: String, j: Int, n: Int)
    [i >= 0 && j >= 0 && n >= 0][term == true || term == false]
    -> Bool
{
    when n == 0 {
        term true;
    };
    when byte_at(s, i) != byte_at(ref, j) {
        term false;
    };
    term bytes_eq_shift(s, i + 1, ref, j + 1, n - 1);
};

// str_to_float — pure-Briev strtod (Family A leftover). Semantics mirror
// C str_to_float/strtod for the corpus surface: whitespace skip, optional
// sign, digits with optional dot, optional e/E exponent, no digits → 0.0,
// trailing garbage ignored. Accuracy: the mantissa accumulates in i64
// (≤ 18 digits exact), then ONE correctly-rounded scaling — divide by an
// exact power of ten (10^k is exact in f32 through 10^10) rather than
// multiplying by a reciprocal, so the common cases are strtod-exact.
// Known divergences (not corpus-gated, follow-ups): no hex floats, no
// inf/nan literals, "-0" parses to +0.0, no 128-byte input cap.
out defn str_to_float(s: String) [true][term >= 0.0 || term < 0.0] -> Float {
    let len: Int = str_len_bytes(s);
    let i0: Int = pf_ws(s, 0, len);
    let (sg, i1): (Int, Int) = pf_sign(s, i0, len);
    let (m, d0, seen, i2): (Int, Int, Int, Int) = pf_num(s, i1, len, 0, 0, 0, 0);
    when seen == 0 {
        term 0.0;
    };
    let (e, i3): (Int, Int) = pf_exp(s, i2, len, 0);
    let r: Float = pf_make(m, d0 - e);
    when sg < 0 {
        term 0.0 - r;
    };
    term r;
};

// pf_ws — skip isspace (space, \t \n \v \f \r).
defn pf_ws(s: String, i: Int, len: Int) [i >= 0 && len >= 0][term >= 0] -> Int {
    when i >= len {
        term i;
    };
    let b: Int = byte_raw(s, i);
    when b == 32 || (b >= 9 && b <= 13) {
        term pf_ws(s, i + 1, len);
    };
    term i;
};

// pf_sign — optional +/-, returns (sign, next index).
defn pf_sign(s: String, i: Int, len: Int) [i >= 0 && len >= 0][term >= -1 && term <= 1] -> (Int, Int) {
    when i < len {
        let b: Int = byte_raw(s, i);
        when b == 43 {
            term (1, i + 1);
        };
        when b == 45 {
            term (0 - 1, i + 1);
        };
    };
    term (1, i);
};

// pf_num — mantissa accumulation. Returns (M, d, seen, next index) with
// value = M x 10^-d: collected int digits grow M; frac digits grow d;
// digits past the 18-digit cap adjust d by magnitude (skipped int digit
// = value x10; skipped frac digit = value /10 — f32 keeps 9, we keep 18
// for the rounding headroom). First '.' enters frac mode; any other
// non-digit ends the number (strtod's trailing-garbage stop).
defn pf_num(s: String, i: Int, len: Int, m: Int, d: Int, frac: Int, seen: Int)
    [i >= 0 && len >= 0 && m >= 0][term >= -1100 && term <= 1100]
    -> (Int, Int, Int, Int)
{
    when i >= len {
        term (m, d, seen, i);
    };
    let b: Int = byte_raw(s, i);
    when b >= 48 && b <= 57 {
        let dg: Int = b - 48;
        when frac == 0 {
            when m < 1000000000000000000 {
                term pf_num(s, i + 1, len, m * 10 + dg, d, 0, 1);
            };
            term pf_num(s, i + 1, len, m, d - 1, 0, 1);
        };
        when m < 1000000000000000000 {
            term pf_num(s, i + 1, len, m * 10 + dg, d + 1, 1, 1);
        };
        term pf_num(s, i + 1, len, m, d + 1, 1, 1);
    };
    when b == 46 && frac == 0 {
        term pf_num(s, i + 1, len, m, d, 1, seen);
    };
    term (m, d, seen, i);
};

// pf_exp — optional e/E exponent: (exponent, next index). e is clamped at
// +/-1000 (f32 saturates near +/-45 anyway; the cap only guards i64 d).
defn pf_exp(s: String, i: Int, len: Int, acc: Int)
    [i >= 0 && len >= 0][term >= -1000 && term <= 1000]
    -> (Int, Int)
{
    when i >= len {
        term (acc, i);
    };
    let b: Int = byte_raw(s, i);
    when b == 101 || b == 69 {
        when i + 1 < len {
            let b1: Int = byte_raw(s, i + 1);
            when b1 == 43 {
                term pf_exp_digits(s, i + 2, len, 0, 1);
            };
            when b1 == 45 {
                term pf_exp_digits(s, i + 2, len, 0, 0 - 1);
            };
            term pf_exp_digits(s, i + 1, len, 0, 1);
        };
        term (acc, i);
    };
    term (acc, i);
};

// pf_exp_digits — the exponent's digit run, sign folded in.
defn pf_exp_digits(s: String, i: Int, len: Int, acc: Int, sg: Int)
    [i >= 0 && len >= 0][term >= -1000 && term <= 1000]
    -> (Int, Int)
{
    when i >= len {
        term (acc * sg, i);
    };
    let b: Int = byte_raw(s, i);
    when b >= 48 && b <= 57 {
        when acc < 1000 {
            term pf_exp_digits(s, i + 1, len, acc * 10 + (b - 48), sg);
        };
        term pf_exp_digits(s, i + 1, len, acc, sg);
    };
    term (acc * sg, i);
};

// pf_make — M x 10^-d with ONE correctly-rounded scaling: d > 0 divides by
// 10^d (exact in f32 through 10^10 — 5^10 < 2^24), d < 0 multiplies.
defn pf_make(m: Int, d: Int) [m >= 0][term >= 0.0 || term < 0.0] -> Float {
    let base: Float = m as Float;
    when d == 0 {
        term base;
    };
    when d > 0 {
        term base / pow10f(d);
    };
    term base * pow10f(0 - d);
};

// pow10f — 10^k in f32. k in [0,10] via loop multiply (exact: each 10^j is
// representable). Larger k recurses in exact 10^10 chunks — one rounding
// per chunk, well inside f32 resolution.
defn pow10f(k: Int) [k >= 0 && k <= 1100][term >= 0.0 || term < 0.0] -> Float {
    when k > 10 {
        term 10000000000.0 * pow10f(k - 10);
    };
    term pow10f_small(k, 1.0);
};

defn pow10f_small(k: Int, acc: Float) [k >= 0 && k <= 10][term >= 0.0 || term < 0.0] -> Float {
    when k == 0 {
        term acc;
    };
    term pow10f_small(k - 1, acc * 10.0);
};

// ── String ops (Family C) ────────────────────────────────────────────────
// The backend emits these for String ==, s[a:b], foreach-char, .^Length and
// the Data->String door. Byte-level primitives: the header is the BYTE
// length (Load#(addr, 8)); .^Length is the CODEPOINT count and must not
// bound byte indexing.

// str_len_bytes — the O(1) header read (Bytes prop, not CharCount#).
defn str_len_bytes(s: String) [true][term >= 0] -> Int {
    term Load#((s as Data) as Int, 8);
};

// byte_raw — the i-th payload byte, unbounded (callers clamp).
defn byte_raw(s: String, i: Int) [true][term >= 0] -> Int {
    term Load#((s as Data) as Int + 8 + i, 1);
};

// bytes_equal_at — do n payload bytes of a and b match (from offset 0)?
defn bytes_equal_at(a: String, b: String, n: Int) [n >= 0][term == true || term == false] -> Bool {
    when n == 0 {
        term true;
    };
    when byte_raw(a, n - 1) != byte_raw(b, n - 1) {
        term false;
    };
    term bytes_equal_at(a, b, n - 1);
};

// briev_str_eq — content equality: same byte length + same bytes.
out defn briev_str_eq(a: String, b: String) [true][term == 0 || term != 0] -> Int {
    let la: Int = str_len_bytes(a);
    when la != str_len_bytes(b) {
        term 0;
    };
    when bytes_equal_at(a, b, la) {
        term 1;
    };
    term 0;
};

// briev_str_substr — s[a:b] with C clamping: lo=max(a,0), hi=min(b,len),
// hi=max(hi,lo). Builds [len][bytes][NUL] via Copy# (memcpy, O(1) stack).
out defn briev_str_substr(s: String, a: Int, b: Int) [true][term .^Length >= 0] -> String {
    let addr: Int = (s as Data) as Int;
    let len: Int = Load#(addr, 8);
    let lo: Int = when_raw(a, len);
    let hi: Int = clamp_hi(b, len, lo);
    let n: Int = hi - lo;
    let buf: Int = Alloc#(n + 9) as Int;
    Store#(buf, n, 8);
    when n > 0 {
        Copy#(buf + 8, addr + 8 + lo, n);
    };
    Store#(buf + 8 + n, 0, 1);
    term (buf as Data) as String;
};

// when_raw — max(a, 0) clamped to len.
defn when_raw(a: Int, len: Int) [len >= 0][term >= 0] -> Int {
    when a < 0 {
        term 0;
    };
    when a > len {
        term len;
    };
    term a;
};

// clamp_hi — min(b, len), then max(hi, lo).
defn clamp_hi(b: Int, len: Int, lo: Int) [len >= 0 && lo >= 0][term >= 0] -> Int {
    let hi: Int = when_hi(b, len);
    when hi < lo {
        term lo;
    };
    term hi;
};

defn when_hi(b: Int, len: Int) [len >= 0][term >= 0] -> Int {
    when b > len {
        term len;
    };
    when b < 0 {
        term 0;
    };
    term b;
};

// briev_str_next_char — decode the UTF8 codepoint at byte offset *off_ptr,
// advance it. Invalid lead bytes fall back to a raw byte (C mirror).
out defn briev_str_next_char(s: String, off_ptr: Int) [true][term >= 0] -> Int {
    let addr: Int = (s as Data) as Int;
    let len: Int = Load#(addr, 8);
    let i: Int = Load#(off_ptr, 8);
    when i < 0 || i >= len {
        term 0;
    };
    let b0: Int = byte_raw(s, i);
    when b0 < 0x80 {
        Store#(off_ptr, i + 1, 8);
        term b0;
    };
    when (b0 & 0xE0) == 0xC0 {
        let cp: Int = decode_cont(s, i, len, 2, b0 & 0x1F);
        Store#(off_ptr, i + decode_width(s, i, len, 2), 8);
        term cp;
    };
    when (b0 & 0xF0) == 0xE0 {
        let cp: Int = decode_cont(s, i, len, 3, b0 & 0x0F);
        Store#(off_ptr, i + decode_width(s, i, len, 3), 8);
        term cp;
    };
    when (b0 & 0xF8) == 0xF0 {
        let cp: Int = decode_cont(s, i, len, 4, b0 & 0x07);
        Store#(off_ptr, i + decode_width(s, i, len, 4), 8);
        term cp;
    };
    Store#(off_ptr, i + 1, 8);
    term b0;
};

// decode_cont — accumulate `width-1` continuation bytes (stopping at the
// payload end or a non-continuation byte).
defn decode_cont(s: String, i: Int, len: Int, width: Int, cp: Int)
    [i >= 0 && len >= 0 && width >= 2 && width <= 4 && cp >= 0]
    [term >= 0]
    -> Int
{
    when width <= 1 {
        term cp;
    };
    when i + 1 >= len {
        term cp;
    };
    let b: Int = byte_raw(s, i + 1);
    when (b & 0xC0) != 0x80 {
        term cp;
    };
    term decode_cont(s, i + 1, len, width - 1, (cp << 6) | (b & 0x3F));
};

// decode_width — how many bytes the decoder actually consumed (mirrors the
// C loop's j: continuation bytes honored, end/invalid stops early).
defn decode_width(s: String, i: Int, len: Int, width: Int)
    [i >= 0 && len >= 0 && width >= 1 && width <= 4]
    [term >= 1 && term <= 4]
    -> Int
{
    when width <= 1 {
        term 1;
    };
    when i + 1 >= len {
        term 1;
    };
    let b: Int = byte_raw(s, i + 1);
    when (b & 0xC0) != 0x80 {
        term 1;
    };
    term 1 + decode_width(s, i + 1, len, width - 1);
};

// briev_char_len — codepoint count: bytes whose top bits are not 0b10 are
// lead bytes. Recursion is tail-shaped (LLVM -O3 converts it to a loop).
out defn briev_char_len(s: String) [true][term >= 0] -> Int {
    term count_lead(s, 0, str_len_bytes(s));
};

defn count_lead(s: String, i: Int, len: Int) [i >= 0 && len >= 0][term >= 0] -> Int {
    when i >= len {
        term 0;
    };
    let b: Int = byte_raw(s, i);
    when (b & 0xC0) == 0x80 {
        term count_lead(s, i + 1, len);
    };
    term 1 + count_lead(s, i + 1, len);
};

// briev_bits_to_str — STAYS C-BACKED (briev_rt.c). The Data->String door
// (`x as Data as String`) emits `call @briev_bits_to_str`, so a Briev defn
// would recurse into itself through its own return door. It migrates when
// the door inlines the copy (allocator step, Family E+).
//
// briev_str_to_c / briev_cstr_to_briev / briev_cstring_concat — GLUE C-ABI
// doors, pulled only by lib/glue users; follow-up increment.
// The print plugin and #StdErr lower to `call i64 @__print_*(...)`; these
// defns provide the symbols with byte-identical behavior to the C originals
// (briev_rt.c 572-640). Output goes through write(2) — SYS_write=1 on
// x86_64 Linux — and __exit through SYS_exit_group=231.
// TODO(arch): 64/94 are the aarch64 numbers; the source language has no arch
// reflection yet (`.^` targets: Length/Ptr/Size/Bytes/Alignment/Type), so
// the x86_64 numbers stand until a target-const mechanism exists.
//
// Buffering note: C stdout to a pipe is fully buffered, flushed at exit; to
// a tty, line buffered. write(2) is unbuffered. The BYTES are identical in
// both orderings — only interactive partial-line timing differs.

// write_all — write the whole payload of String s to fd.
defn write_all(fd: Int, s: String) [fd >= 0][term >= 0] -> Int {
    let addr: Int = (s as Data) as Int;
    let len: Int = Load#(addr, 8);
    when len <= 0 {
        term 0;
    };
    term SysCall#(1, fd, addr + 8, len, 0, 0, 0);
};

out defn __print_str(s: String) [true][term >= 0] -> Int {
    term write_all(1, s);
};

out defn __print(s: String) [true][term >= 0] -> Int {
    term write_all(1, s);
};

out defn __eprint_str(s: String) [true][term >= 0] -> Int {
    term write_all(2, s);
};

out defn __print_int(n: Int) [true][term >= 0] -> Int {
    term write_all(1, int_to_str(n));
};

out defn __print_bool(b: Int) [true][term >= 0] -> Int {
    term write_all(1, bool_to_str(b));
};

out defn __print_float(f: Float) [true][term >= 0] -> Int {
    // C: printf("%.9g", (double)f) — float_format(f, 9) is byte-parity
    // (the float_cases corpus pins it).
    term write_all(1, float_format(f, 9));
};

out defn __print_char(c: Int) [c >= 0][term >= 0] -> Int {
    // C: c==10 → puts("") (writes '\n'), else putchar(c) — one raw byte
    // either way. A 1-byte write covers both.
    let buf: Int = Alloc#(1) as Int;
    Store#(buf, c, 1);
    term SysCall#(1, 1, buf, 1, 0, 0, 0);
};

out defn __exit(code: Int) [true][term >= 0] -> Int {
    // SYS_exit_group = 231 (x86_64). No return — the process ends.
    term SysCall#(231, code, 0, 0, 0, 0, 0);
};

// str_first_char — the first UTF8 codepoint (0 when empty). Mirror of C
// str_first_char: 1-4 byte decode, malformed lead byte falls back to raw.
out defn str_first_char(s: String) [true][term >= 0] -> Int {
    let len: Int = s .^Length;
    when len <= 0 {
        term 0;
    };
    let p0: Int = byte_at(s, 0);
    when p0 < 0x80 {
        term p0;
    };
    when (p0 & 0xE0) == 0xC0 {
        term ((p0 & 0x1F) << 6) | (byte_at(s, 1) & 0x3F);
    };
    when (p0 & 0xF0) == 0xE0 {
        term ((p0 & 0x0F) << 12) | ((byte_at(s, 1) & 0x3F) << 6) | (byte_at(s, 2) & 0x3F);
    };
    when (p0 & 0xF8) == 0xF0 {
        term ((p0 & 0x07) << 18) | ((byte_at(s, 1) & 0x3F) << 12) | ((byte_at(s, 2) & 0x3F) << 6) | (byte_at(s, 3) & 0x3F);
    };
    term p0;
};
// ── Collection / vector ops (Family D) ──────────────────────────────────
// Dynamic-shape gathers over vector state fields and Data buffers
// (SPEC §16.5 `array[mask]`, `data[lo:hi]`), called from the backend's
// vector emission. Output length is DATA-dependent (mask popcount / clamped
// range) — these are loops over the raw byte primitives, not shufflevector
// (which needs static shapes). Alloc# supplies fresh buffers; the arena
// model means coll_resize's grow does NOT free the old buffer (retired
// until the arena resets — the C malloc/free pair has no arena equivalent).

// coll_count_true_i64 — popcount of an i64-slot mask.
defn coll_count_true_i64(mask: Int, n: Int) [mask >= 0 && n >= 0][term >= 0] -> Int {
    when n == 0 {
        term 0;
    };
    let v: Int = Load#(mask + 8 * (n - 1), 8);
    when v != 0 {
        term 1 + coll_count_true_i64(mask, n - 1);
    };
    term coll_count_true_i64(mask, n - 1);
};

// coll_min — min of two non-negative counts.
defn coll_min(a: Int, b: Int) [a >= 0 && b >= 0][term >= 0] -> Int {
    when a > b {
        term b;
    };
    term a;
};

// briev_mask_select — byte gather over a Data [len][bytes] buffer: the
// bytes at true mask positions, ascending, into a fresh [len][bytes].
out defn briev_mask_select(data: Int, mask: Int, mask_len: Int)
    [data >= 0 && mask >= 0 && mask_len >= 0][term >= 0]
    -> Int
{
    let len: Int = Load#(data, 8);
    let ml: Int = coll_min(mask_len, len);
    let cnt: Int = coll_count_true_i64(mask, ml);
    let obuf: Int = Alloc#(8 + cnt) as Int;
    Store#(obuf, cnt, 8);
    term gather_bytes(data, mask, obuf, ml, 0, 0);
};

// gather_bytes — two-index walk: i reads data/mask, w writes obuf.
defn gather_bytes(data: Int, mask: Int, obuf: Int, ml: Int, i: Int, w: Int)
    [ml >= 0 && i >= 0 && w >= 0][term >= 0]
    -> Int
{
    when i >= ml {
        term obuf;
    };
    when Load#(mask + 8 * i, 8) != 0 {
        let b: Int = Load#(data + 8 + i, 1);
        Store#(obuf + 8 + w, b, 1);
        term gather_bytes(data, mask, obuf, ml, i + 1, w + 1);
    };
    term gather_bytes(data, mask, obuf, ml, i + 1, w);
};

// briev_mask_select64 — i64-slot gather from a state column into a fresh
// LIST buffer ([len][elems]): slots 1.. hold the selected elements.
out defn briev_mask_select64(data: Int, data_len: Int, mask: Int, mask_len: Int)
    [data >= 0 && data_len >= 0 && mask >= 0 && mask_len >= 0][term >= 0]
    -> Int
{
    let ml: Int = coll_min(mask_len, data_len);
    let cnt: Int = coll_count_true_i64(mask, ml);
    let obuf: Int = Alloc#(8 * (1 + cnt)) as Int;
    Store#(obuf, cnt, 8);
    term gather_i64(data, mask, obuf, ml, 0, 1);
};

// gather_i64 — i64 walk: data slot i, obuf slot w (w starts at 1).
defn gather_i64(data: Int, mask: Int, obuf: Int, ml: Int, i: Int, w: Int)
    [ml >= 0 && i >= 0 && w >= 1][term >= 0]
    -> Int
{
    when i >= ml {
        term obuf;
    };
    when Load#(mask + 8 * i, 8) != 0 {
        let v: Int = Load#(data + 8 * i, 8);
        Store#(obuf + 8 * w, v, 8);
        term gather_i64(data, mask, obuf, ml, i + 1, w + 1);
    };
    term gather_i64(data, mask, obuf, ml, i + 1, w);
};

// gather_f32 — f32 walk: 4-byte elements widened to i64 bit-pattern slots
// (the List<Float> slot convention).
defn gather_f32(data: Int, mask: Int, obuf: Int, ml: Int, i: Int, w: Int)
    [ml >= 0 && i >= 0 && w >= 1][term >= 0]
    -> Int
{
    when i >= ml {
        term obuf;
    };
    when Load#(mask + 8 * i, 8) != 0 {
        let bits: Int = Load#(data + 4 * i, 4);
        Store#(obuf + 8 * w, bits, 8);
        term gather_f32(data, mask, obuf, ml, i + 1, w + 1);
    };
    term gather_f32(data, mask, obuf, ml, i + 1, w);
};

// gather_i64_i8 — i64 data, BYTE mask (Bool[N] state columns are [N x i8]).
defn gather_i64_i8(data: Int, mask: Int, obuf: Int, ml: Int, i: Int, w: Int)
    [ml >= 0 && i >= 0 && w >= 1][term >= 0]
    -> Int
{
    when i >= ml {
        term obuf;
    };
    when Load#(mask + i, 1) != 0 {
        let v: Int = Load#(data + 8 * i, 8);
        Store#(obuf + 8 * w, v, 8);
        term gather_i64_i8(data, mask, obuf, ml, i + 1, w + 1);
    };
    term gather_i64_i8(data, mask, obuf, ml, i + 1, w);
};

// gather_f32_i8 — f32 data, byte mask.
defn gather_f32_i8(data: Int, mask: Int, obuf: Int, ml: Int, i: Int, w: Int)
    [ml >= 0 && i >= 0 && w >= 1][term >= 0]
    -> Int
{
    when i >= ml {
        term obuf;
    };
    when Load#(mask + i, 1) != 0 {
        let bits: Int = Load#(data + 4 * i, 4);
        Store#(obuf + 8 * w, bits, 8);
        term gather_f32_i8(data, mask, obuf, ml, i + 1, w + 1);
    };
    term gather_f32_i8(data, mask, obuf, ml, i + 1, w);
};

// coll_count_true_i8 — popcount of a byte mask.
defn coll_count_true_i8(mask: Int, n: Int) [mask >= 0 && n >= 0][term >= 0] -> Int {
    when n == 0 {
        term 0;
    };
    let v: Int = Load#(mask + (n - 1), 1);
    when v != 0 {
        term 1 + coll_count_true_i8(mask, n - 1);
    };
    term coll_count_true_i8(mask, n - 1);
};

out defn briev_mask_select64_i8mask(data: Int, data_len: Int, mask: Int, mask_len: Int)
    [data >= 0 && data_len >= 0 && mask >= 0 && mask_len >= 0][term >= 0]
    -> Int
{
    let ml: Int = coll_min(mask_len, data_len);
    let cnt: Int = coll_count_true_i8(mask, ml);
    let obuf: Int = Alloc#(8 * (1 + cnt)) as Int;
    Store#(obuf, cnt, 8);
    term gather_i64_i8(data, mask, obuf, ml, 0, 1);
};

out defn briev_mask_select_f32_i8mask(data: Int, data_len: Int, mask: Int, mask_len: Int)
    [data >= 0 && data_len >= 0 && mask >= 0 && mask_len >= 0][term >= 0]
    -> Int
{
    let ml: Int = coll_min(mask_len, data_len);
    let cnt: Int = coll_count_true_i8(mask, ml);
    let obuf: Int = Alloc#(8 * (1 + cnt)) as Int;
    Store#(obuf, cnt, 8);
    term gather_f32_i8(data, mask, obuf, ml, 0, 1);
};

out defn briev_mask_select_f32(data: Int, data_len: Int, mask: Int, mask_len: Int)
    [data >= 0 && data_len >= 0 && mask >= 0 && mask_len >= 0][term >= 0]
    -> Int
{
    let ml: Int = coll_min(mask_len, data_len);
    let cnt: Int = coll_count_true_i64(mask, ml);
    let obuf: Int = Alloc#(8 * (1 + cnt)) as Int;
    Store#(obuf, cnt, 8);
    term gather_f32(data, mask, obuf, ml, 0, 1);
};

// briev_slice_range64 — contiguous range slice of an i64 state column:
// lo/hi clamped to [0,n], hi floored at lo; Copy# makes it O(1) stack.
out defn briev_slice_range64(data: Int, n: Int, lo: Int, hi: Int)
    [data >= 0 && n >= 0 && lo >= 0 && hi >= 0][term >= 0]
    -> Int
{
    let l: Int = coll_min(lo, n);
    let h0: Int = coll_min(hi, n);
    let h: Int = coll_hi_fix(h0, l);
    let len: Int = h - l;
    let obuf: Int = Alloc#(8 * (1 + len)) as Int;
    Store#(obuf, len, 8);
    when len > 0 {
        Copy#(obuf + 8, data + 8 * l, 8 * len);
    };
    term obuf;
};

// coll_hi_fix — max(h, lo) for the range clamp.
defn coll_hi_fix(h: Int, lo: Int) [h >= 0 && lo >= 0][term >= 0] -> Int {
    when h < lo {
        term lo;
    };
    term h;
};

// briev_slice_range_f32 — f32 range slice: 4-byte elements widened into
// i64 bit-pattern slots (List<Float> convention).
out defn briev_slice_range_f32(data: Int, n: Int, lo: Int, hi: Int)
    [data >= 0 && n >= 0 && lo >= 0 && hi >= 0][term >= 0]
    -> Int
{
    let l: Int = coll_min(lo, n);
    let h0: Int = coll_min(hi, n);
    let h: Int = coll_hi_fix(h0, l);
    let len: Int = h - l;
    let obuf: Int = Alloc#(8 * (1 + len)) as Int;
    Store#(obuf, len, 8);
    term slice_f32_copy(data, obuf, l, len, 0);
};

// slice_f32_copy — widen f32 elements into obuf slots 1..
defn slice_f32_copy(data: Int, obuf: Int, l: Int, len: Int, i: Int)
    [l >= 0 && len >= 0 && i >= 0][term >= 0]
    -> Int
{
    when i >= len {
        term obuf;
    };
    let bits: Int = Load#(data + 4 * (l + i), 4);
    Store#(obuf + 8 * (1 + i), bits, 8);
    term slice_f32_copy(data, obuf, l, len, i + 1);
};

// __briev_coll_resize — grow a coll handle's [data, cap, len] block to
// new_cap word-elements. Arena semantics: the old buffer is NOT freed
// (retired until arena reset); new_cap == 0 just clears the fields.
out defn __briev_coll_resize(handle: Int, new_cap: Int)
    [handle >= 0 && new_cap >= 0][term == 0 || term != 0]
    -> Int
{
    when new_cap < 0 {
        term 1;
    };
    let old_data: Int = Load#(handle, 8);
    let old_cap: Int = Load#(handle + 8, 8);
    let len: Int = Load#(handle + 16, 8);
    when new_cap == 0 {
        Store#(handle, 0, 8);
        Store#(handle + 8, 0, 8);
        term 0;
    };
    let nd: Int = Alloc#(8 * new_cap) as Int;
    let copy_n: Int = coll_min(old_cap, new_cap);
    when copy_n > 0 {
        Copy#(nd, old_data, 8 * copy_n);
    };
    Store#(handle, nd, 8);
    Store#(handle + 8, new_cap, 8);
    term 0;
};

// ── Watchdog clock + fail (Family I misc) ───────────────────────────────
// __briev_now — CLOCK_MONOTONIC ns via SYS_clock_gettime. The `within N ms`
// deadline compare calls this PER ITERATION in watchdogged loops.
// TODO(arch): 228 is the x86_64 SYS_clock_gettime (aarch64 uses 113); the
// language has no arch reflection yet — same documented gap as the print
// family's syscall numbers.
out defn __briev_now() [true][term >= 0] -> Int {
    let ts: Int = Alloc#(16) as Int;
    Store#(ts, 0, 8);
    Store#(ts + 8, 0, 8);
    SysCall#(228, 1, ts, 0, 0, 0, 0);
    let sec: Int = Load#(ts, 8);
    let ns: Int = Load#(ts + 8, 8);
    term sec * 1000000000 + ns;
};

// __watchdog_fail — a required watchdog fired: message to stderr, exit(1).
// (The C printed via fprintf + libc exit; the write+exit_group pair is the
// Briev-native equivalent.)
out defn __watchdog_fail() [true][term >= 0] -> Int {
    let _m: Int = write_all(2, "briev: required watchdog fired\n");
    SysCall#(231, 1, 0, 0, 0, 0, 0);
    term 0;
};
