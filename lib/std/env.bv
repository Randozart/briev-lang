// 2026-07-19: Environment variable access. Replaces GetEnv#/GetEnvInt# intrinsics.
// Pure-Briev wrappers over the captured-environ walkers (cast_lanes.bv).
// The !GetEnv/!GetEnvInt plugin dispatches to these based on the expected
// return type.
//
// Usage:
//   let val: Int = !GetEnvInt("BOUND");
//   let val: String = !GetEnv("PATH");
//
// 2026-09-23 (frgn-elimination round 2): the ghost frgns (frgn__getenv_* →
// deleted C __getenv_*) are gone. `Environ#()` exposes the compiler-owned
// @__briev_environ global (captured by the owned _start); the pure-Briev
// briev_getenv_{briev,int}_impl walkers (cast_lanes.bv) do the KEY=VALUE
// match + digit parse. Interpreter reference (Rule 5): std::env::var.

defn get_env(key: String) -> String {
    term briev_getenv_briev_impl((key as Data) as Int, Environ#());
};

defn get_env_int(key: String) -> Int {
    term briev_getenv_int_impl((key as Data) as Int, Environ#());
};