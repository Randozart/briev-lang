// Standard Encoding Library
//
// Functions marked with 'frgn' require foreign implementation.
// Functions with 'defn' are implemented natively in Briev.
//
// Note: Most encoding functions require bit manipulation 
// and complex algorithms, so they are mostly foreign.

// ===== PURE FOREIGN (requires bit manipulation/complex algorithms) =====

// Base64
// Hex

// URL Encoding
// HTML Encoding
// Unicode
// Hashing
// UUID
// URI Components
// ===== NATIVE DEFINITIONS =====

// Simple hex digit to int

defn hex_digit_to_int(c: String) [CharCount#(c) == 1][term >= 0 && term <= 15] -> Int {
  when c == "0" { term 0; };
  when c == "1" { term 1; };
  when c == "2" { term 2; };
  when c == "3" { term 3; };
  when c == "4" { term 4; };
  when c == "5" { term 5; };
  when c == "6" { term 6; };
  when c == "7" { term 7; };
  when c == "8" { term 8; };
  when c == "9" { term 9; };
  when c == "a" || c == "A" { term 10; };
  when c == "b" || c == "B" { term 11; };
  when c == "c" || c == "C" { term 12; };
  when c == "d" || c == "D" { term 13; };
  when c == "e" || c == "E" { term 14; };
  when c == "f" || c == "F" { term 15; };
  term 0;
};

// Int to hex digit
defn int_to_hex_digit(n: Int) [n >= 0 && n <= 15][CharCount#(term) == 1] -> String {
  when n == 0 { term "0"; };
  when n == 1 { term "1"; };
  when n == 2 { term "2"; };
  when n == 3 { term "3"; };
  when n == 4 { term "4"; };
  when n == 5 { term "5"; };
  when n == 6 { term "6"; };
  when n == 7 { term "7"; };
  when n == 8 { term "8"; };
  when n == 9 { term "9"; };
  when n == 10 { term "a"; };
  when n == 11 { term "b"; };
  when n == 12 { term "c"; };
  when n == 13 { term "d"; };
  when n == 14 { term "e"; };
  when n == 15 { term "f"; };
  term "0";
};

// Simple byte to hex (for single byte)
defn byte_to_hex(b: Int) [b >= 0 && b <= 255][CharCount#(term) == 2] -> String {
  let high: Int = b / 16;
  let low: Int = b % 16;
  term int_to_hex_digit(high) + int_to_hex_digit(low);
};

// Simple URL encode (basic version - only encodes spaces)
txn url_encode_loop(s: String, result: String, i: Int)
    [i < CharCount#(s)][i == CharCount#(s)] -> String
{
  let c: String = s[i:(i+1)];
  when c == " " {
    result = result + "%20";
  };
  when c != " " {
    result = result + c;
  };
  i = i + 1;
  term result;
};

defn url_encode_simple(s: String) [true][CharCount#(term) >= CharCount#(s)] -> String {
  term url_encode_loop(s, "", 0);
};

// Simple URL decode (basic version - only decodes %20)
txn url_decode_loop(s: String, result: String, i: Int)
    [i < CharCount#(s)][i == CharCount#(s)] -> String
{
  when i + 2 < CharCount#(s) && s[i:(i+1)] == "%" && s[(i+1):(i+3)] == "20" {
    result = result + " ";
    i = i + 3;
  };
  when !(i + 2 < CharCount#(s) && s[i:(i+1)] == "%" && s[(i+1):(i+3)] == "20") {
    result = result + s[i:(i+1)];
    i = i + 1;
  };
  term result;
};

defn url_decode_simple(s: String) [true][CharCount#(term) <= CharCount#(s)] -> String {
  term url_decode_loop(s, "", 0);
};

// Check if string is valid hex
txn is_hex_loop(s: String, i: Int)
    [i < CharCount#(s)][i == CharCount#(s)] -> Bool
{
  when !is_hex_digit(s[i:(i+1)]) {
    term false;
  };
  i = i + 1;
  term true;
};

defn is_hex_string(s: String) [true][term == true || term == false] -> Bool {
  when CharCount#(s) == 0 { term false; };
  term is_hex_loop(s, 0);
};

// Reverse string (useful for some encodings)
txn reverse_string_loop(s: String, result: String, i: Int)
    [i >= 0][i < 0] -> String
{
  result = result + s[i:(i+1)];
  i = i - 1;
  term result;
};

defn reverse_string(s: String) [true][CharCount#(term) == CharCount#(s)] -> String {
  when CharCount#(s) <= 1 { term s; };
  term reverse_string_loop(s, "", CharCount#(s) - 1);
};

// Count occurrences (useful for validation)
txn count_char_loop(s: String, c: String, count: Int, i: Int)
    [i < CharCount#(s)][i == CharCount#(s)] -> Int
{
  when s[i:(i+1)] == c {
    count = count + 1;
  };
  i = i + 1;
  term count;
};

defn count_char(s: String, c: String) [CharCount#(c) == 1][term >= 0] -> Int {
  term count_char_loop(s, c, 0, 0);
};

// Simple URL decode (basic version - only decodes %20)
defn url_decode_simple(s: String) [true][CharCount#(term) <= CharCount#(s)] -> String {
  let result: String = "";
  let i: Int = 0;
  when i < CharCount#(s) {
    when i + 2 < CharCount#(s) && s[i:(i+1)] == "%" && s[(i+1):(i+3)] == "20" {
      result = result + " ";
      i = i + 3;
    };
    when !(i + 2 < CharCount#(s) && s[i:(i+1)] == "%" && s[(i+1):(i+3)] == "20") {
      result = result + s[i:(i+1)];
      i = i + 1;
    };
  };
  term result;
};

// Check if char is hex digit
defn is_hex_digit(c: String) [CharCount#(c) == 1][term == true || term == false] -> Bool {
  when c >= "0" && c <= "9" { term true; };
  when c >= "a" && c <= "f" { term true; };
  when c >= "A" && c <= "F" { term true; };
  term false;
};

// Check if string is valid hex
defn is_hex_string(s: String) [true][term == true || term == false] -> Bool {
  when CharCount#(s) == 0 { term false; };
  let i: Int = 0;
  let valid: Bool = true;
  when i < CharCount#(s) && valid {
    when is_hex_digit(s[i:(i+1)]) {
      valid = true;
    };
    when !is_hex_digit(s[i:(i+1)]) {
      valid = false;
    };
    i = i + 1;
  };
  term valid;
};

// Reverse string (useful for some encodings)
defn reverse_string(s: String) [true][CharCount#(term) == CharCount#(s)] -> String {
  when CharCount#(s) <= 1 { term s; };
  let result: String = "";
  let i: Int = CharCount#(s) - 1;
  when i >= 0 {
    result = result + s[i:(i+1)];
    i = i - 1;
  };
  term result;
};

// Count occurrences (useful for validation)
defn count_char(s: String, c: String) [CharCount#(c) == 1][term >= 0] -> Int {
  let count: Int = 0;
  let i: Int = 0;
  when i < CharCount#(s) {
    when s[i:(i+1)] == c {
      count = count + 1;
    };
    i = i + 1;
  };
  term count;
};