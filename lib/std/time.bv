// Standard Time Library — duration helpers (pure Briev arithmetic).
//
// 2026-10-15 (core-usable purge): the old 'frgn' time surface (current
// time / component extraction / formatting / parsing) was REMOVED — those
// are no longer foreign bindings. The real monotonic clock and sleep live
// in std/os/time.bv (`now_ns`, `sleep_ms` over SYS_CLOCK_GETTIME /
// SYS_NANOSLEEP). Import that for wall/monotonic time; this module is only
// the pure duration arithmetic below.

// ===== NATIVE DEFINITIONS =====
// 2026-11-13 (stdlib constants): bodies name the units; the contracts spell
// the same numbers as literals — a grafted contract must stay literal so
// every importer can prove it without this module's import scope.
import { SEC_PER_MIN, SEC_PER_HOUR, SEC_PER_DAY } from "std/constants.bv";

// Duration helpers - native arithmetic

defn duration_seconds(secs: Int) [term == secs] -> Int {
  term secs;
};

defn duration_millis(ms: Int) [term == ms] -> Int {
  term ms;
};

defn duration_minutes(mins: Int) [term == mins * 60] -> Int {
  term mins * SEC_PER_MIN;
};

defn duration_hours(hours: Int) [term == hours * 3600] -> Int {
  term hours * SEC_PER_HOUR;
};

defn duration_days(days: Int) [term == days * 86400] -> Int {
  term days * SEC_PER_DAY;
};

// Time arithmetic - native
defn add_seconds(timestamp: Int, secs: Int) [true][term == timestamp + secs] -> Int {
  term timestamp + secs;
};

defn add_minutes(timestamp: Int, mins: Int) [true][term == timestamp + mins * 60] -> Int {
  term timestamp + mins * SEC_PER_MIN;
};

defn add_hours(timestamp: Int, hours: Int) [true][term == timestamp + hours * 3600] -> Int {
  term timestamp + hours * SEC_PER_HOUR;
};

defn add_days(timestamp: Int, days: Int) [true][term == timestamp + days * 86400] -> Int {
  term timestamp + days * SEC_PER_DAY;
};

// Time differences - native
defn diff_seconds(t1: Int, t2: Int) [true][term == t1 - t2] -> Int {
  term t1 - t2;
};

defn diff_days(t1: Int, t2: Int) [term == (t1 - t2) / 86400] -> Int {
  term (t1 - t2) / SEC_PER_DAY;
};

// Constants (durations) are plain native Ints — no frgn involvement.