// ── Electronics Briev stdlib ─────────────────────────────────────────────
// 2026-09-11 (fundamentals doctrine, Phase B): the electrical bases.
//
// These quantities are PARENTLESS declared types — under the fundamentals
// doctrine (B1 mechanism) each self-roots as its own category. No Float
// inheritance, no IEEE baggage: a Volt is a Volt. Provenance values are
// compile-time; nothing here executes (the electronics backend emits a
// schematic, contracts are proven, not run).
//
// The component CATALOG below is the extension surface — the compiler
// knows none of these names (Rule 14/15). Pins are first-class clauses;
// `reference` is parse-mandatory with pins; `tolerance` rates the pins in
// Volt (`tolerance any;` declares unrated).

type Volt { spec Bits: 32; };
type Amp { spec Bits: 32; };
type Ohm { spec Bits: 32; };
type Farad { spec Bits: 32; };
type Henry { spec Bits: 32; };
type Hertz { spec Bits: 32; };
type Watt { spec Bits: 32; };
type Kelvin { spec Bits: 32; };

// ── 2026-09-21 (E12, design record D6): pin electrical classes ──────────
// Fundamentals, not keywords: a pin clause ascribes one by type name —
// `pin vbus: Power;` — and the compiler resolves the reference and reads
// these spec properties generically. The compiler knows no class names
// (Rules 14/15): declaring a NEW class is a declaration here, not a
// compiler release.
// No `spec Bits` here: classes are valueless markers — nothing ever holds
// a `Power` or an `Nc`, so no storage width exists to declare. Bits stays
// on the value quantities above (they enter proven arithmetic).
// Rail roles (E13): the decoupling convention attaches across a supply
// pin and a return pin — property-driven, no class names in the compiler.
type Power { spec KicadType: "power_in"; spec Supply: true; };
type Ground { spec KicadType: "power_in"; spec Return: true; };
type In { spec KicadType: "input"; };
// Drive capability (E14a): which classes may hold a drive — the intent
// machinery enumerates candidates through this property.
type Out { spec KicadType: "output"; spec CanDrive: true; };
type Io { spec KicadType: "bidirectional"; spec CanDrive: true; };
type IoOd { spec KicadType: "open_collector"; spec CanDrive: true; };
type Nc { spec KicadType: "no_connect"; spec NoConnect: true; };

// A pin: two electrical quantities. Contracts reference them directly —
// `r1.a.voltage == j1.p1.voltage` — and the netlist derives from those
// obligations.
struct Pin {
    voltage: Volt;
    current: Amp;
};

type Resistor {
    pin a;
    pin b;
    reference "R";
};

type Capacitor {
    pin p;
    pin n;
    reference "C";
    spec Decoupler: true;   // E13: satisfies `spec Decouple` conventions
};

type Led {
    pin a;
    pin k;
    reference "D";
    tolerance 3.6;
};

type Connector {
    pin p1 = 1;
    pin p2 = 2;
    reference "J";
};
