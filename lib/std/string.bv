// Standard String Library
//
// Functions marked with 'frgn' require foreign implementation.
// Functions with 'defn' are implemented natively in Briev.
// Functions with name# syntax are intrinsics (compiler-known).

// ===== PURE FOREIGN (requires external implementation) =====

// Case conversion
// Whitespace checking
// Complex search (requires iteration)
// Character operations
// Escaping
// Encoding
import "std/collections.bv";
import { StringBuilder, new_builder, append_char, append_str } from "std/string_builder.bv";
import { int_to_char } from "std/char.bv";
// 2026-10-25: the target prelude supplies byte_at (cast_lanes on native,
// cast_portable on web). Importing cast_lanes here duplicates it in browser
// roots and makes resolution order-dependent.


// ===== NATIVE DEFINITIONS =====

defn bytes(s: String) [s .^Length >= 0][true] -> List<Int> {
    let result: List<Int> = [];
    term bytes_loop(s, result, 0);
};

txn bytes_loop(s: String, result: List<Int>, i: Int)
    [i < s .^Length][i == s .^Length] -> List<Int>
{
    result <- byte_at(s, i);
    i = i + 1;
    term result;
};
// Complex replacement
// Split variations
// Comparison
// Parsing
// ===== NATIVE DEFINITIONS =====

// Length
defn len(s: String) [true][term == CharCount#(s)] -> Int {
  term CharCount#(s);
};

// Basic concatenation
defn concat(a: String, b: String) [true][CharCount#(term) == CharCount#(a) + CharCount#(b)] -> String {
  let result: String = a + b;
  term result;
};

defn append(s: String, c: String) [true][CharCount#(term) == CharCount#(s) + CharCount#(c)] -> String {
  let result: String = s + c;
  term result;
};

defn prepend(c: String, s: String) [true][CharCount#(term) == CharCount#(c) + CharCount#(s)] -> String {
  let result: String = c + s;
  term result;
};

// Trim operations
defn trim(s: String) [true][CharCount#(term) <= CharCount#(s)] -> String {
  term s;
};

defn trim_left(s: String) [true][CharCount#(term) <= CharCount#(s)] -> String {
  term s;
};

defn trim_right(s: String) [true][CharCount#(term) <= CharCount#(s)] -> String {
  term s;
};

defn trim_start(s: String) [true][CharCount#(term) <= CharCount#(s)] -> String {
  term s;
};

defn trim_end(s: String) [true][CharCount#(term) <= CharCount#(s)] -> String {
  term s;
};

// Basic search. 2026-11-10 (kiosk W1): the POST must NOT re-evaluate the
// match at the incremented index — that committed the txn at a matching i
// with the PREVIOUS iteration's result (find("abc","b") returned -1). Search
// loops commit on `i == lim` only; a match fast-forwards i to lim.
txn contains_loop(haystack: String, needle: String, i: Int, lim: Int)
    [i < lim][i == lim] -> Bool
{
  when i + needle .^Length <= haystack .^Length && haystack[i:i+needle .^Length] == needle {
    i = lim;
    term true;
  };
  i = i + 1;
  term false;
};

defn contains(haystack: String, needle: String) [true][term == true || term == false] -> Bool {
  let lim: Int = haystack .^Length;
  when lim == 0 { term false; };
  term contains_loop(haystack, needle, 0, lim);
};

defn starts_with(s: String, prefix: String) [true][term == true || term == false] -> Bool {
  when prefix .^Length > s .^Length {
    term false;
  };
  term s[0:prefix .^Length] == prefix;
};

defn ends_with(s: String, suffix: String) [true][term == true || term == false] -> Bool {
  when suffix .^Length > s .^Length {
    term false;
  };
  let slen = s .^Length;
  let suflen = suffix .^Length;
  term s[slen - suflen:slen] == suffix;
};

// 2026-11-10 (kiosk W1): commit ONLY on `i == lim`; the found arm sets
// lim = i. Including the match in the post exited at a matching i with the
// stale -1 result from the previous iteration.
txn find_loop(s: String, needle: String, i: Int, lim: Int)
    [i < lim][i == lim] -> Int
{
  when i + needle .^Length <= s .^Length && s[i:i+needle .^Length] == needle {
    lim = i;
    term i;
  };
  i = i + 1;
  term -1;
};

defn find(s: String, needle: String) [true][term >= -1] -> Int {
  term find_loop(s, needle, 0, s .^Length);
};

// Substring operations
defn substr(s: String, start: Int) [start >= 0 && start <= CharCount#(s)][CharCount#(term) == CharCount#(s) - start] -> String {
  term s[start:CharCount#(s)];
};

defn substr_range(s: String, start: Int, end: Int) [start >= 0 && end >= start && end <= CharCount#(s)][CharCount#(term) == end - start] -> String {
  term s[start:end];
};

// Single replace (native)
defn replace(s: String, old: String, new: String) [true][CharCount#(term) >= 0] -> String {
  let idx: Int = find(s, old);
  when idx >= 0 {
    let before: String = s[0:idx];
    let after: String = s[idx+CharCount#(old):CharCount#(s)];
    term before + new + after;
  };
  term s;
};

// Split
txn split_loop(s: String, delim: String, result: List<String>, last: Int, i: Int)
    [i < CharCount#(s)][i == CharCount#(s)] -> List<String>
{
    when i + CharCount#(delim) <= CharCount#(s) && s[i:i+CharCount#(delim)] == delim {
        result <- s[last:i];
        i = i + CharCount#(delim);
        last = i;
    };
    when i + CharCount#(delim) > CharCount#(s) || s[i:i+CharCount#(delim)] != delim {
        when i == CharCount#(s) - 1 {
            result <- s[last:CharCount#(s)];
        };
        i = i + 1;
    };
    term result;
};

defn split(s: String, delim: String) -> List<String> {
    when CharCount#(delim) == 0 {
        term [s];
    };
    let result: List<String> = [];
    term split_loop(s, delim, result, 0, 0);
};

// Lines
defn lines(s: String) [true][CharCount#(term) >= 0] -> List<String> {
  let result: List<String> = split(s, "\n");
  term result;
};

// Join
// 2026-08-13: the count is hoisted out of the loop guard (`n`) — an
// op-as-member call (`list.Count#()`) inside a txn contract guard mis-emits
// (the member result collides with the function result slot; see BUGS.md).
txn join_loop(list: List<String>, n: Int, delim: String, result: String, i: Int)
    [i < n][i == n] -> String
{
  result = result + delim + list[i];
  i = i + 1;
  term result;
};

defn join(list: List<String>, delim: String) [true][CharCount#(term) >= 0] -> String {
  when list.Count#() == 0 {
    term "";
  };
  term join_loop(list, list.Count#(), delim, list[0], 1);
};

// Padding (basic)
defn pad_left(s: String, width: Int) [width >= CharCount#(s)][CharCount#(term) == width.max(CharCount#(s))] -> String {
  let spaces: Int = width - CharCount#(s);
  when spaces > 0 {
    let pad: String = "";
    let i: Int = 0;
    when i < spaces {
      pad = pad + " ";
      i = i + 1;
    };
    term pad + s;
  };
  term s;
};

defn pad_right(s: String, width: Int) [width >= CharCount#(s)][CharCount#(term) == width.max(CharCount#(s))] -> String {
  let spaces: Int = width - CharCount#(s);
  when spaces > 0 {
    let pad: String = "";
    let i: Int = 0;
    when i < spaces {
      pad = pad + " ";
      i = i + 1;
    };
    term s + pad;
  };
  term s;
};

defn pad_both(s: String, width: Int) [width >= CharCount#(s)][CharCount#(term) == width.max(CharCount#(s))] -> String {
  let spaces: Int = width - CharCount#(s);
  when spaces > 0 {
    let left: Int = spaces / 2;
    let right: Int = spaces - left;
    let pad_left: String = "";
    let pad_right: String = "";
    let i: Int = 0;
    when i < left {
      pad_left = pad_left + " ";
      i = i + 1;
    };
    i = 0;
    when i < right {
      pad_right = pad_right + " ";
      i = i + 1;
    };
    term pad_left + s + pad_right;
  };
  term s;
};

// Repeat
txn repeat_loop(s: String, count: Int, result: String, i: Int)
    [i < count][i == count] -> String
{
  result = result + s;
  i = i + 1;
  term result;
};

defn repeat(s: String, count: Int) [count >= 0][CharCount#(term) == CharCount#(s) * count] -> String {
  when count == 0 {
    term "";
  };
  term repeat_loop(s, count, s, 1);
};

// Type conversions
// 2026-08-04 (out-observability plan, Phase 3): `IntToStr#` was removed from
// the intrinsic table in ffd55677 (the casting graph's `Int → String`
// ExtCall lane owns this conversion). Use the cast, which resolves through the
// graph — `.bv` emits `call ptr @int_to_str`, `.ebv` will emit a Briev digit
// loop. Undo: restore `term IntToStr#(n);` only if the intrinsic is ever
// re-registered.
defn to_string(n: Int) [true][CharCount#(term) >= 0] -> String {
  term n as String;
};

defn to_float(s: String) [true][term >= 0.0 || term < 0.0] -> Float {
  // 2026-08-04 (Phase 3): was `term 0.0` — a stub. The casting graph owns
  // `String → Float` (ExtCall("str_to_float")); use the cast form.
  term s as Float;
};

defn to_int(s: String) [true][term == 0 || term != 0] -> Int {
  // 2026-08-04 (Phase 3): was `term 0` — a stub. The casting graph owns
  // `String → Int` (ExtCall("str_to_int")); use the cast form.
  term s as Int;
};
// ===== TIER 2: NATIVE CHARACTER CLASSIFICATION =====
// NOTE: All iterative functions use `txn` with `[pre][post]` convergence contracts.
// The `_loop` suffix marks the internal txn; the `defn` provides the public API.
// 2026-08-13 (string.bv unblocked): classification is BYTE-based
// (byte_at → briev_str_char_at, ASCII-correct — the same pattern the compiler
// passes use). The UTF8 multi-byte char view is the iterable-protocol Tier-1
// cursor slice, not this file's concern.
//
// LOOP SEMANTICS (the txn-loop emission): a `term X` STORES X into the result
// slot and branches back to the convergence header — it does NOT exit the
// loop. The loop exits only when the PRE-condition fails, and the result is
// the LAST store. So every exit path must (a) store the answer via `term` and
// (b) make the pre fail on the next iteration. The boolean classifiers do
// this by advancing the index to the bound before `term false`; the index
// finders (trim) carry a separate bound that the found-case clamps to the
// answer so the pre `start < lim` fails while `term start` stores the answer.

// Is an ASCII byte whitespace? (space, tab, LF, CR, FF, VT)
defn is_ws_byte(b: Int) [true][term == true || term == false] -> Bool {
    term b == 32 || b == 9 || b == 10 || b == 13 || b == 12 || b == 11;
};

txn is_whitespace_loop(s: String, i: Int)
    [i < s .^Length][i == s .^Length] -> Bool
{
    when !is_ws_byte(byte_at(s, i)) {
        i = s .^Length;
        term false;
    };
    i = i + 1;
    term true;
};

defn is_whitespace_str(s: String) [true][term == true || term == false] -> Bool {
    term is_whitespace_loop(s, 0);
};

txn is_alpha_loop(s: String, i: Int)
    [i < s .^Length][i == s .^Length] -> Bool
{
    let b: Int = byte_at(s, i);
    when !((b >= 65 && b <= 90) || (b >= 97 && b <= 122)) {
        i = s .^Length;
        term false;
    };
    i = i + 1;
    term true;
};

defn is_alpha_str(s: String) [true][term == true || term == false] -> Bool {
    when s .^Length == 0 {
        term false;
    };
    term is_alpha_loop(s, 0);
};

txn is_numeric_loop(s: String, i: Int)
    [i < s .^Length][i == s .^Length] -> Bool
{
    let b: Int = byte_at(s, i);
    when !(b >= 48 && b <= 57) {
        i = s .^Length;
        term false;
    };
    i = i + 1;
    term true;
};

defn is_numeric_str(s: String) [true][term == true || term == false] -> Bool {
    when s .^Length == 0 {
        term false;
    };
    term is_numeric_loop(s, 0);
};

// 2026-11-10 (kiosk W1): BYTE-PRESERVING ASCII fold. Char-wise folding via
// `s[i] as Char` re-encodes UTF-8 continuation bytes (an em dash became
// mojibake and changed length). Strings are byte buffers: copy bytes, fold
// only A-Z, leave every other byte (including multi-byte UTF-8) untouched.
defn fold_lower_byte(b: Int) [true][term >= 0] -> Int {
    when b >= 65 && b <= 90 { term b + 32; };
    term b;
};

defn fold_upper_byte(b: Int) [true][term >= 0] -> Int {
    when b >= 97 && b <= 122 { term b - 32; };
    term b;
};

txn fold_lower_copy(src: Int, dst: Int, j: Int, n: Int) [j < n][j == n] -> Void {
    Store#(dst + j, fold_lower_byte(Load#(src + j, 1)), 1);
    j = j + 1;
    term;
};

txn fold_upper_copy(src: Int, dst: Int, j: Int, n: Int) [j < n][j == n] -> Void {
    Store#(dst + j, fold_upper_byte(Load#(src + j, 1)), 1);
    j = j + 1;
    term;
};

defn to_lower_str(s: String) [true][term .^Length == s .^Length] -> String {
    let n: Int = s .^Length;
    when n == 0 { term ""; };
    let dstp: Int = Malloc#(n + 9) as Int;
    Store#(dstp, n, 8);
    fold_lower_copy((s as Data) as Int + 8, dstp + 8, 0, n);
    Store#(dstp + 8 + n, 0, 1);
    let owned: String = (dstp as Data) as String;
    Free#(dstp as Ptr<Bit<8>>);
    term owned;
};

defn to_upper_str(s: String) [true][term .^Length == s .^Length] -> String {
    let n: Int = s .^Length;
    when n == 0 { term ""; };
    let dstp: Int = Malloc#(n + 9) as Int;
    Store#(dstp, n, 8);
    fold_upper_copy((s as Data) as Int + 8, dstp + 8, 0, n);
    Store#(dstp + 8 + n, 0, 1);
    let owned: String = (dstp as Data) as String;
    Free#(dstp as Ptr<Bit<8>>);
    term owned;
};

// 2026-08-13: the found-index case clamps the loop bound (`lim`/`lo`) to the
// answer so the pre-condition fails on the next iteration (a `term` stores the
// result but does NOT exit the loop — only the pre failing does). `term start`
// stores the correct index; `lim = start` then makes `start < lim` false.
txn trim_start_loop(s: String, start: Int, lim: Int)
    [start < lim][start == lim || !is_ws_byte(byte_at(s, start))] -> Int
{
    when !is_ws_byte(byte_at(s, start)) {
        lim = start;
        term start;
    };
    start = start + 1;
    term start;
};

txn trim_end_loop(s: String, end: Int, lo: Int)
    [end > lo][end == lo || !is_ws_byte(byte_at(s, end - 1))] -> Int
{
    when !is_ws_byte(byte_at(s, end - 1)) {
        lo = end;
        term end;
    };
    end = end - 1;
    term end;
};

defn trim_str(s: String) [true][s .^Length >= 0] -> String {
    let start: Int = trim_start_loop(s, 0, s .^Length);
    let end: Int = trim_end_loop(s, s .^Length, start);
    term s[start:end];
};

defn trim_left_str(s: String) [true][s .^Length >= 0] -> String {
    let start: Int = trim_start_loop(s, 0, s .^Length);
    term s[start:s .^Length];
};

defn trim_right_str(s: String) [true][s .^Length >= 0] -> String {
    let end: Int = trim_end_loop(s, s .^Length, 0);
    term s[0:end];
};

txn capitalize_loop(s: String, sb: StringBuilder, i: Int)
    [i < s .^Length][i == s .^Length] -> String
{
    let b: Int = byte_at(s, i);
    when b >= 65 && b <= 90 {
        sb = append_char(sb, int_to_char(b + 32));
    };
    when b < 65 || b > 90 {
        sb = append_char(sb, int_to_char(b));
    };
    i = i + 1;
    term sb.buffer;
};

defn capitalize(s: String) [true][s .^Length >= 0] -> String {
    when s .^Length == 0 {
        term s;
    };
    let sb = new_builder();
    let b0: Int = byte_at(s, 0);
    when b0 >= 97 && b0 <= 122 {
        sb = append_char(sb, int_to_char(b0 - 32));
    };
    when b0 < 97 || b0 > 122 {
        sb = append_char(sb, int_to_char(b0));
    };
    term capitalize_loop(s, sb, 1);
};

txn reverse_loop(s: String, sb: StringBuilder, i: Int)
    [i < s .^Length][i == s .^Length] -> String
{
    let b: Int = byte_at(s, s .^Length - 1 - i);
    sb = append_char(sb, int_to_char(b));
    i = i + 1;
    term sb.buffer;
};

defn reverse_str(s: String) [true][s .^Length >= 0] -> String {
    term reverse_loop(s, new_builder(), 0);
};

txn count_char_loop(s: String, c: String, count: Int, i: Int)
    [i < s .^Length][i == s .^Length] -> Int
{
    when s[i:i+1] == c {
        count = count + 1;
    };
    i = i + 1;
    term count;
};

defn count_char(s: String, c: String) [CharCount#(c) == 1][term >= 0] -> Int {
    term count_char_loop(s, c, 0, 0);
};

defn is_blank(s: String) [true][term == true || term == false] -> Bool {
    term is_whitespace_loop(s, 0);
};

defn truncate(s: String, max_len: Int) [max_len >= 0][CharCount#(term) <= max_len] -> String {
    when CharCount#(s) <= max_len {
        term s;
    };
    term s[0:max_len];
};

defn truncate_with_ellipsis(s: String, max_len: Int) [max_len >= 3][s .^Length >= 0] -> String {
    when CharCount#(s) <= max_len {
        term s;
    };
    let sb = new_builder();
    sb = append_str(sb, s[0:max_len-3]);
    sb = append_str(sb, "...");
    term sb.buffer;
};

defn ensure_prefix(s: String, prefix: String) [true][s .^Length >= 0] -> String {
    when starts_with(s, prefix) {
        term s;
    };
    let sb = new_builder();
    sb = append_str(sb, prefix);
    sb = append_str(sb, s);
    term sb.buffer;
};

defn ensure_suffix(s: String, suffix: String) [true][s .^Length >= 0] -> String {
    when ends_with(s, suffix) {
        term s;
    };
    let sb = new_builder();
    sb = append_str(sb, s);
    sb = append_str(sb, suffix);
    term sb.buffer;
};

defn remove_prefix(s: String, prefix: String) [true][CharCount#(term) <= CharCount#(s)] -> String {
    when starts_with(s, prefix) {
        term s[CharCount#(prefix):CharCount#(s)];
    };
    term s;
};

defn remove_suffix(s: String, suffix: String) [true][CharCount#(term) <= CharCount#(s)] -> String {
    when ends_with(s, suffix) {
        term s[0:CharCount#(s)-CharCount#(suffix)];
    };
    term s;
};

defn is_empty_str(s: String) [true][term == (CharCount#(s) == 0)] -> Bool {
    term CharCount#(s) == 0;
};

// 2026-07-30: CastTo/CastFrom on String is handled by the casting graph's
// hardcoded protocol lanes (String→Bit = extractvalue, String→Int =
// ExtCall("str_to_int"), etc.). The stub functions below are removed.
