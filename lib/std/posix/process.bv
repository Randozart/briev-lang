// 2026-07-26: Process spawning — clone + execve.
// Replaces ShellCmd from briev_rt.c (which used popen).

import "syscall.bv";

export let CLONE_VM:      Int = 0x100;
export let SIGCHLD:       Int = 17;

export defn clone(flags: Int, stack: Int) -> Int {
    term syscall(SYS_CLONE, flags, stack);
};

export defn execve(path: Int, argv: Int, envp: Int) -> Int {
    term syscall(SYS_EXECVE, path, argv, envp);
};

export defn wait4(pid: Int, wstatus: Int, options: Int) -> Int {
    term syscall(SYS_WAIT4, pid, wstatus, options);
};

// Linux x86_64 syscall numbers (asm/unistd.h)
let SYS_CLONE:   Int = 56;
let SYS_EXECVE:  Int = 59;
let SYS_WAIT4:   Int = 61;
