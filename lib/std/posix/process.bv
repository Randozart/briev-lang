// 2026-07-26: Process spawning — clone + execve.
// Replaces ShellCmd from briev_rt.c (which used popen).

import "syscall.bv";

export let CLONE_VM:      Int = 0x100;
export let SIGCHLD:       Int = 17;

export defn clone(flags: Int, stack: Int) -> Int {
    term syscall(56, flags, stack);
};

export defn execve(path: Int, argv: Int, envp: Int) -> Int {
    term syscall(59, path, argv, envp);
};

export defn wait4(pid: Int, wstatus: Int, options: Int) -> Int {
    term syscall(61, pid, wstatus, options);
};

// Linux x86_64 syscall numbers (asm/unistd.h)
//
// 2026-11-17 (class D): `syscall.bv` (imported above) already exports
// SYS_CLONE, SYS_EXECVE and SYS_WAIT4. Re-declaring the first two here emitted a
// second definition of the same symbol (`redefinition of global '@SYS_CLONE'`).
// The import makes them visible; syscall.bv remains the one home for syscall
// numbers.
