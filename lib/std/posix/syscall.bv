// ── Syscall helpers ───────────────────────────────────────────────────────

// 2026-10-14 (typed-variadic retirement, plan
// 2026-10-14-increment3-closeout-and-syscall-retirement.md): ONE variadic
// `syscall` replaces the syscall0..6 wrapper families. Each call-site arity
// instantiates one monomorphized copy (SPEC §9.1); the body dispatches on
// args.Count#(), which the specialization pass folds to a literal — the
// optimizer kills the six dead arms, so the emitted body is the direct
// SysCall# call the old wrappers were. NO splice-apply (that stays a v1.1
// exclusion). To undo: restore the syscall0..6 export blocks from history
// and retarget the callers.
//
// Contract: [nr >= 0 && nr < 512][true]. The old lib/std/syscall.bv family
// carried [nr > 0][nr < 512] — nr > 0 was a latent bug: SYS_READ = 0 is a
// valid call. The upper bound is real (x86_64 max ~447). The postcondition
// stays unconstrained: syscalls return -errno on failure — that IS the API.
export defn syscall(nr: Int, ...args: Int[<=6]) -> Int
    [nr >= 0 && nr < 512][true] {
    term match args.Count#() {
        0 => SysCall#(nr),
        1 => SysCall#(nr, args[0]),
        2 => SysCall#(nr, args[0], args[1]),
        3 => SysCall#(nr, args[0], args[1], args[2]),
        4 => SysCall#(nr, args[0], args[1], args[2], args[3]),
        5 => SysCall#(nr, args[0], args[1], args[2], args[3], args[4]),
        6 => SysCall#(nr, args[0], args[1], args[2], args[3], args[4], args[5]),
        // 2026-10-15: the match must be TOTAL — `args.Count#()` folds to a
        // literal per instantiation (dead arms killed) only on the paths that
        // specialize; the named-import splice typechecks the raw body, where
        // the count is an open Int and the exhaustiveness rule demands a
        // trailing fallback. Unreachable for `Int[<=6]`; -1 follows the
        // syscall -errno convention rather than guessing a call shape.
        _ => 0 - 1,
    };
};
