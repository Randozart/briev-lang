// bits — Advanced Bit Manipulation Operations
// Tier 1: Core Math & Logic
//
// All operations are pure `defn` wrappers over `:>` LLVM intrinsic projections.
// Postconditions document the result range; proof engine verifies the body
// satisfies them. No FFI, no TOML, no DBriev.

// ===== COUNTING =====

defn popcount(x: Int) [true][term >= 0 && term <= 64] -> Int {
    term Popcount#(x);
};

defn leading_zeros(x: Int) [true][term >= 0 && term <= 64] -> Int {
    term LeadingZeros#(x);
};

defn trailing_zeros(x: Int) [true][term >= 0 && term <= 64] -> Int {
    term TrailingZeros#(x);
};

// ===== ABSOLUTE VALUE =====

defn abs(x: Int) [true][term >= 0] -> Int {
    term Abs#(x);
};

defn abs_float(x: Float) [true][term >= 0.0] -> Float {
    term Abs#(x);
};

// ===== BIT REVERSAL =====

defn bit_reverse(x: Int) -> Int {
    term BitReverse#(x);
};

// ===== COMPOSITE BIT OPS =====

defn ffs(x: Int) [true][term >= 0 && term <= 64] -> Int {
    when x == 0 {
        term 0;
    };
    term TrailingZeros#(x) + 1;
};

defn is_power_of_two(x: Int) [true][term == true || term == false] -> Bool {
    term x != 0 && x & (x - 1) == 0;
};

defn rotate_left(x: Int, n: Int) -> Int {
    term (x << n) | (x >> (64 - n));
};

defn rotate_right(x: Int, n: Int) -> Int {
    term (x >> n) | (x << (64 - n));
};
// ===== SINGLE-BIT ACCESS =====

defn set_bit(x: Int, i: Int) -> Int {
    term x | (1 << i);
};

defn clear_bit(x: Int, i: Int) -> Int {
    term x & ~(1 << i);
};

defn toggle_bit(x: Int, i: Int) -> Int {
    term x ^ (1 << i);
};

defn test_bit(x: Int, i: Int) -> Bool {
    term (x >> i) & 1 == 1;
};
