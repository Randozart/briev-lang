// lib/std/web/router.bv
// 2026-10-06 (web plan, Part 4): routing as a STDLIB FRAMEWORK — standard
// Briev only. No compiler keyword, no intrinsic, no new hashword: the URL is
// reached through the web runtime's `#Web` host functions (`location` /
// `navigate`, shipped in lib/glue/web/glue.dbv), and the view is driven by
// `b-when` / `b-trigger`. This mirrors how the web language itself routes — a
// library over the browser's location/history primitives, never the language.
//
// The app owns the reactive state (a top-level `path`) and the navigation txn;
// this module supplies the URL access and the route naming.
//
// Usage (an app):
//
//   import "std/web/router.bv";
//
//   let path: String = current_path();
//
//   txn go(url: String) [path != url][path == url] {
//       path = url;
//       navigate(url);
//       term;
//   };
//
//   <view>
//     <button b-trigger:click="go">Home</button>
//     <section b-when="route_name(path) == 'home'">...home...</section>
//     <section b-when="route_name(path) != 'home'">...other...</section>
//   </view>
//
// NOTE: a `Router` *obj* (state + `go` txn in one type) is the nicer shape but
// is blocked by a codegen bug — an obj with a txn and a String field, held as a
// top-level state var, is unpacked to `[1 x ptr]` and its literal initializer
// emits invalid wasm IR (`store [1 x ptr] %ptr`). See BUGS.md 2026-10-06.
// Until that lands, the framework is the free-function form above.

import "std/types/bootstrap.bv";

frgn location() -> String from "glue/web/web.js";
frgn navigate(url: String) from "glue/web/web.js";

// The current URL path, read from the host.
defn current_path() -> String {
    term location();
};

// The route NAME for a path — the app's mapping. Default: the root maps to
// "home", every other path is returned verbatim (the app matches on it).
defn route_name(path: String) -> String {
    when path == "/" || path == "" {
        term "home";
    };
    term path;
};
