// Browser HTTP boundary for the webstack host module.
//
// `fetch` remains the original read-only GET surface. `http_fetch` is the
// method-aware boundary; the synchronous host records the response status for
// the immediately following `last_http_status` call. There is no async race:
// both calls execute in the same Briev expression sequence.
frgn fetch(url: String) -> String : fetch_url from "glue/web/web.js";

frgn http_fetch(url: String, method: String, body: String) -> String : fetch_url_method from "glue/web/web.js";
frgn last_http_status() -> Int : last_fetch_status from "glue/web/web.js";


defn http_get(url: String) -> String {
    term http_fetch(url, "GET", "");
};

defn http_post(url: String, body: String) -> String {
    term http_fetch(url, "POST", body);
};

defn http_put(url: String, body: String) -> String {
    term http_fetch(url, "PUT", body);
};

defn http_delete(url: String) -> String {
    term http_fetch(url, "DELETE", "");
};
