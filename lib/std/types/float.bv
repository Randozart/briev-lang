// ── Floating Point Type Definitions ──────────────────────────
//
// Extended floating point types built on the Primitive type system.
// These types use operator→intrinsic declarations to define their
// behavior.
//
// 2026-07-26: Updated to new op syntax — no more -> or =.

// 16-bit half-precision float — `Half` is the canonical format name
// (LLVM-matching) and `Float16` is its alias, both registered as compiler
// format FACTS (type_universe PRIMORDIALS): bits=16, Cast.Float,
// Float16 -> parent Half. No stdlib declaration is needed (an import must not
// gate a hardware format), and arithmetic happens at the type's width; f32
// accumulation is a separate TYPE (`Float`) chosen by the composite's
// accumulator parameter, never a hidden mode.

// 4-lane SIMD float vector
type Float4 : Bits {
    spec MaxBits: 128;
    spec Alignment: 16;
    attr<llvm> tbaa: "FloatNode";

    op Add: FAddV4F32(#Lh, #Rh);
    op Sub: FSubV4F32(#Lh, #Rh);
    op Mul: FMulV4F32(#Lh, #Rh);
};
