// ── Floating Point Type Definitions ──────────────────────────
//
// Extended floating point types built on the Primitive type system.
// These types use operator→intrinsic declarations to define their
// behavior.
//
// 2026-07-26: Updated to new op syntax — no more -> or =.

// 16-bit half-precision float (hardware on some GPUs).
// 2026-09-02 (plan fundamental-parent-membership): the bare fundamental
// parent is the whole join — the parent chain reaches the `Float`
// fundamental, so Float membership, its protocol op bindings, cast paths,
// and the width ladder all DERIVE (`spec MaxBits: 16` selects the f16
// kernel shape). No hashword restatement, no width-suffixed arithmetic
// intrinsics: `+`/`-`/`*` authorize through the Float category and lower
// shape-driven (`fadd half` — the operand type carries the precision).
type Float16 : Float {
    spec MaxBits: 16;
    spec Alignment: 2;
    !> tbaa: "FloatNode";
};

// 4-lane SIMD float vector
type Float4 : Bits {
    spec MaxBits: 128;
    spec Alignment: 16;
    !> tbaa: "FloatNode";

    op Add: FAddV4F32(#Lh, #Rh);
    op Sub: FSubV4F32(#Lh, #Rh);
    op Mul: FMulV4F32(#Lh, #Rh);
};
