// result — Result<T, E> with native enum variant construction + match.
// 2026-08-23 (Phase 10 / enum-construction plan): migrated off the removed
// `uni` dialect — constructors (`Ok(v)`/`Err(e)`) are first-class
// expressions and matching uses exhaustive `match` arms. Partial unwraps
// abort via `trap;` (a wrong-side unwrap is a logic error, not a value).

enum Result<T, E> {
    Ok(T),
    Err(E)
};

defn is_ok<T,E>(r: Result<T,E>) -> Bool {
    term match r {
        Ok(_) => true,
        Err(_) => false,
    };
};

defn is_err<T,E>(r: Result<T,E>) -> Bool {
    term !is_ok(r);
};

defn unwrap<T,E>(r: Result<T,E>) -> T {
    // 2026-10-21: a wrong-side unwrap has no T value. Fabricating `0 as T`
    // silently returned nonsense for object payloads. Keep the documented
    // partial API: trap on misuse, preserve the real payload otherwise.
    term match r {
        Ok(v) => v,
        Err(_) => { trap; },
    };
};

defn unwrap_err<T,E>(r: Result<T,E>) -> E {
    term match r {
        Ok(_) => { trap; },
        Err(e) => e,
    };
};
