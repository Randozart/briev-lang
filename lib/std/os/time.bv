// Native Linux clock and sleep over the centralized syscall interface.
import { syscall, SYS_CLOCK_GETTIME, SYS_NANOSLEEP } from "std/posix/syscall.bv";

import { Ok, Err, is_err, unwrap } from "std/result.bv";

const CLOCK_MONOTONIC: Int = 1;

// 2026-11-03: load measurement must never accept a failed clock read as a
// timestamp. Check errno before reading output and reject Int overflow.
// Keep this checked boundary until the OS interface provides typed timespecs.
defn clock_ns_res(clock_id: Int) -> Result<Int,Int> {
    let ts: Int = Malloc#(16) as Int;
    when ts == 0 { term Err(0 - 12); };
    let result: Int = syscall(SYS_CLOCK_GETTIME,clock_id,ts);
    when result < 0 { Free#(ts as Ptr); term Err(result); };
    let sec: Int = Load#(ts,8);
    let nsec: Int = Load#(ts+8,8);
    Free#(ts as Ptr);
    when sec < 0 || nsec < 0 || nsec >= 1000000000 { term Err(0 - 34); };
    when sec > (9223372036854775807 - nsec) / 1000000000 { term Err(0 - 34); };
    term Ok(sec * 1000000000 + nsec);
};

// Preserve the existing nonnegative contract: unavailable time traps rather
// than fabricating a timestamp. Fallible callers use clock_ns_res instead.
defn now_ns() -> Int [true][term >= 0] {
    let value: Result<Int,Int> = clock_ns_res(CLOCK_MONOTONIC);
    when is_err(value) { trap; };
    let timestamp: Int = unwrap(value);
    when timestamp < 0 { trap; };
    term timestamp;
};

// A successful return means the duration elapsed. An interrupted sleep returns
// negative errno; callers may reschedule against their monotonic deadline.
defn sleep_ms(ms: Int) -> Int [ms >= 0][term <= 0] {
    let req: Int = Malloc#(16) as Int;
    when req == 0 { term 0 - 12; };
    Store#(req,ms / 1000,8);
    Store#(req+8,(ms % 1000) * 1000000,8);
    let result: Int = syscall(SYS_NANOSLEEP,req,0);
    Free#(req as Ptr);
    when result < 0 { term result; };
    term 0;
};
