import "std/result.bv";

// 2026-11-03: Linux x86_64 pollfd storage is 4-byte fd + two 2-byte
// masks. Keep the ABI explicit here; replace with target ABI metadata when
// this stdlib family gains other native targets. Polling never owns the fds.
const POLL_IN: Int = 1;
const POLL_OUT: Int = 4;
const POLL_ERROR: Int = 8;
const POLL_HANGUP: Int = 16;
const POLL_INVALID: Int = 32;
obj PollSet { address: Int; count: Int; };

defn poll_new(count: Int) -> Result<PollSet,Int> {
    when count < 1 || count > 1048576 { term Err(-22); };
    let address: Int = Malloc#(count * 8) as Int;
    when address == 0 { term Err(-12); };
    foreach index in 0..count {
        Store#(address + index * 8, 4294967295, 4);
        Store#(address + index * 8 + 4, 0, 4);
    };
    term Ok(PollSet { address: address, count: count });
};

defn poll_set(polls: PollSet, index: Int, fd: Int, events: Int) -> Void {
    when polls.address == 0 || index < 0 || index >= polls.count { trap; };
    when fd < -1 || fd > 2147483647 || events < 0 || events > 32767 { trap; };
    Store#(polls.address + index * 8, fd, 4);
    Store#(polls.address + index * 8 + 4, events, 2);
    Store#(polls.address + index * 8 + 6, 0, 2);
};

// Finite waits only. EINTR is returned; the caller recomputes its deadline.
// Clear prior events even on syscall failure, so stale readiness is not reused.
defn poll_wait(polls: PollSet, timeout_ms: Int) -> Int {
    when polls.address == 0 || timeout_ms < 0 || timeout_ms > 2147483647 { trap; };
    foreach index in 0..polls.count { Store#(polls.address + index * 8 + 6, 0, 2); };
    term SysCall#(7, polls.address, polls.count, timeout_ms);
};

defn poll_events(polls: PollSet, index: Int) -> Int {
    when polls.address == 0 || index < 0 || index >= polls.count { trap; };
    term Load#(polls.address + index * 8 + 6, 2);
};

// Idempotent for aliases of the same PollSet object. Do not copy raw addresses.
defn poll_free(polls: PollSet) -> Void {
    when polls.address != 0 { Free#(polls.address as Ptr); };
    polls.address = 0;
    polls.count = 0;
};
