// arena — single-direction bump allocator in pure Briev.
//
// 2026-07-18: initial version.
// 2026-10-20 (stdlib fixture campaign, Fixture 3): Arena is an `obj`, so the
// bump offset mutation is visible to the caller. The old `struct` form
// mutated a by-value copy and silently lost the advance — the allocator
// returned the same address forever. All contracts are static; `Alloc#`
// provides the backing buffer.
//
// Lifecycle:
//   1. arena_init(cap)        — allocate the backing buffer
//   2. arena_alloc(a, n)      — bump by n bytes
//   3. arena_alloc_aligned    — bump with power-of-2 alignment
//   4. arena_reset(a)         — rewind offset to 0 (reuse memory)
//   5. arena_free(a)          — release the backing buffer
obj Arena {
    // 2026-10-20 (P1-1): the obj Ptr-field representation is fixed; keep the
    // honest typed field and cast to the i64 handle only for address math.
    base: Ptr<Bit<8>>;
    offset: Int;
    capacity: Int;
};

defn arena_init(cap: Int) [cap >= 0][true] -> Arena {
    let base: Ptr<Bit<8>> = Alloc#(cap) as Ptr<Bit<8>>;
    term Arena { base, offset: 0, capacity: cap };
};

// arena_alloc — allocate `size` bytes at the current offset. The contract
// makes overflow a compile-time obligation at the call site; the mutation is
// on the obj receiver (reference semantics), so the next call sees it.
defn arena_alloc(a: Arena, size: Int)
    [size >= 0 && a.offset + size <= a.capacity]
    [term >= 0]
    -> Ptr<Bit<8>>
{
    let ptr: Ptr<Bit<8>> = (a.base as Int + a.offset) as Ptr<Bit<8>>;
    a.offset = a.offset + size;
    term ptr;
};

// arena_alloc_aligned — round the offset up to `align` (a power of two,
// 1..16), then bump. The extra `align - 1` headroom in the contract covers
// the worst-case padding without a runtime branch.
defn arena_alloc_aligned(a: Arena, size: Int, align: Int)
    [size >= 0 && align >= 1 && align <= 16 && (align & (align - 1)) == 0
        && a.offset + size + (align - 1) <= a.capacity]
    [term >= 0]
    -> Ptr<Bit<8>>
{
    let mis: Int = a.offset % align;
    let pad: Int = (align - mis) % align;
    let off: Int = a.offset + pad;
    let ptr: Ptr<Bit<8>> = (a.base as Int + off) as Ptr<Bit<8>>;
    a.offset = off + size;
    term ptr;
};

// arena_reset — rewind to the start; the backing buffer stays live.
defn arena_reset(a: Arena) [a.capacity >= 0][a.offset == 0] {
    a.offset = 0;
};

// arena_free — release the backing buffer.
defn arena_free(a: Arena) {
    Free#(a.base);
};
