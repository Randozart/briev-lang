// Lexer - Tokenizer for Briev language
// Tier 3: Lexer Components

import "std/char";
import { char_at, len, to_int, to_float } from "std/string";
import { StringBuilder, new_builder, append_char, to_string } from "std/string_builder.bv";

// ===== LEXER STATE =====

obj LexerState {
    source: String
    position: Int
    line: Int
    column: Int
    start_pos: Int
    start_line: Int
    start_column: Int
}

// ===== LEXER CONSTRUCTION =====

defn new_lexer(source: String) -> LexerState {
    term LexerState {
        source: source,
        position: 0,
        line: 1,
        column: 1,
        start_pos: 0,
        start_line: 1,
        start_column: 1
    };
}

// ===== CHARACTER ACCESS =====

defn current_char(state: LexerState) -> Option<Char> {
    when len(state.source) > state.position {
        term Some(state.source[state.position..state.position+1].char_at(0));
    };
    term None;
}

defn peek_char(state: LexerState, offset: Int) -> Option<Char> {
    let pos = state.position + offset;
    when len(state.source) > pos {
        term Some(state.source[pos..pos+1].char_at(0));
    };
    term None;
}

defn advance(state: LexerState) -> LexerState {
    let c = current_char(state);
    when is_some(c) {
        let ch = unwrap(c);
        when ch == '\n' {
            term LexerState {
                source: state.source,
                position: state.position + 1,
                line: state.line + 1,
                column: 1,
                start_pos: state.start_pos,
                start_line: state.start_line,
                start_column: state.start_column
            };
        };
    };
    term LexerState {
        source: state.source,
        position: state.position + 1,
        line: state.line,
        column: state.column + 1,
        start_pos: state.start_pos,
        start_line: state.start_line,
        start_column: state.start_column
    };
}

defn skip_chars(state: LexerState, count: Int) -> LexerState {
    let i: Int = 0;
    when i < count {
        state = advance(state);
        i = i + 1;
    };
    term state;
}

// ===== TOKEN EXTRACTION =====

defn current_token_text(state: LexerState) -> String {
    term state.source[state.start_pos..state.position];
}

defn start_token(state: LexerState) -> LexerState {
    term LexerState {
        source: state.source,
        position: state.position,
        line: state.line,
        column: state.column,
        start_pos: state.position,
        start_line: state.line,
        start_column: state.column
    };
}

// ===== LEXING FUNCTIONS =====

// Skip whitespace
defn skip_whitespace(state: LexerState) -> LexerState {
    when is_some(current_char(state)) {
        let c = unwrap(current_char(state));
        when is_whitespace(c) {
            state = advance(state);
            term skip_whitespace(state);
        };
    };
    term state;
}

// Skip comment
defn skip_comment(state: LexerState) -> LexerState {
    // Assume // comment
    when is_some(current_char(state)) {
        let c = unwrap(current_char(state));
        when c != '\n' {
            state = advance(state);
            term skip_comment(state);
        };
    };
    term state;
}

// Read identifier or keyword
defn read_identifier(state: LexerState) -> (Token, LexerState) {
    when is_some(current_char(state)) {
        let c = unwrap(current_char(state));
        when is_alphanumeric(c) || c == '_' {
            state = advance(state);
            let (tok, state) = read_identifier(state);
            term (tok, state);
        };
    };
    
    // End of identifier - check if keyword
    let text = current_token_text(state);
    
    // Check keywords
    when text == "let" { term (KeywordLet, state); };
    when text == "const" { term (KeywordConst, state); };
    when text == "txn" { term (KeywordTxn, state); };
        when text == "node" { term (KeywordNode, state); };
    when text == "async" { term (KeywordAsync, state); };
    when text == "term" { term (KeywordTerm, state); };
    when text == "escape" { term (KeywordEscape, state); };
    when text == "defn" { term (KeywordDefn, state); };
    when text == "sig" { term (KeywordSig, state); };
    when text == "frgn" { term (KeywordFrgn, state); };
    when text == "obj" { term (KeywordStruct, state); };
    when text == "enum" { term (KeywordEnum, state); };
    when text == "data" { term (KeywordData, state); };
    when text == "import" { term (KeywordImport, state); };
    when text == "from" { term (KeywordFrom, state); };
    when text == "as" { term (KeywordAs, state); };
    when text == "true" { term (KeywordTrue, state); };
    when text == "false" { term (KeywordFalse, state); };
    when text == "trg" { term (KeywordTrg, state); };
    when text == "trigger" { term (KeywordTrg, state); };
    when text == "TRG" { term (KeywordTrg, state); };
    when text == "TRIGGER" { term (KeywordTrg, state); };
    when text == "rstruct" { term (KeywordRstruct, state); };
    when text == "render" { term (KeywordRender, state); };
    
    // Not a keyword - it's an identifier
    term (TokenIdentifier(text), state);
}

// Read number (int or float)
defn read_number(state: LexerState) -> (Token, LexerState) {
    // Check for hex
    when is_some(current_char(state)) && unwrap(current_char(state)) == '0' {
        when is_some(peek_char(state, 1)) {
            let next = unwrap(peek_char(state, 1));
            when next == 'x' || next == 'X' {
                state = advance(state);  // consume 0
                state = advance(state);  // consume x/X
                let (tok, state) = read_hex_number(state);
                term (tok, state);
            };
        };
    };
    
    // Read decimal
    when is_some(current_char(state)) {
        let c = unwrap(current_char(state));
        when is_digit(c) {
            state = advance(state);
            let (tok, state) = read_number(state);
            term (tok, state);
        };
        when c == '.' {
            // Float
            when is_some(peek_char(state, 1)) {
                let next = unwrap(peek_char(state, 1));
                when is_digit(next) {
                    state = advance(state);  // consume .
                    let (tok, state) = read_float_fraction(state);
                    term (tok, state);
                };
            };
        };
    };
    
    // End of number
    let text = current_token_text(state);
    term (TokenInt(to_int(text)), state);
}

defn read_hex_number(state: LexerState) -> (Token, LexerState) {
    when is_some(current_char(state)) {
        let c = unwrap(current_char(state));
        when is_hex_digit(c) {
            state = advance(state);
            let (tok, state) = read_hex_number(state);
            term (tok, state);
        };
    };
    
    let text = current_token_text(state);
    term (TokenInt(to_int(text)), state);
}

defn read_float_fraction(state: LexerState) -> (Token, LexerState) {
    when is_some(current_char(state)) {
        let c = unwrap(current_char(state));
        when is_digit(c) {
            state = advance(state);
            let (tok, state) = read_float_fraction(state);
            term (tok, state);
        };
    };
    
    let text = current_token_text(state);
    term (TokenFloat(to_float(text)), state);
}

// Read string literal
defn read_string(state: LexerState) -> (Token, LexerState) {
    // Skip opening quote
    state = advance(state);
    
    let sb = new_builder();
    
    when is_some(current_char(state)) {
        let c = unwrap(current_char(state));
        when c != '"' {
            when c == '\\' {
                // Escape sequence
                state = advance(state);
                when is_some(current_char(state)) {
                    let escaped = unwrap(current_char(state));
                    when escaped == 'n' { sb = append_char(sb, '\n'); };
                    when escaped == 't' { sb = append_char(sb, '\t'); };
                    when escaped == 'r' { sb = append_char(sb, '\r'); };
                    when escaped == '\\' { sb = append_char(sb, '\\'); };
                    when escaped == '"' { sb = append_char(sb, '"'); };
                    state = advance(state);
                };
            };
            when c != '\\' {
                sb = append_char(sb, c);
                state = advance(state);
            };
        };
    };
    
    // Skip closing quote
    when is_some(current_char(state)) && unwrap(current_char(state)) == '"' {
        state = advance(state);
    };
    
    term (TokenString(to_string(sb)), state);
}

// Read char literal
defn read_char_literal(state: LexerState) -> (Token, LexerState) {
    // Skip opening quote
    state = advance(state);
    
    let c: Char = ' ';
    
    when is_some(current_char(state)) {
        let ch = unwrap(current_char(state));
        when ch != '\'' {
            when ch == '\\' {
                // Escape sequence
                state = advance(state);
                when is_some(current_char(state)) {
                    let escaped = unwrap(current_char(state));
                    when escaped == 'n' { c = '\n'; };
                    when escaped == 't' { c = '\t'; };
                    when escaped == 'r' { c = '\r'; };
                    when escaped == '\\' { c = '\\'; };
                    when escaped == '\'' { c = '\''; };
                    state = advance(state);
                };
            };
            when ch != '\\' {
                c = ch;
                state = advance(state);
            };
        };
    };
    
    // Skip closing quote
    when is_some(current_char(state)) && unwrap(current_char(state)) == '\'' {
        state = advance(state);
    };
    
    term (TokenChar(c), state);
}

// ===== MAIN LEXER FUNCTION =====

defn next_token(state: LexerState) -> Result<(Token, LexerState), String> {
    // Skip whitespace
    state = skip_whitespace(state);
    
    // Check for EOF
    when is_none(current_char(state)) {
        term Ok((TokenEof, state));
    };
    
    // Start new token
    state = start_token(state);
    
    let c = unwrap(current_char(state));
    
    // Single-char operators
    when c == '+' { state = advance(state); term Ok((OpPlus, state)); };
    when c == '-' { state = advance(state); term Ok((OpMinus, state)); };
    when c == '*' { state = advance(state); term Ok((OpStar, state)); };
    when c == '/' {
        // Check for comment
        when is_some(peek_char(state, 1)) && unwrap(peek_char(state, 1)) == '/' {
            state = advance(state);
            state = advance(state);
            state = skip_comment(state);
            term next_token(state);  // Recurse to get next token
        };
        state = advance(state);
        term Ok((OpSlash, state));
    };
    when c == '%' { state = advance(state); term Ok((OpPercent, state)); };
    when c == '=' { state = advance(state); term Ok((OpEq, state)); };
    when c == '!' { state = advance(state); term Ok((OpBang, state)); };
    when c == '&' { state = advance(state); term Ok((OpAmp, state)); };
    when c == '|' { state = advance(state); term Ok((OpPipe, state)); };
    when c == '^' { state = advance(state); term Ok((OpCaret, state)); };
    when c == '~' { state = advance(state); term Ok((OpTilde, state)); };
    when c == '?' { state = advance(state); term Ok((OpQuestion, state)); };
    when c == '#' {
        when is_some(peek_char(state, 1)) {
            let next = unwrap(peek_char(state, 1));
            when next == '!' {
                state = advance(state);
                state = advance(state);
                term Ok((HashBang, state));
            };
            when next == '[' {
                state = advance(state);
                state = advance(state);
                term Ok((HashBracket, state));
            };
            when next == '(' {
                state = advance(state);
                state = advance(state);
                term Ok((HashParen, state));
            };
            when next == '?' {
                state = advance(state);
                state = advance(state);
                term Ok((HashQuestion, state));
            };
            when is_alpha(next) || next == '_' {
                state = advance(state);
                term Ok((Hash, state));
            };
        };
        state = advance(state);
        term Ok((TokenComment("#"), state));
    };
    when c == '@' { state = advance(state); term Ok((OpAt, state)); };
    when c == '.' { state = advance(state); term Ok((OpDot, state)); };
    when c == ':' { state = advance(state); term Ok((OpColon, state)); };
    when c == ';' { state = advance(state); term Ok((OpSemicolon, state)); };
    when c == ',' { state = advance(state); term Ok((OpComma, state)); };
    
    // Delimiters
    when c == '(' { state = advance(state); term Ok((DelimLParen, state)); };
    when c == ')' { state = advance(state); term Ok((DelimRParen, state)); };
    when c == '{' { state = advance(state); term Ok((DelimLBrace, state)); };
    when c == '}' { state = advance(state); term Ok((DelimRBrace, state)); };
    when c == '[' { state = advance(state); term Ok((DelimLBracket, state)); };
    when c == ']' { state = advance(state); term Ok((DelimRBracket, state)); };
    
    // Multi-char operators (check first)
    when c == '<' {
        when is_some(peek_char(state, 1)) {
            let next = unwrap(peek_char(state, 1));
            when next == '=' {
                state = advance(state);
                state = advance(state);
                term Ok((OpLtEq, state));
            };
            when next == '<' {
                state = advance(state);
                state = advance(state);
                term Ok((OpLtLt, state));
            };
            when next == '-' {
                state = advance(state);
                state = advance(state);
                term Ok((OpArrow, state));
            };
        };
        state = advance(state);
        term Ok((OpLt, state));
    };
    
    when c == '>' {
        when is_some(peek_char(state, 1)) {
            let next = unwrap(peek_char(state, 1));
            when next == '=' {
                state = advance(state);
                state = advance(state);
                term Ok((OpGtEq, state));
            };
            when next == '>' {
                state = advance(state);
                state = advance(state);
                term Ok((OpGtGt, state));
            };
            when next == '=' {
                state = advance(state);
                state = advance(state);
                term Ok((OpFatArrow, state));
            };
        };
        state = advance(state);
        term Ok((OpGt, state));
    };
    
    when c == '|' {
        when is_some(peek_char(state, 1)) && unwrap(peek_char(state, 1)) == '|' {
            state = advance(state);
            state = advance(state);
            term Ok((OpOr, state));
        };
    };
    
    when c == '&' {
        when is_some(peek_char(state, 1)) && unwrap(peek_char(state, 1)) == '&' {
            state = advance(state);
            state = advance(state);
            term Ok((OpAnd, state));
        };
    };
    
    // Literals
    when is_digit(c) {
        let (tok, state) = read_number(state);
        term Ok((tok, state));
    };
    
    when is_alpha(c) || c == '_' {
        let (tok, state) = read_identifier(state);
        term Ok((tok, state));
    };
    
    when c == '"' {
        let (tok, state) = read_string(state);
        term Ok((tok, state));
    };
    
    when c == '\'' {
        let (tok, state) = read_char_literal(state);
        term Ok((tok, state));
    };
    
    // Unknown character
    term Err("Unexpected character: " + char_to_string(c));
}

// ===== FULL TOKENIZATION =====

defn tokenize(source: String) -> Result<List<Token>, String> {
    let tokens: List<Token> = [];
    let state = new_lexer(source);
    
    when true {
        let result = next_token(state);
        when is_ok(result) {
            let (tok, new_state) = unwrap(result);
            &tokens <- tok;
            state = new_state;
            when tok != TokenEof {
                term tokenize_continue(source, tokens, state);
            };
        };
        when is_err(result) {
            term Err(unwrap_err(result));
        };
    };
    
    term Ok(tokens);
}

defn tokenize_continue(source: String, tokens: List<Token>, state: LexerState) -> Result<List<Token>, String> {
    let result = next_token(state);
    when is_ok(result) {
        let (tok, new_state) = unwrap(result);
        &tokens <- tok;
        when tok != TokenEof {
            term tokenize_continue(source, tokens, new_state);
        };
    };
    when is_err(result) {
        term Err(unwrap_err(result));
    };
    term Ok(tokens);
}
