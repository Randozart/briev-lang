// Token - Lexer token type definition
// Tier 3: Lexer Components

import { StringBuilder, new_builder, append_str, append_int, append_char } from "std/string_builder.bv";
import "std/char";

// ===== TOKEN ENUM =====

enum Token {
    // Literals
    TokenInt(Int),
    TokenFloat(Float),
    TokenString(String),
    TokenChar(Char),
    
    // Keywords (grouped by category)
    
    // State and constants
    KeywordLet,
    KeywordConst,
    KeywordState,
    
    // Transactions
    KeywordTxn,
    KeywordRct,
    KeywordAsync,
    KeywordTerm,
    KeywordEscape,
    
    // Functions
    KeywordDefn,
    KeywordSig,
    KeywordSign,
    KeywordSignature,
    
    // FFI
    KeywordFrgn,
    KeywordSyscall,
    KeywordResource,
    KeywordRsrc,
    
    // Types
    KeywordStruct,
    KeywordRstruct,
    KeywordEnum,
    KeywordType,
    KeywordData,
    
    // Control
    KeywordImport,
    KeywordFrom,
    KeywordAs,
    KeywordForall,
    KeywordExists,
    KeywordWithin,
    KeywordUnification,
    
    // Hardware
    KeywordTrg,
    KeywordTrgBang,  // trg!
    KeywordLink,
    KeywordBank,
    
    // Assembly
    KeywordAsm,
    KeywordStage,
    KeywordOn,
    
    // Rendered Briev
    KeywordRender,
    
    // Boolean literals
    KeywordTrue,
    KeywordFalse,
    
    // Result types
    KeywordOk,
    KeywordErr,
    
    // Operators (single char)
    OpPlus,          // +
    OpMinus,         // -
    OpStar,          // *
    OpSlash,         // /
    OpPercent,       // %
    OpEq,            // =
    OpBang,          // !
    OpAmp,           // &
    OpPipe,          // |
    OpCaret,         // ^
    OpTilde,         // ~
    OpQuestion,      // ?
    OpAt,            // @
    OpDot,           // .
    OpColon,         // :
    OpSemicolon,     // ;
    OpComma,         // ,
    
    // Operators (multi-char)
    OpEqEq,          // ==
    OpNeq,           // !=
    OpLt,            // <
    OpGt,            // >
    OpLtEq,          // <=
    OpGtEq,          // >=
    OpAnd,           // &&
    OpOr,            // ||
    OpAmpAmp,        // && (alias)
    OpPipePipe,      // || (alias)
    OpLtLt,          // <<
    OpGtGt,          // >>
    OpArrow,         // ->
    OpFatArrow,      // =>
    OpSlashSlash,    // //
    OpDotDot,        // ..
    OpDotDotEq,      // ..=
    OpPlusEq,        // +=
    OpMinusEq,       // -=
    OpStarEq,        // *=
    OpSlashEq,       // /=
    OpPercentEq,     // %=
    OpAmpEq,         // &=
    OpPipeEq,        // |=
    OpCaretEq,       // ^=
    OpLtLtEq,        // <<=
    OpGtGtEq,        // >>=
    
    // Delimiters
    DelimLParen,     // (
    DelimRParen,     // )
    DelimLBrace,     // {
    DelimRBrace,     // }
    DelimLBracket,   // [
    DelimRBracket,   // ]
    
    // Hashtag modifiers
    Hash,            // # (block pragma prefix)
    HashBang,        // #!
    HashBracket,     // #[
    HashParen,       // #(
    HashQuestion,    // #?
    
    // Special
    TokenIdentifier(String),
    TokenComment(String),
    TokenWhitespace(String),
    TokenNewline,
    TokenEof,
    TokenError(String)
}

// ===== TOKEN UTILITIES =====

// Check if token is a keyword
defn is_keyword(tok: Token) -> Bool {
    term match tok {
        KeywordLet => true,
        KeywordConst => true,
        KeywordTxn => true,
        KeywordRct => true,
        KeywordAsync => true,
        KeywordDefn => true,
        KeywordSig => true,
        KeywordFrgn => true,
        KeywordStruct => true,
        KeywordEnum => true,
        KeywordImport => true,
        KeywordTrue => true,
        KeywordFalse => true,
        KeywordUnification => true,
        KeywordTerm => true,
        _ => false,
    };
};

// Get keyword as string
defn keyword_to_string(tok: Token) -> String {
    term match tok {
        KeywordLet => "let",
        KeywordConst => "const",
        KeywordTxn => "txn",
        KeywordNode => "node",
        KeywordAsync => "async",
        KeywordTerm => "term",
        KeywordEscape => "escape",
        KeywordDefn => "defn",
        KeywordSig => "sig",
        KeywordFrgn => "frgn",
        KeywordSyscall => "syscall",
        KeywordStruct => "obj",
        KeywordRstruct => "rstruct",
        KeywordEnum => "enum",
        KeywordType => "type",
        KeywordData => "data",
        KeywordImport => "import",
        KeywordFrom => "from",
        KeywordAs => "as",
        KeywordTrue => "true",
        KeywordFalse => "false",
        KeywordUnification => "unification",
        KeywordRender => "render",
        _ => "",
    };
};

// Check if token is an operator
defn is_operator(tok: Token) -> Bool {
    term match tok {
        OpPlus => true,
        OpMinus => true,
        OpStar => true,
        OpSlash => true,
        OpEqEq => true,
        OpNeq => true,
        OpLt => true,
        OpGt => true,
        _ => false,
    };
};

// Get operator precedence (higher = binds tighter)
defn operator_precedence(tok: Token) -> Int {
    // Multiplication/division (highest)
    term match tok {
        OpStar => 11,
        OpSlash => 11,
        OpPercent => 11,

        // Addition/subtraction
        OpPlus => 10,
        OpMinus => 10,

        // Comparisons
        OpLt => 8,
        OpGt => 8,
        OpLtEq => 8,
        OpGtEq => 8,

        // Equality
        OpEqEq => 7,
        OpNeq => 7,

        // Logical AND
        OpAnd => 5,

        // Logical OR
        OpOr => 4,

        // Assignment (lowest)
        OpEq => 1,

        _ => 0,
    };
};

// Check if operator is right-associative
defn is_right_associative(tok: Token) -> Bool {
    term match tok {
        OpEq => true,
        OpPlusEq => true,
        OpMinusEq => true,
        _ => false,
    };
};

// Token equality
defn token_eq(a: Token, b: Token) -> Bool {
    // Compare variants
    term false;  // Placeholder - needs pattern matching on both
};

// Token to string (for error messages)
defn token_to_string(tok: Token) -> String {
    let sb = new_builder();

    match tok {
        TokenInt(n) => {
            sb = append_str(sb, "Int(");
            sb = append_int(sb, n);
            sb = append_char(sb, ')');
        },
        TokenFloat(f) => {
            sb = append_str(sb, "Float(");
            sb = append_char(sb, ')');
        },
        TokenString(s) => {
            sb = append_str(sb, "String(\"");
            sb = append_str(sb, s);
            sb = append_str(sb, "\")");
        },
        TokenChar(c) => {
            sb = append_str(sb, "Char('");
            sb = append_char(sb, c);
            sb = append_str(sb, "')");
        },
        TokenIdentifier(name) => {
            sb = append_str(sb, "Identifier(");
            sb = append_str(sb, name);
            sb = append_char(sb, ')');
        },
        TokenEof => {
            sb = append_str(sb, "Eof");
        },
        TokenError(msg) => {
            sb = append_str(sb, "Error(");
            sb = append_str(sb, msg);
            sb = append_char(sb, ')');
        },
        _ => {
            when is_keyword(tok) {
                sb = append_str(sb, "Keyword(");
                sb = append_str(sb, keyword_to_string(tok));
                sb = append_char(sb, ')');
            };
        },
    };

    term sb.buffer;
};

// Check if token is a literal
defn is_literal(tok: Token) -> Bool {
    term match tok {
        TokenInt(_) => true,
        TokenFloat(_) => true,
        TokenString(_) => true,
        TokenChar(_) => true,
        KeywordTrue => true,
        KeywordFalse => true,
        _ => false,
    };
};

// Get literal value as string
defn literal_to_string(tok: Token) -> String {
    term match tok {
        TokenInt(n) => n as String,
        TokenFloat(f) => f as String,
        TokenString(s) => s,
        TokenChar(c) => char_to_string(c),
        KeywordTrue => "true",
        KeywordFalse => "false",
        _ => "",
    };
};

defn unwrap_identifier(tok: Token) -> String {
    term match tok {
        TokenIdentifier(name) => name,
        _ => keyword_to_string(tok),
    };
};

defn is_identifier(tok: Token) -> Bool {
    term match tok {
        TokenIdentifier(_) => true,
        _ => keyword_to_string(tok) != "",
    };
};

defn is_string_token(tok: Token) -> Bool {
    term match tok {
        TokenString(_) => true,
        _ => false,
    };
};

defn unwrap_string(tok: Token) -> String {
    term match tok {
        TokenString(s) => s,
        _ => "",
    };
};
