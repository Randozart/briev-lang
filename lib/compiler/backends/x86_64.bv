// x86-64 Binary Backend - Direct machine code generation
// Tier 7 Part 2

import "call_graph";

// ===== X86_64 INSTRUCTION ENUM =====

enum X64Instr {
    // Data movement
    MOV(String, String),           // mov r64, r64
    MOV_IMM(String, Int),          // mov r64, imm
    MOV_MEM(String, String, Int),  // mov r64, [r64+offset]
    MOV_MEM_IMM(String, Int, Int), // mov [r64+offset], imm
    
    // Arithmetic
    ADD(String, String),           // add r64, r64
    ADD_IMM(String, Int),          // add r64, imm
    SUB(String, String),           // sub r64, r64
    SUB_IMM(String, Int),          // sub r64, imm
    IMUL(String, String),          // imul r64, r64
    IMUL_IMM(String, Int),         // imul r64, imm
    
    // Logic
    AND(String, String),           // and r64, r64
    OR(String, String),            // or r64, r64
    XOR(String, String),           // xor r64, r64
    NOT(String),                   // not r64
    NEG(String),                   // neg r64
    
    // Compare
    CMP(String, String),           // cmp r64, r64
    CMP_IMM(String, Int),          // cmp r64, imm
    TEST(String, String),          // test r64, r64
    
    // Control flow
    JMP(String),                   // jmp label
    JE(String),                    // je label
    JNE(String),                   // jne label
    JL(String),                    // jl label
    JG(String),                    // jg label
    JLE(String),                   // jle label
    JGE(String),                   // jge label
    CALL(String),                  // call label
    RET,                           // ret
    NOP,                           // nop
    
    // Stack
    PUSH(String),                  // push r64
    POP(String),                   // pop r64
    LEAVE,                         // leave
    ENTER(Int, Int),               // enter size, 0
    
    // Labels
    Label(String),
    Comment(String)
}

// ===== REGISTER DEFINITIONS =====

defn x64_callee_saved() -> List<String> {
    term ["RBX", "RBP", "R12", "R13", "R14", "R15"];
}

defn x64_caller_saved() -> List<String> {
    term ["RAX", "RCX", "RDX", "RSI", "RDI", "R8", "R9", "R10", "R11"];
}

defn x64_reg_to_num(reg: String) -> Int {
    when reg == "RAX" { term 0; };
    when reg == "RCX" { term 1; };
    when reg == "RDX" { term 2; };
    when reg == "RBX" { term 3; };
    when reg == "RSP" { term 4; };
    when reg == "RBP" { term 5; };
    when reg == "RSI" { term 6; };
    when reg == "RDI" { term 7; };
    when reg == "R8" { term 8; };
    when reg == "R9" { term 9; };
    when reg == "R10" { term 10; };
    when reg == "R11" { term 11; };
    when reg == "R12" { term 12; };
    when reg == "R13" { term 13; };
    when reg == "R14" { term 14; };
    when reg == "R15" { term 15; };
    term 0;
}

// ===== INSTRUCTION EMISSION =====

defn x64_emit_mov(rd: String, rs: String) -> X64Instr {
    term MOV(rd, rs);
}

defn x64_emit_mov_imm(rd: String, imm: Int) -> X64Instr {
    term MOV_IMM(rd, imm);
}

defn x64_emit_add(rd: String, rs: String) -> X64Instr {
    term ADD(rd, rs);
}

defn x64_emit_add_imm(rd: String, imm: Int) -> X64Instr {
    term ADD_IMM(rd, imm);
}

defn x64_emit_sub(rd: String, rs: String) -> X64Instr {
    term SUB(rd, rs);
}

defn x64_emit_sub_imm(rd: String, imm: Int) -> X64Instr {
    term SUB_IMM(rd, imm);
}

defn x64_emit_cmp(rn: String, rm: String) -> X64Instr {
    term CMP(rn, rm);
}

defn x64_emit_je(label: String) -> X64Instr {
    term JE(label);
}

defn x64_emit_jne(label: String) -> X64Instr {
    term JNE(label);
}

defn x64_emit_jmp(label: String) -> X64Instr {
    term JMP(label);
}

defn x64_emit_call(label: String) -> X64Instr {
    term CALL(label);
}

defn x64_emit_ret() -> X64Instr {
    term RET;
}

defn x64_emit_label(name: String) -> X64Instr {
    term Label(name);
}

// ===== BINARY ENCODING =====

defn x64_instr_byte_size(instr: X64Instr) -> Int {
    uni instr(Label(_)) = { term 0; };
    uni instr(Comment(_)) = { term 0; };
    uni instr(RET) = { term 1; };
    uni instr(NOP) = { term 1; };
    uni instr(PUSH(_)) = { term 1; };
    uni instr(POP(_)) = { term 1; };
    uni instr(LEAVE) = { term 1; };
    uni instr(JE(_)) = { term 6; };   // 0F 84 + rel32
    uni instr(JNE(_)) = { term 6; };  // 0F 85 + rel32
    uni instr(JL(_)) = { term 6; };   // 0F 8C + rel32
    uni instr(JG(_)) = { term 6; };   // 0F 8F + rel32
    uni instr(JLE(_)) = { term 6; };  // 0F 8E + rel32
    uni instr(JGE(_)) = { term 6; };  // 0F 8D + rel32
    uni instr(JMP(_)) = { term 5; };  // E9 + rel32
    uni instr(CALL(_)) = { term 5; }; // E8 + rel32
    term 4;  // Default for most instructions
}

defn x64_encode_instr_with_labels(instr: X64Instr, pc: Int, labels: HashMap<String, Int>) -> List<u8> {
    uni instr(MOV(rd, rs)) = {
        let rd_num = x64_reg_to_num(rd);
        let rs_num = x64_reg_to_num(rs);
        term [0x48, 0x89, 0xC0 | (rd_num) | (rs_num << 3)];
    };
    
    uni instr(MOV_IMM(rd, imm)) = {
        let rd_num = x64_reg_to_num(rd);
        let bytes = [0x48, 0xB8 | rd_num];
        bytes = bytes.append_all(u64_to_le_bytes(imm as u64));
        term bytes;
    };
    
    uni instr(MOV_MEM(rd, rn, offset)) = {
        let rd_num = x64_reg_to_num(rd);
        let rn_num = x64_reg_to_num(rn);
        let imm8 = offset AND 0xFF;
        term [0x48, 0x8B, 0x40 | rn_num | (rd_num << 3), imm8 as u8];
    };
    
    uni instr(MOV_MEM_IMM(rn, offset, imm)) = {
        let rn_num = x64_reg_to_num(rn);
        let imm8 = offset AND 0xFF;
        let imm32 = imm AND 0xFFFFFFFF;
        let bytes = [0x48, 0xC7, 0x40 | rn_num | (0 << 3), imm8 as u8];
        bytes = bytes.append_all(u32_to_le_bytes(imm32 as u32));
        term bytes;
    };
    
    uni instr(ADD(rd, rs)) = {
        let rd_num = x64_reg_to_num(rd);
        let rs_num = x64_reg_to_num(rs);
        term [0x48, 0x01, 0xC0 | (rd_num) | (rs_num << 3)];
    };
    
    uni instr(ADD_IMM(rd, imm)) = {
        let rd_num = x64_reg_to_num(rd);
        term [0x48, 0x83, 0xC0 | rd_num, imm as u8];
    };
    
    uni instr(SUB(rd, rs)) = {
        let rd_num = x64_reg_to_num(rd);
        let rs_num = x64_reg_to_num(rs);
        term [0x48, 0x29, 0xC0 | (rd_num) | (rs_num << 3)];
    };
    
    uni instr(SUB_IMM(rd, imm)) = {
        let rd_num = x64_reg_to_num(rd);
        term [0x48, 0x83, 0xE8 | rd_num, imm as u8];
    };
    
    uni instr(IMUL(rd, rs)) = {
        let rd_num = x64_reg_to_num(rd);
        let rs_num = x64_reg_to_num(rs);
        term [0x48, 0x0F, 0xAF, 0xC0 | (rd_num) | (rs_num << 3)];
    };
    
    uni instr(IMUL_IMM(rd, imm)) = {
        let rd_num = x64_reg_to_num(rd);
        let imm8 = imm AND 0xFF;
        term [0x48, 0x6B, 0xC0 | rd_num, imm8 as u8];
    };
    
    uni instr(AND(rd, rs)) = {
        let rd_num = x64_reg_to_num(rd);
        let rs_num = x64_reg_to_num(rs);
        term [0x48, 0x21, 0xC0 | (rd_num) | (rs_num << 3)];
    };
    
    uni instr(OR(rd, rs)) = {
        let rd_num = x64_reg_to_num(rd);
        let rs_num = x64_reg_to_num(rs);
        term [0x48, 0x09, 0xC0 | (rd_num) | (rs_num << 3)];
    };
    
    uni instr(XOR(rd, rs)) = {
        let rd_num = x64_reg_to_num(rd);
        let rs_num = x64_reg_to_num(rs);
        term [0x48, 0x31, 0xC0 | (rd_num) | (rs_num << 3)];
    };
    
    uni instr(NOT(rd)) = {
        let rd_num = x64_reg_to_num(rd);
        term [0x48, 0xF7, 0xD0 | rd_num];
    };
    
    uni instr(NEG(rd)) = {
        let rd_num = x64_reg_to_num(rd);
        term [0x48, 0xF7, 0xD8 | rd_num];
    };
    
    uni instr(CMP(rn, rm)) = {
        let rn_num = x64_reg_to_num(rn);
        let rm_num = x64_reg_to_num(rm);
        term [0x48, 0x39, 0xF0 | (rn_num) | (rm_num << 3)];
    };
    
    uni instr(CMP_IMM(rn, imm)) = {
        let rn_num = x64_reg_to_num(rn);
        term [0x48, 0x83, 0xF8 | rn_num, imm as u8];
    };
    
    uni instr(TEST(rn, rm)) = {
        let rn_num = x64_reg_to_num(rn);
        let rm_num = x64_reg_to_num(rm);
        term [0x48, 0x85, 0xC0 | (rn_num) | (rm_num << 3)];
    };
    
    uni instr(JE(label)) = {
        when labels.contains_key(label) {
            let target = labels.get(label).unwrap();
            let offset = target - (pc + 6);  // rel32 from end of instruction
            let enc = offset as i32;
            let bytes = [0x0F, 0x84];
            bytes.append_all(u32_to_le_bytes(enc as u32));
        };
        term [0x0F, 0x84, 0x00, 0x00, 0x00, 0x00];
    };
    
    uni instr(JNE(label)) = {
        when labels.contains_key(label) {
            let target = labels.get(label).unwrap();
            let offset = target - (pc + 6);
            let enc = offset as i32;
            let bytes = [0x0F, 0x85];
            bytes.append_all(u32_to_le_bytes(enc as u32));
        };
        term [0x0F, 0x85, 0x00, 0x00, 0x00, 0x00];
    };
    
    uni instr(JL(label)) = {
        when labels.contains_key(label) {
            let target = labels.get(label).unwrap();
            let offset = target - (pc + 6);
            let enc = offset as i32;
            let bytes = [0x0F, 0x8C];
            bytes.append_all(u32_to_le_bytes(enc as u32));
        };
        term [0x0F, 0x8C, 0x00, 0x00, 0x00, 0x00];
    };
    
    uni instr(JG(label)) = {
        when labels.contains_key(label) {
            let target = labels.get(label).unwrap();
            let offset = target - (pc + 6);
            let enc = offset as i32;
            let bytes = [0x0F, 0x8F];
            bytes.append_all(u32_to_le_bytes(enc as u32));
        };
        term [0x0F, 0x8F, 0x00, 0x00, 0x00, 0x00];
    };
    
    uni instr(JLE(label)) = {
        when labels.contains_key(label) {
            let target = labels.get(label).unwrap();
            let offset = target - (pc + 6);
            let enc = offset as i32;
            let bytes = [0x0F, 0x8E];
            bytes.append_all(u32_to_le_bytes(enc as u32));
        };
        term [0x0F, 0x8E, 0x00, 0x00, 0x00, 0x00];
    };
    
    uni instr(JGE(label)) = {
        when labels.contains_key(label) {
            let target = labels.get(label).unwrap();
            let offset = target - (pc + 6);
            let enc = offset as i32;
            let bytes = [0x0F, 0x8D];
            bytes.append_all(u32_to_le_bytes(enc as u32));
        };
        term [0x0F, 0x8D, 0x00, 0x00, 0x00, 0x00];
    };
    
    uni instr(JMP(label)) = {
        when labels.contains_key(label) {
            let target = labels.get(label).unwrap();
            let offset = target - (pc + 5);  // rel32 from end of instruction
            let enc = offset as i32;
            let bytes = [0xE9];
            bytes.append_all(u32_to_le_bytes(enc as u32));
        };
        term [0xE9, 0x00, 0x00, 0x00, 0x00];
    };
    
    uni instr(CALL(label)) = {
        when labels.contains_key(label) {
            let target = labels.get(label).unwrap();
            let offset = target - (pc + 5);
            let enc = offset as i32;
            let bytes = [0xE8];
            bytes.append_all(u32_to_le_bytes(enc as u32));
        };
        term [0xE8, 0x00, 0x00, 0x00, 0x00];
    };
    
    uni instr(RET) = {
        term [0xC3];
    };
    
    uni instr(NOP) = {
        term [0x90];
    };
    
    uni instr(PUSH(reg)) = {
        let reg_num = x64_reg_to_num(reg);
        term [0x50 | reg_num];
    };
    
    uni instr(POP(reg)) = {
        let reg_num = x64_reg_to_num(reg);
        term [0x58 | reg_num];
    };
    
    uni instr(LEAVE) = {
        term [0xC9];
    };
    
    uni instr(ENTER(size, _)) = {
        let imm16 = size AND 0xFFFF;
        term [0xC8, imm16 as u8, ((imm16 >> 8) AND 0xFF) as u8, 0x00];
    };
    
    uni instr(Label(_)) = {
        term [];
    };
    
    uni instr(Comment(_)) = {
        term [];
    };
    
    term [0x90];  // nop
}

defn x64_resolve_labels(instrs: List<X64Instr>) -> HashMap<String, Int> {
    let labels: HashMap<String, Int> = new_map();
    let pc: Int = 0;
    
    let i: Int = 0;
    when i < instrs.len() {
        uni instrs[i](Label(name)) = {
            labels = labels.insert(name, pc);
        };
        [!uni instrs[i](Label(_)) = true] {
            pc = pc + x64_instr_byte_size(instrs[i]);
        };
        i = i + 1;
    };
    
    term labels;
}

defn x64_emit_binary(instrs: List<X64Instr>) -> List<u8> {
    // Pass 1: Resolve all label positions
    let labels = x64_resolve_labels(instrs);
    
    // Pass 2: Encode instructions with resolved labels
    let binary: List<u8> = [];
    let pc: Int = 0;
    
    let i: Int = 0;
    when i < instrs.len() {
        let bytes = x64_encode_instr_with_labels(instrs[i], pc, labels);
        binary = binary.append_all(bytes);
        pc = pc + x64_instr_byte_size(instrs[i]);
        i = i + 1;
    };
    
    term binary;
}

defn u32_to_le_bytes(n: u32) -> List<u8> {
    term [(n AND 0xFF) as u8, ((n >> 8) AND 0xFF) as u8, ((n >> 16) AND 0xFF) as u8, ((n >> 24) AND 0xFF) as u8];
}

defn u64_to_le_bytes(n: u64) -> List<u8> {
    term [
        (n AND 0xFF) as u8,
        ((n >> 8) AND 0xFF) as u8,
        ((n >> 16) AND 0xFF) as u8,
        ((n >> 24) AND 0xFF) as u8,
        ((n >> 32) AND 0xFF) as u8,
        ((n >> 40) AND 0xFF) as u8,
        ((n >> 48) AND 0xFF) as u8,
        ((n >> 56) AND 0xFF) as u8
    ];
}

// ===== CODE GENERATION =====

defn x64_generate_reactor(txns: List<Transaction>) -> List<X64Instr> {
    let instrs: List<X64Instr> = [];
    
    // Entry point
    instrs = instrs.append(x64_emit_label("reactor_entry"));
    instrs = instrs.append(x64_emit_push("RBP"));
    instrs = instrs.append(x64_emit_mov("RBP", "RSP"));
    instrs = instrs.append(x64_emit_sub_imm("RSP", 16));
    
    // Reactor loop
    instrs = instrs.append(x64_emit_label("reactor_loop"));
    
    // Call each transaction
    let i: Int = 0;
    when i < txns.len() {
        instrs = instrs.append(x64_emit_call(txns[i].name + "_check"));
        i = i + 1;
    };
    
    // Loop back
    instrs = instrs.append(x64_emit_jmp("reactor_loop"));
    
    // Exit
    instrs = instrs.append(x64_emit_label("reactor_exit"));
    instrs = instrs.append(x64_emit_mov("RSP", "RBP"));
    instrs = instrs.append(x64_emit_pop("RBP"));
    instrs = instrs.append(x64_emit_ret());
    
    term instrs;
}

defn x64_generate_transaction_check(txn: Transaction) -> List<X64Instr> {
    let instrs: List<X64Instr> = [];
    
    // Label
    instrs = instrs.append(x64_emit_label(txn.name + "_check"));
    instrs = instrs.append(x64_emit_comment("Check: " + txn.name));
    
    // Simplified: just return for now
    instrs = instrs.append(x64_emit_ret());
    
    term instrs;
}

defn generate_x86_64(program: Program, cg: CallGraphResult) -> List<u8> {
    let all_instrs: List<X64Instr> = [];
    
    // Emit acyclicity annotation in comment instrs
    when !cg.has_cycle {
        all_instrs = all_instrs.append(X64Instr.Comment("Call graph: acyclic -- static dispatch".to_string()));
    };
    when cg.has_cycle {
        all_instrs = all_instrs.append(X64Instr.Comment("Call graph: cyclic -- dynamic dispatch".to_string()));
    };
    
    // Extract transactions
    let txns: List<Transaction> = [];
    let i: Int = 0;
    when i < program.items.len() {
        uni program.items[i](TopTxn(txn)) = {
            txns = txns.append(txn);
        };
        i = i + 1;
    };
    
    // Generate reactor
    let reactor_instrs = x64_generate_reactor(txns);
    all_instrs = all_instrs.append_all(reactor_instrs);
    
    // Generate transaction checks
    let j: Int = 0;
    when j < txns.len() {
        let txn_instrs = x64_generate_transaction_check(txns[j]);
        all_instrs = all_instrs.append_all(txn_instrs);
        j = j + 1;
    };
    
    // Emit binary
    term x64_emit_binary(all_instrs);
}
