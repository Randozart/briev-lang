// csharp/glue.dbvl — GLUE adapter for the csharp target (Data Briev).
// 2026-08-04 (plan 2026-08-04-ship-common-language-environments): C# P/Invoke
// bindings. `briev bindings <bridge> csharp` renders a .cs class with DllImport
// externs against the bridge .so; the composite String is an IntPtr handle.

csharp: { types_module: "glue/csharp/types.bv"; extension: "cs"; bridge_kind: "extern_c_crate"; calling_convention: "c_abi"; module_init: false; protocols: { "Bool": { native: "bool"; c_abi: "sbyte" }; "Char": { native: "char"; c_abi: "int" }; "Data": { native: "byte[]"; c_abi: "IntPtr" }; "Float": { native: "double"; c_abi: "double" }; "Int": { native: "long"; c_abi: "long" }; "String": { native: "string"; c_abi: "IntPtr" } }; conversions: { to_abi: { "Int": "{name}"; "Float": "{name}"; "String": "{name}" }; from_abi: { "Int": "result_abi"; "Float": "result_abi"; "String": "result_abi" } }; state: { decl: "IntPtr state"; arg: "state"; ffi_type: "" }; param_decl: "{type} {name}" };

csharp.bindings.bridge.cs: "// GLUE bridge for {{bridge_name}} — auto-generated (do not edit).\nusing System;\nusing System.Runtime.InteropServices;\n\npublic static class {{bridge_name}} {\n    [DllImport(\"{{bridge_name}}\")]\n    private static extern IntPtr __briev_init_state();\n\n    public static IntPtr Init() { return __briev_init_state(); }\n\n{{ffi_decls}}\n}\n";
csharp.bindings.ffi_template: "    [DllImport(\"{{bridge_name}}\")]\n    private static extern {{c_return}} {{name}}({{s_ffi_param}}{{ffi_params}});\n";
