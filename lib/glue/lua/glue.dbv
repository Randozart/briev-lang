lua: { types_module: "glue/lua/types.bv"; extension: "lua"; bridge_kind: "native_module"; calling_convention: "c_abi"; module_init: true; protocols: { "Bool": { native: "boolean"; c_abi: "long long" }; "Char": { native: "string"; c_abi: "long long" }; "Data": { native: "string"; c_abi: "long long" }; "Float": { native: "number"; c_abi: "double" }; "Int": { native: "integer"; c_abi: "long long" }; "String": { native: "string"; c_abi: "long long" } }; conversions: { to_abi: { "Int": "{name}"; "Float": "{name}"; "String": "{name}" }; from_abi: { "Int": "result_abi"; "Float": "result_abi"; "String": "result_abi" } }; state: { decl: ""; arg: "state"; ffi_type: "" }; param_decl: "{name} {type}"; native_include_cmd: "for L in ~/briev-tools/lua-*/src /usr/include/lua5.4 /usr/include; do [ -f \"$L/lua.h\" ] && echo \"-I$L\" && break; done"; native_suffix: ".so" };

lua.templates.0: "native.module" "#include <lua.h>\n#include <lauxlib.h>\n#include <stdint.h>\n\ntypedef struct BrievState BrievState;\nextern BrievState* __briev_init_state(void);\nextern void __glue_release(BrievState* state);\n\n{{export_protos}}\n\nstatic BrievState* g_state = NULL;\n\n{{methods}}\n\nint luaopen_{{bridge_name}}(lua_State* L) {\n    g_state = __briev_init_state();\n    luaL_Reg reg[] = {\n{{method_defs}}\n        {NULL, NULL}\n    };\n    luaL_newlib(L, reg);\n    return 1;\n}\n";
lua.templates.1: "native.method" "static int lua_{{name}}(lua_State* L) {\n    int _i = 1;\n{{parse_code}}\n    {{ret_c}} r = {{call}};\n{{build_code}}\n}\n";
lua.templates.2: "native.method_def" "        {\"{{name}}\", lua_{{name}}},\n";
lua.templates.3: "native.parse.Int" "    long long {{name}} = luaL_checkinteger(L, _i++);";
lua.templates.4: "native.build.Int" "    lua_pushinteger(L, r);\n    return 1;";
lua.templates.5: "native.c_type.Int" "long long";
lua.templates.6: "native.ret.Int" "long long";
lua.templates.7: "native.parse.Float" "    double {{name}} = luaL_checknumber(L, _i++);";
lua.templates.8: "native.build.Float" "    lua_pushnumber(L, r);\n    return 1;";
lua.templates.9: "native.c_type.Float" "double";
lua.templates.10: "native.ret.Float" "double";
lua.templates.11: "native.parse.String" "    const char* {{name}} = luaL_checkstring(L, _i++);";
lua.templates.12: "native.build.String" "    lua_pushstring(L, (const char*)r);\n    return 1;";
lua.templates.13: "native.c_type.String" "long long";
lua.templates.14: "native.ret.String" "long long";
