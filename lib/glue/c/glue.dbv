// c/glue.dbvl — GLUE adapter for the c target (Data Briev).
// 2026-08-03 (plan 2026-08-03-glue-folders-node-bridge): per-language glue
// config, referenced as config by `briev export|bindings|extension <bridge>
// c` — the compiler finds lib/glue/c/ BY NAME and loads this file.
// Format (quoted mode):
//   c: { types_module; extension; bridge_kind; calling_convention;
//            module_init; protocols: { "#Cat": { native; c_abi; }; }; };
//   c.templates.<n>: "<output path>" "template text with \n escapes";
// Template variables: {{bridge_name}} {{name}} {{params}} {{ffi_params}}
//   {{c_types}} {{args}} {{args_abi}} {{return}} {{c_return}}
//   {{return_expr}} {{s_param}} {{s_init}} {{exports}} {{ffi_decls}}
// Special template keys: "fn_template", "ffi_template"

c: { types_module: "glue/c/types.bv"; extension: "h"; bridge_kind: "extern_c_crate"; calling_convention: "lto"; module_init: false; protocols: { "String": { native: "int64_t"; c_abi: "int64_t" }; "Int": { native: "int64_t"; c_abi: "int64_t" }; "Float": { native: "double"; c_abi: "double" }; "Bool": { native: "int8_t"; c_abi: "int8_t" }; "Data": { native: "int64_t"; c_abi: "int64_t" }; "Char": { native: "int32_t"; c_abi: "int32_t" } }; conversions: { to_abi: { "Int": "{name}"; "Float": "{name}"; "String": "{name}"; "Bool": "{name}"; "Data": "{name}"; "Char": "{name}" }; from_abi: { "Int": "result_abi"; "Float": "result_abi"; "String": "result_abi"; "Bool": "result_abi"; "Data": "result_abi"; "Char": "result_abi" } }; state: { decl: "BrievState* state"; arg: "state"; ffi_type: "" }; param_decl: "{type} {name}"; fn_param_decl: "{ret} (*{name})({params})" };
c.bindings.briev_types.h: "// Autogenerated by Briev Compiler — do not edit manually\n#pragma once\n#include <stdint.h>\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\ntypedef struct BrievState BrievState;\nextern BrievState* __briev_init_state(void);\nextern void __glue_release(BrievState* state);\nextern void __briev_set_cancel(BrievState* state, int32_t flag);\nextern void __briev_clear_cancel(BrievState* state);\n\n{{ffi_decls}}\n\n#ifdef __cplusplus\n}\n#endif\n";
c.bindings.ffi_template: "{{c_return}} {{name}}({{s_ffi_param}}{{ffi_params}});";
