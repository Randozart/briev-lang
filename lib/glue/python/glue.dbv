// python/glue.dbvl — GLUE adapter for the python target (Data Briev).
// 2026-08-03 (plan 2026-08-03-glue-folders-node-bridge): per-language glue
// config, referenced as config by `briev export|bindings|extension <bridge>
// python` — the compiler finds lib/glue/python/ BY NAME and loads this file.
// Format (quoted mode):
//   python: { types_module; extension; bridge_kind; calling_convention;
//            module_init; protocols: { "#Cat": { native; c_abi; }; }; };
//   python.templates.<n>: "<output path>" "template text with \n escapes";
// Template variables: {{bridge_name}} {{name}} {{params}} {{ffi_params}}
//   {{c_types}} {{args}} {{args_abi}} {{return}} {{c_return}}
//   {{return_expr}} {{s_param}} {{s_init}} {{exports}} {{ffi_decls}}
// Special template keys: "fn_template", "ffi_template"

python: { types_module: "glue/python/types.bv"; extension: "so"; bridge_kind: "native_module"; calling_convention: "c_abi"; module_init: true; protocols: { "Bool": { native: "bool"; c_abi: "ctypes.c_bool" }; "Char": { native: "str"; c_abi: "ctypes.c_char" }; "Data": { native: "bytes"; c_abi: "ctypes.c_void_p" }; "Float": { native: "float"; c_abi: "ctypes.c_double" }; "Int": { native: "int"; c_abi: "ctypes.c_int64" }; "String": { native: "str"; c_abi: "ctypes.c_void_p" } } ; conversions: { to_abi: { "Int": "{name}"; "Float": "{name}"; "String": "{name}"; "Bool": "{name}"; "Data": "{name}"; "Char": "{name}" }; from_abi: { "Int": "result_abi"; "Float": "result_abi"; "String": "result_abi"; "Bool": "result_abi"; "Data": "result_abi"; "Char": "result_abi" } } ; state: { decl: ""; arg: "_STATE"; ffi_type: "ctypes.c_void_p" }; param_decl: "{name}: {type}"; native_include_cmd: "python3-config --includes"; native_suffix_cmd: "python3-config --extension-suffix"; native_link_cmd: "python3-config --ldflags" };
python.templates.0: "__init__.py" "\"\"\"GLUE bridge for {{bridge_name}} — auto-generated.\"\"\"\nimport ctypes\nimport os\n\n_lib = ctypes.CDLL(os.path.join(os.path.dirname(__file__), \"bridge.so\"))\n\ndef _init_state():\n    _lib.init_state.argtypes = [ctypes.c_void_p]\n    _lib.init_state.restype = None\n    buf = ctypes.create_string_buffer(32)\n    state = ctypes.cast(ctypes.pointer(buf), ctypes.c_void_p)\n    _lib.init_state(state)\n    return state\n\n_STATE = _init_state()\n\n{{exports}}\n";
python.templates.1: "fn_template" "def {{name}}({{params}}):\n    _lib.{{name}}.argtypes = [{{s_ffi_type}}{{c_types}}]\n    _lib.{{name}}.restype = {{c_return}}\n    return _lib.{{name}}({{s_param}}{{args_abi}})\n";
python.bindings.briev_bindings.py: "\"\"\"Autogenerated by Briev Compiler — do not edit manually.\"\"\"\nimport ctypes\n\n_lib = ctypes.CDLL(\"bridge.so\")\n\nclass BrievState(ctypes.Structure):\n    pass\n\n_lib.__briev_init_state.restype = ctypes.c_void_p\n_lib.__glue_release.argtypes = [ctypes.c_void_p]\n\n{{ffi_decls}}\n";
python.bindings.ffi_template: "{{name}} = _lib.{{name}}\n{{name}}.argtypes = [{{s_ffi_type}}{{c_types}}]\n{{name}}.restype = {{c_return}}\n";
python.templates.2: "native.module" "#define PY_SSIZE_T_CLEAN\n#define Py_LIMITED_API 0x030A0000\n#include <Python.h>\n\ntypedef struct BrievState BrievState;\nextern BrievState* __briev_init_state(void);\nextern void __glue_release(BrievState* state);\n\n{{export_protos}}\n\nstatic BrievState* g_state = NULL;\n\n{{methods}}\n\nstatic PyMethodDef module_methods[] = {\n    {{method_defs}}\n    {NULL, NULL, 0, NULL}\n};\n\nstatic struct PyModuleDef module_def = {\n    PyModuleDef_HEAD_INIT, \"{{bridge_name}}\", NULL, -1, module_methods\n};\n\nPyMODINIT_FUNC PyInit_{{bridge_name}}(void) {\n    g_state = __briev_init_state();\n    return PyModule_Create(&module_def);\n}\n";
python.templates.4: "native.method_def" "    {\"{{name}}\", (PyCFunction)(void(*)(void))py_{{name}}, METH_FASTCALL, \"{{name}}\"},";
python.templates.5: "native.c_type.Int" "long long";
python.templates.7: "native.ret.Int" "long long";
python.templates.9: "native.c_type.Float" "double";
python.templates.11: "native.ret.Float" "double";
python.templates.13: "native.c_type.String" "long long";
python.templates.15: "native.ret.String" "long long";
python.templates.16: "native.method" "static PyObject* py_{{name}}(PyObject* self, PyObject* const* args, Py_ssize_t nargs) {\n    Py_ssize_t _i = 0;\n{{parse_code}}\n    {{ret_c}} r = {{call}};\n{{build_code}}\n}\n";
python.templates.17: "native.parse.Int" "    long long {{name}};\n    {{name}} = PyLong_AsLongLong(args[_i++]);\n    if ({{name}} == -1 && PyErr_Occurred()) return NULL;";
python.templates.18: "native.build.Int" "    return PyLong_FromLongLong(r);";
python.templates.21: "native.parse.Float" "    double {{name}};\n    {{name}} = PyFloat_AsDouble(args[_i++]);\n    if ({{name}} == -1.0 && PyErr_Occurred()) return NULL;";
python.templates.22: "native.build.Float" "    return PyFloat_FromDouble(r);";
python.templates.25: "native.parse.String" "    PyObject* {{name}}_obj = args[_i++];\n    long long {{name}};\n    if (!PyUnicode_Check({{name}}_obj)) { PyErr_SetString(PyExc_TypeError, \"expected str\"); return NULL; }\n    const char* {{name}}_buf = PyUnicode_AsUTF8AndSize({{name}}_obj, NULL);\n    if (!{{name}}_buf) return NULL;\n    {{name}} = (long long){{name}}_buf;";
python.templates.26: "native.build.String" "    return PyUnicode_FromString((const char*)r);";
