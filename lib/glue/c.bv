// c.bv — C-ABI boundary representations for GLUE export.
// 2026-08-03 (plan 2026-08-03-protocol-driven-glue-boundary): Briev has no
// type layouts — only adaptive protocols. An FFI boundary representation is a
// sub-protocol (`String<C_String>`, `Float<C_Double>`, …) whose CastTo/
// CastFrom bindings are the delta transforms. The casting graph finds the
// minimal path between a Briev type and its boundary representation, and
// codegen emits the delta — not a chain.
//
// Import this module (or a bridge-specific one derived from it) and declare
// the bridge's boundary contract with these types:
//   import "glue/c.bv";
//   export defn greet(name: CStr) -> CStr { ... };

// 2026-11-16 (S3/G3): the C-string protocol — its axioms and its boundary type —
// is GENERATED from lib/glue/c/glue.dbv by `brievc render c`. Edit the descriptor,
// not this file; `brievc render c --check` refuses a stale generated file.
import "glue/c/protocols.bv";

// Boundary types — the export signature IS the boundary contract. The ABI
// width and marshalling derive from each type's protocol + metadata.

type CDouble: Float<C_Double> { };

// ── List<T> ↔ C array zero-copy helpers ────────────────────────────────
// 2026-11-15 (list-ffi-zero-copy): the `coll obj` boxed handle layout is
// [data_ptr(i64, offset +0), cap(i64, offset +8), len(i64, offset +16)].
// These helpers extract the data pointer and length for C array FFI —
// zero-copy, mirrors str_to_c. C receives (ptr, len) and borrows the
// buffer for the duration of the call (lifetime proof required).
//
// NOTE: params are Int (the boxed handle word). Generic List<T> cannot
// appear in bridge/export signatures — the bridge emits concrete names.
// Callers pass the list handle directly.

// list_to_c_ptr — zero-copy: return the element data pointer of a list.
// The boxed handle's first word IS the data pointer (offset +0).
// No offset adjustment — returns the handle as-is.
defn list_to_c_ptr(handle: Int) -> Int [true][term >= 0] {
    term handle;
};

// list_len — return the element count of a list.
// Loads the hidden `len` slot at offset +16 from the boxed handle.
defn list_len(handle: Int) -> Int [true][term >= 0] {
    term Load#(handle + 16, 8);
};
