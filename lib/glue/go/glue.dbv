go: { types_module: "glue/go/types.bv"; extension: "go"; bridge_kind: "cgo_package"; calling_convention: "c_abi"; module_init: false; protocols: { "Bool": { native: "bool"; c_abi: "C.int8_t" }; "Char": { native: "rune"; c_abi: "C.int32_t" }; "Data": { native: "[]byte"; c_abi: "unsafe.Pointer" }; "Float": { native: "float64"; c_abi: "C.double" }; "Int": { native: "int64"; c_abi: "C.int64_t" }; "String": { native: "string"; c_abi: "C.int64_t" } }; conversions: { to_abi: { "Int": "C.int64_t({name})"; "Float": "C.double({name})"; "String": "C.int64_t(uintptr(unsafe.Pointer(C.CString({name}))))"; "Bool": "C.int8_t({name})"; "Data": "{name}"; "Char": "C.int32_t({name})" }; from_abi: { "Int": "int64(result_abi)"; "Float": "float64(result_abi)"; "String": "C.GoString((*C.char)(unsafe.Pointer(uintptr(result_abi))))"; "Bool": "result_abi != 0"; "Data": "result_abi"; "Char": "rune(result_abi)" } }; state: { decl: "state *C.BrievState"; arg: "state"; ffi_type: "" }; param_decl: "{name} {type}" };
go.templates.0: "bridge.go" "// GLUE bridge for {{bridge_name}} — auto-generated (do not edit).\npackage {{bridge_name}}\n\n/*\n#cgo LDFLAGS: -L${SRCDIR} -l{{bridge_name}}\n#include \"briev_types.h\"\n*/\nimport \"C\"\nimport \"unsafe\"\n\nvar _ = unsafe.Pointer(nil) // keep unsafe in scope for bridges without String params\n\nvar state *C.BrievState\n\nfunc init() {\n    state = C.__briev_init_state()\n}\n\n{{exports}}\n";
go.templates.1: "fn_template" "func {{name_upper}}({{params}}) {{return}} {\n    var result_abi {{c_return}} = C.{{name}}({{s_param}}{{args_abi}})\n    return {{return_expr}}\n}\n";
