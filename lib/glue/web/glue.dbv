// web/glue.dbvl — GLUE adapter for the web target (Data Briev).
// 2026-08-03 (plan 2026-08-03-glue-folders-node-bridge): per-language glue
// config, referenced as config by `briev export|bindings|extension <bridge>
// web` — the compiler finds lib/glue/web/ BY NAME and loads this file.
// Format (quoted mode):
//   web: { types_module; extension; bridge_kind; calling_convention;
//            module_init; protocols: { "#Cat": { native; c_abi; }; }; };
//   web.templates.<n>: "<output path>" "template text with \n escapes";
// Template variables: {{bridge_name}} {{name}} {{params}} {{ffi_params}}
//   {{c_types}} {{args}} {{args_abi}} {{return}} {{c_return}}
//   {{return_expr}} {{s_param}} {{s_init}} {{exports}} {{ffi_decls}}
// Special template keys: "fn_template", "ffi_template"

web: { types_module: "glue/web/types.bv"; extension: "mjs"; bridge_kind: "wasm_runtime"; calling_convention: "wasm_import"; module_init: false; protocols: { "Bool": { native: "boolean"; wasm_abi: "i32" }; "#CanvasContext": { native: "WebGLRenderingContext | GPUDevice"; wasm_abi: "i32" }; "#Element": { native: "Element"; wasm_abi: "i32" }; "Float": { native: "number"; wasm_abi: "f64" }; "Int": { native: "number"; wasm_abi: "i32" }; "String": { native: "string"; wasm_abi: "i32" } } ; conversions: { to_abi: { "Int": "{name}"; "Float": "{name}"; "String": "{name}"; "Bool": "{name}"; "Data": "{name}"; "Char": "{name}" }; from_abi: { "Int": "result_abi"; "Float": "result_abi"; "String": "result_abi"; "Bool": "result_abi"; "Data": "result_abi"; "Char": "result_abi" } }; state: { decl: ""; arg: ""; ffi_type: "" }; param_decl: "{name}: {type}" };
web.templates.0: "dom-shim.mjs" "// dom-shim.mjs — Auto-generated GLUE web runtime for {{bridge_name}}\n// Reads WASM linear memory at known state offsets. Called by the WASM module\n// via __web_flush_state import at each transaction commit point.\n\nexport class WasmDomRuntime {\n  constructor(wasmBytes) {\n    this._handles = [null];\n    this._bindingTable = [];\n    this._init(wasmBytes);\n  }\n\n  async _init(wasmBytes) {\n    const wasm = await WebAssembly.instantiate(wasmBytes, {\n      env: this._buildImports(),\n    });\n    this._instance = wasm.instance;\n    this._memory = wasm.instance.exports.memory;\n    this._loadStateLayout();\n  }\n\n  _buildImports() {\n    return {\n      __web_flush_state: (updatesPtr, count) => {\n        this._applyFlush(updatesPtr, count);\n      },\n    };\n  }\n\n  _loadStateLayout() {\n    const layoutPtr = this._instance.exports.state_layout();\n    const mem = new DataView(this._memory.buffer);\n    // ... layout table read at runtime ...\n  }\n\n  _applyFlush(updatesPtr, count) {\n    const mem = new DataView(this._memory.buffer);\n    let off = updatesPtr;\n    for (let i = 0; i < count; i++) {\n      const handle = mem.getUint32(off, true); off += 4;\n      const valPtr = mem.getUint32(off, true); off += 4;\n      const valLen = mem.getUint32(off, true); off += 4;\n      const binding = this._bindingTable[handle];\n      if (binding) {\n        const value = valLen > 0\n          ? new TextDecoder().decode(new Uint8Array(this._memory.buffer, valPtr, valLen))\n          : null;\n        binding.applyFn(value);\n      }\n    }\n  }\n}\n\nexport async function createApp(wasmBytes) {\n  const runtime = new WasmDomRuntime(wasmBytes);\n  return runtime._instance.exports;\n}\n";
