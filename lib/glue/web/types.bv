// 2026-07-26: Web/WASM type declarations for Briev's type universe.
// Types are defined against the #Web protocol hashword so GLUE can
// route frgn declarations through the wasm_runtime bridge target.
//
// #Web protocol types are opaque i32 handles in WASM linear memory,
// backed by native JS objects in the runtime's handle table.
// The compiler resolves `from #Web` to the GLUE `[web]` target config.

type Element: #Web {
    // Opaque handle — i32 in WASM, HTMLElement in JS.
    // No CastTo/CastFrom to Bits — Element cannot be constructed from
    // raw bytes; it's created via frgn from #Web (create_element, etc.)
    spec MaxBits: 32;
    spec Alignment: 4;
};

type CanvasContext: #Web {
    // Opaque handle — i32 in WASM, WebGLRenderingContext or GPUDevice in JS.
    // Passed from JS to WASM during initialization handoff via frgn from #Web.
    spec MaxBits: 32;
    spec Alignment: 4;
};
