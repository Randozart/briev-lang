// pp-types.bv — Bridge test fixture for GLUE export round-trip
// 2026-08-03: Restored as the round-trip TEST FIXTURE (kept separate from
// the benchmark workload per plan 2026-08-03-host-callable-glue-export).
// Exports pure functions that take/return C string pointers as Int, so the
// round-trip tests (tests/pp_roundtrip_tests.rs) call them via the C ABI
// without native Briev string construction.

import "pp/types.bv";
import "glue/c.bv";

export defn briev_test_cstr_roundtrip(input_ptr: Int) -> Int {
    let s: String = cstr_to_briev(input_ptr);
    term str_to_c(s);
};

export defn briev_test_custom_echo(input_ptr: Int) -> Int {
    let s: String = cstr_to_briev(input_ptr);
    let r: String = pp_type_custom(s);
    term str_to_c(r);
};

export defn briev_test_bits_static() -> Int {
    let r: String = "Bits(42): test";
    term str_to_c(r);
};

export defn briev_test_type_bits(input_ptr: Int) -> Int {
    let s: String = cstr_to_briev(input_ptr);
    let r: String = pp_type_bits(s);
    term str_to_c(r);
};

export defn briev_test_type_void() -> Int {
    let r: String = pp_type_void();
    term str_to_c(r);
};
