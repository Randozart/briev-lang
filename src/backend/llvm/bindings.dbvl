// Intrinsic bindings for the LLVM backend
// Format: intrinsic_name -> LLVM IR template
// %0, %1, ... refer to arguments by index

AddI64#    -> add nsw i64 %0, %1
SubI64#    -> sub nsw i64 %0, %1
MulI64#    -> mul nsw i64 %0, %1
DivI64#    -> sdiv i64 %0, %1
RemI64#    -> srem i64 %0, %1
EqI64#     -> icmp eq i64 %0, %1
LtI64#     -> icmp slt i64 %0, %1
FAddF64#   -> fadd double %0, %1
FSubF64#   -> fsub double %0, %1
FMulF64#   -> fmul double %0, %1
FDivF64#   -> fdiv double %0, %1
Sqrt#      -> call double @llvm.sqrt.f64(double %0)
// 2026-08-01 (audit): Print#/PrintChar# removed — the generic Print#
// convenience intrinsic emits the __print_int/__print_str/__print_float/
// __print_char/__print_bool family directly (protocol-category dispatch), not
// printf. 2026-09-08 (anti-pattern audit): the C symbols now resolve through
// the frgn_map (lib/std/ffi/io.bv declares frgn__print_* → __print_*); the
// --no-stdlib fallback keeps the intrinsic's own C symbol. See
// src/backend/llvm/intrinsics.rs.
Malloc#    -> call ptr @malloc(i64 %0)
Free#      -> call void @free(ptr %0)
Memcpy#    -> call ptr @memcpy(ptr %0, ptr %1, i64 %2)
Memset#    -> call ptr @memset(ptr %0, i64 %1, i64 %2)
GetEnvInt# -> call i64 @getenv_as_i64(ptr %0)
FloatToInt# -> fptosi double %0 to i64
IntToFloat# -> sitofp i64 %0 to double
