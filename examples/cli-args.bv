// CLI argv demo — Increment 2 of docs/plans/2026-10-12-daily-driver-quick-wins.md.
//
// The revived std/cli.bv argv layer + the entry-plugin surface:
//   entry!("cmd")  — node fires only when argv's first non-flag token is cmd
//   args!("--f")   — Bool: was the flag present? (typed snapshot field)
//   args!("--f", T) — T-valued: String value, or Int/Float via arg_int/arg_float
//
// Run:
//   brievc build examples/cli-args.bv --llvm --out /tmp/cli --stdlib-path lib/std
//   clang -O3 -flto -march=native /tmp/cli/cli-args.ll lib/runtime/briev_rt.c -o /tmp/cli/cli-args
//   /tmp/cli/cli-args demo --verbose --name world --repeats 3
//   /tmp/cli/cli-args          → usage

import "std/cli.bv";

let n: Int = 0;

node demo [entry!("demo")][n == 1] {
    when args!("--verbose") {
        println!("verbose");
    };
    let name: String = args!("--name", String);
    println!("hello, ");
    println!(name);
    println!(arg_int("--repeats"));
    n = 1;
    term;
};

node usage [entry_cmd() == "" && n == 0][true] {
    println!("usage: cli-args demo [--verbose] [--name <s>] [--repeats <n>]");
    n = 1;
    term;
};
