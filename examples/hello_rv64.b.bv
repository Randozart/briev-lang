// Minimal QEMU virt rv64 UART hello — writes directly to NS16550A.
// UART0 base: 0x10000000, THR: +0x00
//
// Idiomatic Briev: foreach on String iterates Char, Char as Int gives the
// byte value, VolatileStore# writes to UART. Defn-liveness emission keeps
// only the reachable chain (entry -> uart_write -> briev_str_next_char ->
// byte_raw/decode_*) — links -nostdlib with no LTO.
//
// Boot: brievc build examples/hello_rv64.b.bv \
//         --triple riscv64-unknown-none \
//         --linker-script lib/targets/qemu-virt-rv64.ld
//       qemu-system-riscv64 -machine virt -bios none -nographic \
//         -kernel examples/hello_rv64.b

defn uart_write(addr: Ptr<Int>, s: String) {
    foreach c in s {
        VolatileStore#(addr, c as Int);
    };
};

node entry [beginprogram][true] {
    uart_write(0x10000000 as Ptr<Int>, "briev\n");
    halt;
};
