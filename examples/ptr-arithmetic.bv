// ptr-arithmetic: Ptr<T> type — typed memory addresses with contract safety
//
// Demonstrates (SPEC §14.2 surface — &value, *ptr, casts, contracts; Briev
// has no implicit pointer arithmetic, address math goes through `as Int`):
//   1. Ptr<T> as a first-class typed memory address
//   2. Explicit as casts between Ptr<T> and Int
//   3. Address arithmetic on the raw Int, reinterpreted via cast
//   4. Contract integration: [reg_addr >= BASE][reg_addr < END]
//   5. Load# / Store# for volatile MMIO access
//
// 2026-08-22 (spec-conformance Phase 1b): migrated off if/else (SPEC §11.1),
// off the removed volatile_load#/volatile_store# names to Load#/Store#, and
// off non-normative direct Ptr±Int operators to explicit cast-based math.

const UART0_BASE: Int = 0x40011000;
const UART0_END:  Int = 0x40011010;
const UART_RX:    Ptr<Int> = 0x40011000 as Ptr<Int>;

// Address arithmetic on raw addresses, reinterpreted as typed pointers.
let uart_rx: Ptr<Int> = UART_RX;
let uart_tx: Ptr<Int> = (UART_RX as Int + 4) as Ptr<Int>;
let base:    Ptr<Int> = (uart_tx as Int - 4) as Ptr<Int>;
let masked:  Ptr<Int> = (UART_RX as Int & 0xFFFF0000) as Ptr<Int>;
let shifted: Ptr<Int> = ((UART_RX as Int) << 2) as Ptr<Int>;

// Cast: Ptr → Int (extract raw address)
let raw_addr: Int = uart_rx as Int;

// Cast: Int → Ptr (reinterpret address as typed pointer)
let re_ptr: Ptr<Int> = raw_addr as Ptr<Int>;

// Comparison of same-typed pointers
let same: Bool = uart_rx == uart_tx;
let lower: Bool = uart_rx < uart_tx;

// Contract-proven pointer safety
defn read_uart(reg_addr: Ptr<Int>) -> Int
{
    term Load#(reg_addr);
};

defn write_uart(reg_addr: Ptr<Int>, val: Int)
{
    Store#(reg_addr, val);
};

// Load# / Store# usage
defn demo_mmio(addr: Ptr<Int>) -> Int
    [addr as Int >= UART0_BASE]
    [addr as Int <  UART0_END]
{
    let old: Int = Load#(addr);
    Store#(addr, 42);
    // In real usage: read-modify-write on a hardware register
    term old;
};

// Verify the store path runs and reads land back at zero-initialized state
let read_val: Int = 0;
let tick: Int = 0;

node run [tick < 1][tick == 1] {
    when tick == 0 {
        let result: Int = 0;

        // uart_tx should be UART0_BASE + 4
        when uart_tx as Int == UART0_BASE + 4 {
            result = result + 1;
        };

        // Read with safety contract
        let _val: Int = read_uart(uart_rx);

        // Cast round-trip
        let rt: Int = (0x40000000 as Ptr<Int>) as Int;
        when rt == 0x40000000 {
            result = result + 1;
        };

        // Volatile round-trip through the register window
        Store#(uart_rx, 42);
        read_val = Load#(uart_tx);

        endprogram Print#(result);
    };
    when tick != 0 {
        tick = tick + 1;
        term;
    };
};

// Compile:   ./target/release/brievc build examples/ptr-arithmetic.bv
// Expected:  prints "2"
