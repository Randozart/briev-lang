// SPEC §18.4 — `$txn`: the compile-time convergent loop (2026-09-22). The
// body repeats until `[post]` holds — the iteration count is UNKNOWN at the
// call site, decided by the computation (the one compile-time loop a
// `foreach` cannot express). Declares at TOP LEVEL only (no inline
// declaration); inline INVOCATION from a $(Stage) block is the call path.

$txn scale(x: Int) [x < 16][x >= 16] {
    x = x * 2;
};

$txn bootstrap_addr(base: Int) [base < 0x1000][base >= 0x1000] {
    base = base + 0x400;
    term base;
};

$(Typed) {
    let scaled: Int = scale(1);
    let addr: Int = bootstrap_addr(0);
    check scaled == 16;
    check addr == 0x1000;
};

let i: Int = 0;
async node txn_user [i < 1][i == 1] {
    i = i + 1;
    term;
};