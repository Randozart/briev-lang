// SPEC §17 + §18 — compile-time reflection in composite conditions.
// `.^^Size` folds to the declared element count of a state array; `.^^Element`
// folds to the element category code. A `$defn` composite may gate a `match`
// on a receiver's SHAPE, and expansion splices only the taken arm — the
// composite specializes per-shape at compile time, not at runtime.

$defn classify(buf: Expr, target: Expr) {
    match buf.^^Size {
        4 => target = 4;
        8 => target = 8;
        _ => target = 0;
    }
};

let i: Int = 0;
let buf4: Float[4];
let buf8: Float[8];
let tag: Int;
async node reflect_fold_user [i < 1][i == 1] {
    classify!(buf4, tag);
    classify!(buf8, tag);
    i = i + 1;
    term;
};
