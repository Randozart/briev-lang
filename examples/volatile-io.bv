// volatile-io: MMIO-style I/O using Load# / Store# intrinsics
//
// Demonstrates:
//   1. Memory-mapped I/O with type-safe Ptr<Bit<8>>
//   2. Contract-proven address bounds for MMIO safety
//   3. Read-modify-write on control registers
// 2026-08-23: migrated off removed volatile_load#/volatile_store# names
// to Load#/Store#, and off while-loops (no while keyword) to reactive
// node polling.

import "std/types";

const UART_BASE: Int = 0x40011000;
const UART_END:  Int = 0x40011018;

// UART register offsets (in bytes)
const UART_SR:   Ptr<Bit<8>> = (UART_BASE + 0x01) as Ptr<Bit<8>>;
const UART_DR:   Ptr<Bit<8>> = UART_BASE as Ptr<Bit<8>>;
const UART_CR1:  Ptr<Bit<8>> = (UART_BASE + 0x0C) as Ptr<Bit<8>>;

// Status register bits
const SR_TXE: Int = 0x20;  // Transmit data register empty
const SR_RXNE: Int = 0x10; // Read data register not empty

// Contract helper: check that a register address lies within a peripheral range
defn in_range(reg_addr: Ptr<Bit<8>>, base: Int, end: Int) -> Bool {
    term (reg_addr as Int) >= base && (reg_addr as Int) < end;
};

// Send a character via UART
// Contract-proven address bounds for MMIO safety.
defn uart_send(c: Int) -> Bool
{
    Store#(UART_DR, c);
    term true;
};

// Receive a character via UART
defn uart_recv() -> Int
    [in_range(UART_SR, UART_BASE, UART_END)]
{
    term Load#(UART_SR);
};

// Configure UART control register (set baud rate divisor)
defn uart_set_baud(divisor: Int) -> Bool
{
    Store#(UART_CR1, divisor);
    term true;
};

// Read-modify-write: set a bit in a control register
defn set_bit(reg_addr: Ptr<Bit<8>>, bit: Int) -> Bool
{
    let old: Int = Load#(reg_addr);
    Store#(reg_addr, old | bit);
    term true;
};

// Read-modify-write: clear a bit in a control register
defn clear_bit(reg_addr: Ptr<Bit<8>>, bit: Int) -> Bool
{
    let old: Int = Load#(reg_addr);
    Store#(reg_addr, old & !bit);
    term true;
};

let status: Int = 0;
let i: Int = 0;

node demo [i < 2][i == 2] {
    when i == 0 {
        uart_set_baud(26);
        uart_send(72); // 'H'
        i = i + 1;
        term;
    };
    when i == 1 {
        let sr = Load#(UART_SR);
        status = sr;
        set_bit(UART_CR1, 0x01);
        clear_bit(UART_CR1, 0x02);
        endprogram Print#(status);
    };
};
