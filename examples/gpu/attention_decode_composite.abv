// attention_decode_composite.abv — the composite form of the M2b decode
// attention composition (plan 2026-09-20-metaprogrammed-composites, Front
// B/C). ONE node: the whole softmax+pv structure is a declared composite
// call (softmax_fused! from lib/std/numeric.bv) whose score reads q/k
// directly — no score buffer, no producer node, one dispatch per firing.
// The shape lives in the language; the compiler expands, proves (M2
// deferral), and lowers. o1 is the accumulator scratch (H*NKV >= H*D).
import "std/numeric.bv";

const D: Int = 128;
const H: Int = 32;
const HKV: Int = 8;
const G: Int = 4;
const NKV: Int = 256;
const SCALE: Float = 0.08838834764831845;

let r: Int = 0;
let q: Float[4096];
let k: Float[262144];
let v: Float[262144];
let o1: Float[8192];
let a_out: Float[4096];

async node fattn [r < H][r == H] {
    let kh: Int = r / G;
    softmax_fused!(
        q[r * D + d] * (k[kh * (D * NKV) + j * D + d] as Float) * SCALE,
        v[kh * (D * NKV) + j * D + d] as Float,
        NKV, D,
        o1, a_out,
        r * D, r * D
    );
    r = r + 1;
    term;
};
