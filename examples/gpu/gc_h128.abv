import "std/types/float.bv";
import "std/numeric.bv";
const M: Int = 128;
const N: Int = 128;
const K: Int = 128;
let i: Int = 0;
let a: Float16[16384];
let b: Float16[16384];
let y: Float16[16384];
async node gemm [i < M * N][i == M * N] {
    matmul!(a, b, y, M, N, K, i, Float16);
    i = i + 1;
    term;
};
