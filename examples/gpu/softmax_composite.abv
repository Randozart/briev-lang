// softmax_composite.abv — Front B Lane 2 gate (plan
// 2026-09-20-metaprogrammed-composites): softmax_fused! invoked DIRECTLY
// from an .abv. The expansion machinery substitutes the parameters before
// typecheck; the M2 proof fires on the expanded body; the deferred-region
// lowering lowers it. One work item per head; one KV group.
import "std/numeric.bv";

const D: Int = 128;
const H: Int = 8;
const NKV: Int = 256;

let h: Int = 0;
let q: Float[1024];
let k: Float[262144];
let v: Float[262144];
let acc: Float[1024];
let a_out: Float[1024];

async node sfused [h < H][h == H] {
    softmax_fused!(
        q[h * D + d] * k[h * (D * NKV) + j * D + d],
        v[h * (D * NKV) + j * D + d],
        NKV, D,
        acc, a_out,
        h * D, h * D
    );
    h = h + 1;
    term;
};
