// attn_decode_h.abv — the gpu_schedule attention-decode at f16 (the tensor
// mma path): qk (GEMM S=Q*K^T) -> scale (S2=S*C) -> pv (GEMM O=S2*V), gated
// by the node DAG and FUSED (Phase 4a): the scale folds into qk's epilogue,
// so the chain runs in TWO tensor kernels. o = (Q*K^T)*C*V.
import "std/types/float.bv";
import "std/numeric.bv";
const M: Int = 128;
const N: Int = 128;
const K: Int = 128;
const SCALE: Float16 = 1.0;

let i: Int = 0;
let j: Int = 0;
let l: Int = 0;
let q: Float16[16384];
let kt: Float16[16384];
let s: Float16[16384];
let s2: Float16[16384];
let v: Float16[16384];
let o: Float16[16384];

async node qk [i < M * N][i == M * N] {
    matmul!(q, kt, s, M, N, K, i, Float16);
    i = i + 1;
    term;
};

async node scale [j < M * N][j == M * N] {
    s2[j] = s[j] * SCALE;
    j = j + 1;
    term;
};

async node pv [l < M * N][l == M * N] {
    matmul!(s2, v, o, M, N, K, l, Float16);
    l = l + 1;
    term;
};