// P1 probe (plan 2026-09-18-fused-f16-decode-node): the fused decode shape —
// serial outer loop over KV, inner foreach-reduction, sequential semantics.
// Defaults to bitnet-real geometry so the serial form can be TIMED against
// the 3-kernel composition (probe commitment: correctness proven in
// 12a45506, this file is the perf measurement vehicle).
import "std/types/float.bv";

const D: Int = 128;
const H: Int = 20;
const NKV: Int = 4096;
const SCALE: Float = 0.08838834764831845;

let w: Int = 0;
let q: Float[2560];
let k: Float[2621440];
let o: Float[20];

async node fused [w < H][w == H] {
    let acc: Float = 0;
    foreach j in 0..NKV {
        let p: Float = 0;
        foreach d in 0..D {
            p = p + q[w * D + d] * (k[j * D + d] as Float);
        }
        acc = acc + p * SCALE;
    }
    o[w] = acc;
    w = w + 1;
    term;
};
