import "std/types/float.bv";
const M: Int = 128;
const N: Int = 128;
const K: Int = 128;
let i: Int = 0;
let j: Int = 0;
let a: Float16[16384];
let b: Float16[16384];
let c: Float16[16384];
let e: Float16[16384];
let d: Float16[16384];
async node gemm1 [i < M * N][i == M * N] {
    let acc: Float16 = 0.0;
    let m: Int = i / N;
    let n: Int = i % N;
    foreach k in 0..K {
        acc = acc + a[m * K + k] * b[k * N + n];
    }
    c[i] = acc;
    i = i + 1;
    term;
};
async node gemm2 [j < M * N][j == M * N] {
    let acc: Float16 = 0.0;
    let m: Int = j / N;
    let n: Int = j % N;
    foreach k in 0..K {
        acc = acc + c[m * K + k] * e[k * N + n];
    }
    d[j] = acc;
    j = j + 1;
    term;
};
