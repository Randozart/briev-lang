import "std/types/float.bv";
import "std/numeric.bv";
const M: Int = 128;
const N: Int = 128;
const K: Int = 128;
let i: Int = 0;
let j: Int = 0;
let a: Float16[16384];
let b: Float16[16384];
let c: Float16[16384];
let e: Float16[16384];
let d: Float16[16384];
async node gemm1 [i < M * N][i == M * N] {
    matmul!(a, b, c, M, N, K, i, Float16);
    i = i + 1;
    term;
};
async node gemm2 [j < M * N][j == M * N] {
    matmul!(c, e, d, M, N, K, j, Float16);
    j = j + 1;
    term;
};
