// gemm_h.abv - 4096³ GEMM with Float16 operands: the typed tensor-core path
// (plan 2026-09-01-m2-tensor-cores + float16-float-join-and-purge). Float16
// fields lower to cooperative-matrix fragments (fp16 in, fp32 accumulate)
// when the device exposes VK_KHR_cooperative_matrix and the spirv_coopmat
// knob is on.
import "std/types/float.bv";
import "std/numeric.bv";

const M: Int = 4096;
const N: Int = 4096;
const K: Int = 512;
const MK: Int = 4096 * 512;
const MN: Int = 4096 * 4096;

let i: Int = 0;
let a: Float16[MK];
let b: Float16[MK];
let y: Float16[MN];

async node gemm [i < M * N][i == M * N] {
    matmul!(a, b, y, M, N, K, i, Float16);
    i = i + 1;
    term;
};
