import "std/types/float.bv";

// gemm_chain.abv — the gpu_schedule Phase 0 gate: two GEMM nodes chained
// through an ARRAY dependency (gemm1's `c` feeds gemm2's A). This is
// impossible with the historical per-kernel device buffers (gemm2's buffer
// would hold a stale seeded `c`); with the program-shared device state
// (2026-09-14) gemm1's `c` persists on-device for gemm2.
//
// d = (A·B)·E  — the reference is the composed CPU GEMM.
// The `phase` scalar is the reactor's ordering edge (the pattern the
// scheduler's DAG will later prove automatically).
const M: Int = 128;
const N: Int = 128;
const K: Int = 128;

let i: Int = 0;
let j: Int = 0;
let phase: Int = 0;
let a: Float16[16384];
let b: Float16[16384];
let c: Float16[16384];
let e: Float16[16384];
let d: Float16[16384];

async node gemm1 [phase == 0 && i < M * N][i == M * N] {
    let acc: Float16 = 0.0;
    let m: Int = i / N;
    let n: Int = i % N;
    foreach k in 0..K {
        acc = acc + a[m * K + k] * b[k * N + n];
    }
    c[i] = acc;
    i = i + 1;
    term;
};

async node gemm1_done [phase == 0 && i == M * N][phase == 1] {
    phase = 1;
    term;
};

async node gemm2 [phase == 1 && j < M * N][j == M * N] {
    let acc: Float16 = 0.0;
    let m: Int = j / N;
    let n: Int = j % N;
    foreach k in 0..K {
        acc = acc + c[m * K + k] * e[k * N + n];
    }
    d[j] = acc;
    j = j + 1;
    term;
};