// gemm_small.abv - 64x64x64 GEMM for exact device verification (plan
// 2026-09-01-m2-gemm M2.0).
import "std/numeric.bv";
const M: Int = 64;
const N: Int = 64;
const K: Int = 64;

let i: Int = 0;
let a: Float[4096];
let b: Float[4096];
let y: Float[4096];

async node gemm [i < M * N][i == M * N] {
    matmul!(a, b, y, M, N, K, i, Float);
    i = i + 1;
    term;
};
