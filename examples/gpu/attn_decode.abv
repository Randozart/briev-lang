// attn_decode.abv — the gpu_schedule standing benchmark: an attention-decode
// shape as a 3-node chain, gated by the node DAG (no phase scalars):
//
//   qk:    s[i]   = sum_k q[m][k] * kt[k][n]   (S = Q*K^T)
//   scale: s2[j]  = s[j] * SCALE               (the row-op between GEMMs)
//   pv:    o[l]   = sum_k s2[m][k] * v[k][n]   (O = S*V)
//
// o = (Q*K^T)*SCALE*V. f32 throughout (the general elementwise emitter's
// current surface); the DAG orders qk -> scale -> pv regardless of
// declaration order.
import "std/types/float.bv";
const M: Int = 128;
const N: Int = 128;
const K: Int = 128;
const SCALE: Float = 0.5;

let i: Int = 0;
let j: Int = 0;
let l: Int = 0;
let q: Float[16384];
let kt: Float[16384];
let s: Float[16384];
let s2: Float[16384];
let v: Float[16384];
let o: Float[16384];

async node qk [i < M * N][i == M * N] {
    let acc: Float = 0.0;
    let m: Int = i / N;
    let n: Int = i % N;
    foreach k in 0..K {
        acc = acc + q[m * K + k] * kt[k * N + n];
    }
    s[i] = acc;
    i = i + 1;
    term;
};

async node scale [j < M * N][j == M * N] {
    s2[j] = s[j] * SCALE;
    j = j + 1;
    term;
};

async node pv [l < M * N][l == M * N] {
    let acc: Float = 0.0;
    let m: Int = l / N;
    let n: Int = l % N;
    foreach k in 0..K {
        acc = acc + s2[m * K + k] * v[k * N + n];
    }
    o[l] = acc;
    l = l + 1;
    term;
};