import "glue/c.bv";

export defn echo(name: CStr) -> CStr {
    term name;
};

// The CStr <-> String adaptation uses EXPLICIT protocol casts
// (cstr_to_briev / str_to_c from glue/c.bv) — the meld implicit admission was
// removed (SPEC 19.6).
export defn greet(name: CStr) -> CStr {
    let s: String = name as String;
    term str_to_c(s) as CStr;
};

export defn identity(x: CDouble) -> CDouble {
    term x;
};

// CStr + CStr → cstring_concat (the C_String variant's own concat).
export defn join(a: CStr, b: CStr) -> CStr {
    let sa: String = a as String;
    let sb: String = b as String;
    term cstring_concat(str_to_c(sa), str_to_c(sb)) as CStr;
};
