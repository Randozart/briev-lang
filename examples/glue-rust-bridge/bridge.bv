// GLUE Rust Bridge — example Briev bridge file
//
// Inlines the minimal type definitions to avoid pulling in the prelude
// (no OS runtime — extern briev_rt.c not needed for scalar math).
// The resulting .ll is self-contained — only references LLVM builtins.
//
// Workflow:
//   briev build --disable-plugin prelude --library bridge.bv --out .  # bridge.ll
//   cargo build                                            # build.rs llc + link

// 2026-09-11 (fundamentals doctrine): Int is a parentless fundamental —
// the old `type Int: #Int` protocol spelling has no bare-parent form
// (nothing derives from itself).
type Int {
    spec MaxBits: 64;
    spec Alignment: 8;
};

obj CBuffer {
    ptr: Int;
    len: Int;
};

export defn add(a: Int, b: Int) -> Int {
    term a + b;
};

export defn multiply(a: Int, b: Int) -> Int {
    term a * b;
};

export defn first_len(buf: CBuffer) -> Int {
    term buf.ptr + buf.len;
};
