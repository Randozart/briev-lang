// ── Electronics Briev demo: power indicator LED ─────────────────────────
// 2026-09-11 (fundamentals doctrine, Phase B).
//
// There is no wiring syntax. Nets are INFERRED from the contract:
// precondition pin equalities state that two pins sit on the same
// electrical node; the compiler derives the netlist as the transitive
// closure. The drive states the supply level; the postcondition bounds
// the LED current — the tolerance clause (3.6 V) proves the level safe.
//
// Compile:  brievc build led_blinker.ebv   → led_blinker.kicad_sch
//
// Circuit (JST connector → 330 Ω series resistor → red LED):
//   J1.p1 ──── R1.a  R1.b ──── D1.a (anode)
//   J1.p2 ──── D1.k (cathode)

type Connector {
    pin p1 = 1;
    pin p2 = 2;
    reference "J";
};

type Resistor {
    pin a;
    pin b;
    reference "R";
};

type Led {
    pin a;
    pin k;
    reference "D";
    tolerance 3.6;
};

let j1: Connector = Connector { value: "JST-PH-2"; package: "JST-PH" };
let r1: Resistor  = Resistor  { value: "330"; package: "0805" };
let d1: Led       = Led       { value: "red"; package: "0805" };

txn powered
    [j1.p1.voltage == r1.a.voltage && r1.b.voltage == d1.a.voltage && d1.k.voltage == j1.p2.voltage && j1.p1.voltage == 3.3]
    [d1.a.current > 0.0 && d1.a.current <= 0.02]
{
}
