// ── Electronics Briev demo: power indicator LED ─────────────────────────
// 2026-09-24 (component laws). Component behavior is declared, not
// compiler-recognized: Resistor and Led laws live in std/electronics.bv;
// instances supply their datasheet physics through `spec`.
//
// There is no wiring syntax. Nets are INFERRED from the contract:
// precondition pin equalities state that two pins sit on the same
// electrical node; the compiler derives the netlist as the transitive
// closure, solves the component laws, and proves the current bound.
//
// `value` is a BOM annotation. Resistance, forward voltage, and dynamic
// resistance are physics. Unit suffixes (3.3Volt, 20mAmp, 330Ohm) are
// quantity notation; the rating clause remains the power decision.
//
// Compile:  brievc build led_blinker.ebv   → led_blinker.kicad_sch
//
// Circuit (JST connector → 330 Ω series resistor → red LED):
//   J1.p1 ──── R1.a  R1.b ──── D1.a (anode)
//   J1.p2 ──── D1.k (cathode)

type Connector {
    pin p1 = 1;
    pin p2 = 2;
    reference "J";
    tolerance any;
    rating any;
};

let j1: Connector = Connector { value: "JST-PH-2"; package: "JST-PH" };
let r1: Resistor  = Resistor {
    value: "330R";
    package: "0805";
    spec Resistance: 330Ohm;
};
let d1: Led       = Led {
    value: "red";
    package: "0805";
    spec ForwardVoltage: 1.8Volt;
    spec DynamicResistance: 10Ohm;
};

txn powered
    [j1.p1.voltage == r1.a.voltage && r1.b.voltage == d1.a.voltage && d1.k.voltage == j1.p2.voltage && j1.p1.voltage == 3.3Volt && j1.p2.voltage == 0.0Volt]
    [d1.a.current > 0.0 && d1.a.current <= 20mAmp]
{
}
