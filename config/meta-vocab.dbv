// config/meta-vocab.dbv — Phase G metadata vocabulary
// Inline schemas define the structure. Keyed entries in as MetaField
// use the (name) key field for named lookup. Positional > entries in
// as BackendMapping use field order for table-style data.

schema MetaField (name) {
    name: String;
    ty: String;
    description: String;
    owner: String;   // consumer domain that claims the key ("" = internal/unowned)
};

schema BackendMapping (meta_key) {
    backend: String;
    meta_key: String;
    value_pattern: String;
    attr: String;
    scope: String;  // "function", "instruction", "module", "loop", "option"
};

as MetaField {
    overflow: String; "Integer overflow behavior for arithmetic ops"; compiler;
    associative: Bool; "May the optimizer reassociate FP operations"; legacy;
    commutative: Bool; "May the optimizer swap commutative operands"; legacy;
    fp_contract: String; "May the optimizer form FP contractions (FMA)"; legacy;
    fp_math: String; "Floating-point compliance: ieee754 | fast"; legacy;
    readonly: Bool; "Function has no observable side effects"; llvm;
    alloc_scope: String; "Allocation scope: heap | stack"; webstack;
    inline_hint: String; "Inlining hint: always | never | hint"; llvm;
    convergence: String; "Hardware convergence mode: tight | loose"; webstack;
    unroll_hint: Int; "Loop unroll factor hint"; llvm;
    search_space: String; "MCMC search space: linear | bitwise | all"; mcmc;
    cost_model: String; "MCMC cost function: latency | throughput | size"; mcmc;
    tolerance: Float; "FP equivalence tolerance for MCMC"; mcmc;
    allowed_mutations: Vec[String]; "Restrict MCMC to named mutations only"; mcmc;
    ctd: String; "Common Type Definition (semantic type identity)"; compiler;
    alu: String; "Hardware ALU that computes the type"; compiler;
    encoding: String; "String encoding resolved via config/encodings.dbvl"; compiler;
    tbaa: String; "LLVM TBAA node name (a claim, not a proof)"; llvm;
};

as BackendMapping {
    > llvm; overflow; "wrapping"; "nuw nsw"; instruction;
    > llvm; overflow; "checked"; "nsw"; instruction;
    > llvm; overflow; "saturating"; "nuw"; instruction;
    > llvm; associative; "*"; "reassoc"; function;
    > llvm; fp_contract; "*"; "contract"; function;
    > llvm; fp_math; "fast"; "fast"; function;
    > llvm; fp_math; "ieee754"; ""; function;
    > llvm; readonly; "*"; "readonly"; function;
    > llvm; inline_hint; "always"; "alwaysinline"; function;
    > llvm; inline_hint; "never"; "noinline"; function;
    > llvm; unroll_hint; "*"; "unroll"; loop;
    > webstack; convergence; "tight"; "no_subnormals"; option;
    > webstack; alloc_scope; "stack"; "stack_allocation"; option;
    > webstack; fp_contract; "*"; "fma_fuse"; option;
    > circt; overflow; "wrapping"; "comb.add"; option;
    > circt; convergence; "tight"; "single_cycle"; option;
    > circt; unroll_hint; "*"; "unroll_factor"; option;
};
