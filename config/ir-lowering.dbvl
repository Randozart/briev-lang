// ── IR Lowering Tuning (plan §8.2, frontend-driven-dispatch) ─────────
// Global (target-independent) codegen tuning knobs, baked into the binary via
// include_str!. Absent keys fall back to these defaults in code.
//
// SSO derivation (documented per plan §8.2): the 6-byte small-string limit
// derives from the String handle representation — align 8, 2 tag bits →
// 8 - 2 = 6 payload bytes. This config entry is an OVERRIDE of that derivation;
// the derivation is the source of truth if this key is removed.
//
// 2026-08-03 (Phase 3, data-briev-config plan): migrated from ir-lowering.toml
// to Data Briev. Each line is `key: value;` in the flat .dbvl line-table form;
// values are Int scalars read via ConfigDb. The .toml remains until parity is
// proven (config_db::load_ir_lowering).

// Below this --optimize-budget, skip the bump arena entirely and use direct
// heap allocation (simpler IR, faster compile for shallow-simulation programs).
arena_min_budget: 128;

// Initial size of the per-txn bump arena (emit_arena_alloc).
arena_initial_size: 65536;

// Stack-allocation threshold for transient collections.
stack_threshold: 4096;

// Chunk size for %StateChunk<N> struct emission so LLVM SROA can decompose
// each chunk into scalar registers.
max_fields_per_alloca: 15;

// SSO small-string inline payload limit (see derivation above).
sso_max_bytes: 6;

// SVO small-vector/list inline element cap.

// Weighted body-cost threshold for callable-txn auto-inline (analysis/inline_cost.rs).
callable_inline_weight_threshold: 40;

// ── Accel auto-tuning probe (2026-08-06, Phase 7) ────────────────
// briev_accel_probe runs each lane `accel_probe_k` full-map times, commits GPU
// only when GPU time × (1 + margin) < CPU time AND outputs match within
// tolerance (the correctness gate).
accel_probe_k: 2;
accel_probe_tolerance: 0.0001;
accel_probe_margin: 0.05;

// CIRCT array-lowering policy (seq-firmem plan, 2026-08-25): state arrays
// at/above circt.firmem_min_depth default to the seq.firmem memory macro;
// below it, register files. Port budget caps distinct read sites per
// mem-lowered array. Users pin per-variable with `mem let` / `reg let`.
circt.firmem_min_depth: 64;

circt.firmem_max_ports: 4;

// CIRCT FSM clock frequency (Hz). Converts time-unit watchdog bounds
// ('within 10ms') to cycle counts; 0 = unset, such watchdogs are
// capability errors naming this knob.
circt.clock_hz: 0;

// SPIR-V cooperative row kernels (plan 2026-09-01-cooperative-row-kernels):
// when enabled, dot-product reductions use subgroup ops with vec4 loads
// (32-lane workgroup, stride-128, OpGroupNonUniformFAdd).
spirv_row_cooperative: 1;
spirv_coopmat: 1;
spirv_coopmat_tile_rows: 4;
spirv_coopmat_subgroups: 2;
// 2026-09-02 (plan 2026-09-02-cuda-race B3): FP16-accumulate tensor tier —
// separate numerics contract (gate rel <= 1e-2 vs the f32-acc tier).
spirv_coopmat_f16acc: 1;
spirv_coopmat_smem: 1;
spirv_coopmat_fill_pairs: 1;
spirv_coopmat_fill_quad: 0;
spirv_coopmat_fill_prefetch: 1;
spirv_coopmat_stagger: 0;
spirv_coopmat_panels_per_stage: 1;
spirv_coopmat_stages: 2;
// 2026-09-02 (plan 2026-09-02-image-and-dehashtag, revised): image storage
// strategy — texel-formatted write buffers realize as device storage images
// when the kernel's index math yields dimensions. Opt-in until measured.
spirv_image_storage: 0;
// 2026-09-15 (gpu_schedule Phase 3 enablement): device slot reuse for dead
// arrays (a later write-first array aliases an earlier dead array's
// projection offset). Safe after per-kernel field packing + input-only
// seeding landed (runner + Track A + runtime).
gpu_schedule_buffer_reuse: 1;
ptx_tensor_f16acc: 1;
// 2026-09-16 (fused attention kv-staged): coalesced 16-byte smem fills for
// Kt/V panels while Q stays as direct global loads. Correct but a wash at
// 512² (+9%) vs 1024² (−10%) — the load path is not the fused kernel's
// dominant bottleneck (block tile 16 rows has no Kt/V reuse across m-tiles).
ptx_fused_staged: 0;
