// Ring Buffer — Tests enum dispatch with wake hybrid (Path 4)
//
// Tests:
//   - Folded while-loop (ops < N → ops == N convergence)
//   - FFI output prevents dead-code elimination
//
// import "link/briev_rt.c" in briev_rt.bv pulls in the runtime automatically.
//
// Build:
//   cargo run --bin briev-compiler -- llvm benchmarks/ring_buffer.bv --out benchmarks --optimize-budget 256
//
// C reference: ring_buffer_c.c

#!exit ops == N;

import "link/briev_rt.c";
import { get_env_int } from "std/env.bv";

frgn print_int(n: Int) -> Bool ;

let ops: Int = 0;
let N: Int = get_env_int("BOUND");

node work [ops < N][ops == N] {
    &ops = ops + 1;
    [ops % 5000000 == 0] {
        print_int(ops);
    };
    term;
};
