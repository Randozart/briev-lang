#!exit count == total && x0 >= 0.0;

import { get_env_int } from "std/env.bv";
import "link/briev_rt.c";

frgn print_float(d: Float) -> Bool ;

let x0: Float = 0.0;
let x1: Float = 0.0;
let x2: Float = 0.0;
let p00: Float = 0.0;
let p01: Float = 0.0;
let p02: Float = 0.0;
let p10: Float = 0.0;
let p11: Float = 0.0;
let p12: Float = 0.0;
let p20: Float = 0.0;
let p21: Float = 0.0;
let p22: Float = 0.0;
let count: Int = 0;
let total: Int = get_env_int("BOUND");

const A00: Float = 1.0;
const A01: Float = 0.01;
const A02: Float = 0.0;
const A10: Float = 0.0;
const A11: Float = 1.0;
const A12: Float = 0.01;
const A20: Float = 0.0;
const A21: Float = 0.0;
const A22: Float = 1.0;

const Q00: Float = 0.1;
const Q01: Float = 0.0;
const Q02: Float = 0.0;
const Q11: Float = 0.1;
const Q12: Float = 0.0;
const Q22: Float = 0.1;
const Q10: Float = 0.0;
const Q20: Float = 0.0;
const Q21: Float = 0.0;

node tick [
    count < total
][count == total] {
    &x0 = A00 * x0 + A01 * x1 + A02 * x2;
    &x1 = A10 * x0 + A11 * x1 + A12 * x2;
    &x2 = A20 * x0 + A21 * x1 + A22 * x2;
    &p00 = p00 + Q00;
    &p01 = p01 + Q01;
    &p02 = p02 + Q02;
    &p10 = p10 + Q10;
    &p11 = p11 + Q11;
    &p12 = p12 + Q12;
    &p20 = p20 + Q20;
    &p21 = p21 + Q21;
    &p22 = p22 + Q22;
    &count = count + 1;
    [count % 5000000 == 0] {
        let trace: Float = p00 + p01 + p02 + p10 + p11 + p12 + p20 + p21 + p22;
        print_float(x0 + x1 + x2 + trace);
    };
    term;
};
