// stack_push_pop — Stack<T, N> push/pop cycle benchmark
//
// Tests: the generic obj Stack via std/collections.bv — op Init construction,
// '<-' InsertAt dispatch (self-bound push member), '~<-' ExtractFrom pop.
// 2026-10-01 (A2 design rule): '<-' on a Stack is now COPY-FROM
// (non-destructive peek, via op CopyFrom) — the pop cycle uses '~<-'
// (ExtractFrom) honestly. The counter is runtime-determined
// (get_env_int) so the compiler cannot precompute the loop.
//
// C reference: stack_push_pop_c.c

let N: Int = get_env_int!("BOUND");
import { Stack } from "std/collections.bv";
let st: Stack<Int, 256> = 0;
let count: Int = 0;

node work [count < N][count == N] {
    st <- count;
    ~<- st;
    count = count + 1;

    when count % 5000000 == 0 {
        println!(count);
    };

    term;
};
