// SAXPY: y = a * x + y (single-precision float)
// GPU offload benchmark — compiled with --gpu-offload to target SPIR-V.
// Falls back to CPU when Vulkan/OpenCL is unavailable.

frgn __get_env_int(name: Ptr<Byte>) -> Int from #System;

let N: Int = __get_env_int("BOUND");    // NOTE: harness uses BOUND env var

// State: element index
node saxpy_loop
    [i < N]
    [i == N]
{
    // Each thread would compute y[i] = a * x[i] + y[i]
    when i < N {
        i = i + 1;
    };
    term;
};

let i: Int = 0;
node report [i < 1][i == 1] {
    println!(N);
    i = i + 1;
    term;
};
