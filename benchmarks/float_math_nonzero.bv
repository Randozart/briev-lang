
let x0: Float = 1.0;
let x1: Float = 0.5;
let x2: Float = 0.2;
let p00: Float = 0.0;
let p11: Float = 0.0;
let p22: Float = 0.0;
let count: Int = 0;
let total: Int = get_env_int!("BOUND");

const A00: Float = 1.0;
const A01: Float = 0.01;
const A02: Float = 0.001;
const A10: Float = 0.01;
const A11: Float = 1.0;
const A12: Float = 0.01;
const A20: Float = 0.001;
const A21: Float = 0.01;
const A22: Float = 1.0;

const Q00: Float = 0.1;
const Q11: Float = 0.1;
const Q22: Float = 0.1;

node tick [
    count < total
][count == total] {
    // 2026-07-21: Use let temporaries for atomic reads matching C's
    // nx0/nx1/nx2 pattern. All RHS reads capture old x0/x1/x2.
    let nx0: Float = A00 * x0 + A01 * x1 + A02 * x2;
    let nx1: Float = A10 * x0 + A11 * x1 + A12 * x2;
    let nx2: Float = A20 * x0 + A21 * x1 + A22 * x2;
    x0 = nx0;
    x1 = nx1;
    x2 = nx2;
    p00 = p00 + Q00;
    p11 = p11 + Q11;
    p22 = p22 + Q22;
    count = count + 1;
    when count % 5000000 == 0 {
        let trace: Float = p00 + p11 + p22;
        println!("{}", x0 + x1 + x2 + trace);
    };
    term;
};
