// Parity corpus — str_to_int / str_to_float parse-semantics gate (plan §6.2).
// Return-value parity, not just output: the parse edge cases a pure-Briev
// implementation must reproduce (whitespace, sign, plus, overflow, garbage).
let done: Bool = false;
node go [done == false][done == true] {
    when done == false {
        let s1: Int = "42" as Int;
        println!("{}", s1);
        let s2: Int = "+42" as Int;
        println!("{}", s2);
        let s3: Int = "-0" as Int;
        println!("{}", s3);
        let s4: Int = " 42 " as Int;
        println!("{}", s4);
        let s5: Int = "42abc" as Int;
        println!("{}", s5);
        let s6: Int = "abc42" as Int;
        println!("{}", s6);
        let s7: Int = "" as Int;
        println!("{}", s7);
        let s8: Int = "0" as Int;
        println!("{}", s8);
        let s9: Int = "007" as Int;
        println!("{}", s9);
        let s10: Int = "-2147483648" as Int;
        println!("{}", s10);
        let s11: Int = "2147483647" as Int;
        println!("{}", s11);
        // Float parse lane (strtod semantics)
        let f1: Float = "3.14" as Float;
        println!("{}", f1);
        let f2: Float = "-2.5" as Float;
        println!("{}", f2);
        let f3: Float = "0.1" as Float;
        println!("{}", f3);
        let f4: Float = "100" as Float;
        println!("{}", f4);
        let f5: Float = "  42.5  " as Float;
        println!("{}", f5);
        let f6: Float = "1e9" as Float;
        println!("{}", f6);
        let f7: Float = "1e-9" as Float;
        println!("{}", f7);
        let f8: Float = "abc" as Float;
        println!("{}", f8);
        let f9: Float = "" as Float;
        println!("{}", f9);
        let f10: Float = "42.5xyz" as Float;
        println!("{}", f10);
        done = true;
    };
    term;
};