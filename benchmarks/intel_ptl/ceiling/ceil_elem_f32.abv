// Ceiling matrix: elementwise y[i] = a[i] + b[i], f32 storage.
// Zeroed state is fine — the kernel still reads/writes the full arrays.
const N: Int = 1048576;
let i: Int = 0;
let a: Float[N];
let b: Float[N];
let y: Float[N];

async accel node elem [i < N][i == N] {
    y[i] = a[i] + b[i];
    i = i + 1;
    term;
};
