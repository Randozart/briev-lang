// Ceiling matrix: row sum with the reassociation license (sum fold lane).
const ROWS: Int = 4096;
const K: Int = 1024;
let i: Int = 0;
let x: Float16[4194304];
let y: Float16[4096];

approx async accel node rowsum [i < ROWS][i == ROWS] {
    let acc: Float = 0.0;
    foreach k in 0..K {
        acc = acc + (x[i * K + k] as Float);
    };
    y[i] = acc as Float16;
    i = i + 1;
    term;
};
