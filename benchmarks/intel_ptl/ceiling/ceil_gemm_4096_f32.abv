// Ceiling matrix: declared GEMM (matmul!) 4096^3, f32 storage.
import "std/numeric.bv";
const M: Int = 4096;
const N: Int = 4096;
const K: Int = 4096;
let i: Int = 0;
let a: Float[16777216];
let b: Float[16777216];
let y: Float[16777216];

async accel node gemm [i < M * N][i == M * N] {
    matmul!(a, b, y, M, N, K, i, Float);
    i = i + 1;
    term;
};
