// g0_fsum_exact.bv — §12 P1 gate: `exact` pins the precise sequential float fold
// runs the GENERAL per-work-item lowering (no reassociation).
// The result must be bit-identical to the sequential host reference
// (BAD=0, exact Int-truncated comparison).
//
// 2026-11-06 (plan 2026-11-06-idiom-recognition-doctrine.md W3): the
// detector (detect_sum_fold) finds `acc = acc + a[i*K + k]`, the lane
// license (Int + const K % 32) fires, and the gate script asserts BOTH the
// BAD=0 print AND the "compiled on '<device>'" log line. Near-miss
// disclosure: build once with K%32 != 0 and read the why-not info line.
//
// Runs under `ulimit -s 65536` (state arrays exceed the 8 MB stack frame —
// BUGS.md 2026-11-06).

!> accel: force;

const ROWS: Int = 4096;
const K: Int = 1024;

let i: Int = 0;
let r: Int = 0;
let phase: Int = 0;
let bad: Int = 0;
let gpu_sum: Float = 0.0;
let cpu_sum: Float = 0.0;

let a: Float[4194304];
let y: Int[4096];

// init (CPU): deterministic values, -3..3.
async node init [phase == 0 && i < 4194304][i == 4194304] {
    foreach t in 0..4096 {
        let idx: Int = i + t;
        a[idx] = ((idx % 7) - 3) as Float;
    };
    i = i + 4096;
    term;
};

async node init_done [phase == 0 && i == 4194304][phase == 1] {
    phase = 1;
    i = 0;
    term;
};

// device lane: the sum idiom — detector fires, synthesis lowers.
exact async accel node rowsum [phase == 1 && i < ROWS][i == ROWS] {
    let acc: Float = 0.0;
    foreach k in 0..K {
        acc = acc + a[i * K + k];
    };
    y[i] = acc as Int;
    i = i + 1;
    term;
};

async node sum_done [phase == 1 && i == ROWS][phase == 2] {
    phase = 2;
    r = 0;
    term;
};

// host reference: recompute 256 spread rows, exactly.
async node verify [phase == 2 && r < 256][r == 256] {
    let row: Int = r * 16;
    let acc: Float = 0.0;
    foreach k in 0..K {
        acc = acc + a[row * K + k];
    };
    cpu_sum = cpu_sum + acc;
    gpu_sum = gpu_sum + y[row] as Float;
    when acc as Int != y[row] { bad = bad + 1; };
    r = r + 1;
    term;
};

async node verify_done [phase == 2 && r == 256][phase == 3] {
    phase = 3;
    term;
};

// Liveness anchor, not a value constraint: the sums are signed (row sums
// can be negative), so a `>= 0` guard here would be false forever and the
// reactor would never report (it runs until killed). The ±1e12 bounds stay
// textually live (a self-equality tautology is folded away, taking the
// accumulators' liveness with it) and are never violated by this fixture.
async node report [phase == 3 && bad >= 0 && gpu_sum >= -1000000000000.0
                   && cpu_sum >= -1000000000000.0][true] {
    endprogram println!("G0_SUM_BAD={} GPU_SUM={} CPU_SUM={} Y0={} YN={}",
                        bad, gpu_sum as Int, cpu_sum as Int, y[0], y[ROWS - 1]);
};
