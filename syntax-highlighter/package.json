{
  "name": "briev-language",
  "displayName": "Briev Language",
  "description": "Syntax highlighting, folding, bracket colorization, and intelligent editing for Briev (.bv), Rendered Briev (.rbv), and Embedded Briev (.ebv) files",
  "version": "0.1.0",
  "icon": "images/extension-logo.png",
  "publisher": "randozart",
  "main": "./client/extension.js",
  "activationEvents": [
    "onLanguage:briev",
    "onLanguage:rbv",
    "onLanguage:ebv",
    "onLanguage:dbriev",
    "onLanguage:sbriev",
    "onLanguage:srbv",
    "onLanguage:sebv",
    "onLanguage:abv",
    "onLanguage:sbv"
  ],
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "contributes": {
    "languages": [
      {
        "id": "briev",
        "aliases": ["Briev", "briev"],
        "extensions": [".bv"],
        "icon": {
          "light": "./images/briev-logo.svg",
          "dark": "./images/briev-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "rbv",
        "aliases": ["Rendered Briev", "rendered-briev", "Briev Render", "briev-render"],
        "extensions": [".rbv"],
        "icon": {
          "light": "./images/r-briev-logo.svg",
          "dark": "./images/r-briev-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "ebv",
        "aliases": ["Embedded Briev", "embedded-briev", "Briev Embed", "briev-embed"],
        "extensions": [".ebv"],
        "icon": {
          "light": "./images/e-briev-logo.svg",
          "dark": "./images/e-briev-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "dbriev",
        "aliases": ["Data Briev", "dbriev", "Briev Data", "briev-data"],
        "extensions": [".dbv", ".dbvl"],
        "icon": {
          "light": "./images/d-briev-logo.svg",
          "dark": "./images/d-briev-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "sbriev",
        "aliases": ["Strict Briev", "strict-briev"],
        "extensions": [".sbv"],
        "icon": {
          "light": "./images/briev-logo.svg",
          "dark": "./images/briev-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "srbv",
        "aliases": ["Strict Rendered Briev", "strict-rendered-briev", "Strict Render", "strict-render"],
        "extensions": [".srbv"],
        "icon": {
          "light": "./images/r-briev-logo.svg",
          "dark": "./images/r-briev-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "sebv",
        "aliases": ["Strict Embedded Briev", "strict-embedded-briev", "Strict Embed", "strict-embed"],
        "extensions": [".sebv"],
        "icon": {
          "light": "./images/e-briev-logo.svg",
          "dark": "./images/e-briev-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "abv",
        "aliases": ["Accelerated Briev", "accelerated-briev", "Briev Accel", "briev-accel"],
        "extensions": [".abv"],
        "icon": {
          "light": "./images/a-briev-logo.svg",
          "dark": "./images/a-briev-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "sbv",
        "aliases": ["Silicon Briev", "silicon-briev", "Briev Silicon", "briev-silicon"],
        "extensions": [".sbv"],
        "icon": {
          "light": "./images/s-briev-logo.svg",
          "dark": "./images/s-briev-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "beast",
        "aliases": ["BEAST", "beast"],
        "extensions": [".beast"],
        "icon": {
          "light": "./images/beast-icon.svg",
          "dark": "./images/beast-icon.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "briev",
        "scopeName": "source.briev",
        "path": "./syntaxes/briev.tmLanguage.json"
      },
      {
        "language": "rbv",
        "scopeName": "source.rbv",
        "path": "./syntaxes/rbv.tmLanguage.json"
      },
      {
        "language": "ebv",
        "scopeName": "source.briev",
        "path": "./syntaxes/briev.tmLanguage.json"
      },
      {
        "language": "dbriev",
        "scopeName": "source.dbriev",
        "path": "./syntaxes/dbriev.tmLanguage.json"
      },
      {
        "language": "sbriev",
        "scopeName": "source.briev",
        "path": "./syntaxes/briev.tmLanguage.json"
      },
      {
        "language": "srbv",
        "scopeName": "source.rbv",
        "path": "./syntaxes/rbv.tmLanguage.json"
      },
      {
        "language": "sebv",
        "scopeName": "source.briev",
        "path": "./syntaxes/briev.tmLanguage.json"
      },
      {
        "language": "abv",
        "scopeName": "source.briev",
        "path": "./syntaxes/briev.tmLanguage.json"
      },
      {
        "language": "sbv",
        "scopeName": "source.briev",
        "path": "./syntaxes/briev.tmLanguage.json"
      },
      {
        "language": "beast",
        "scopeName": "source.beast",
        "path": "./syntaxes/beast.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Briev Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/briev-dark.json"
      },
      {
        "label": "Briev Light",
        "uiTheme": "vs",
        "path": "./themes/briev-light.json"
      }
    ],
    "folding": [
      {
        "language": "briev",
        "boundaries": [
          "// === PATH ANALYSIS ===",
          "// === END PATH ANALYSIS ==="
        ]
      }
    ],
    "brackets": [
      {
        "language": "briev",
        "open": "{",
        "close": "}"
      },
      {
        "language": "briev",
        "open": "[",
        "close": "]"
      },
      {
        "language": "briev",
        "open": "(",
        "close": ")"
      }
    ],
    "autoClosingPairs": [
      {
        "open": "{",
        "close": "}",
        "notIn": [
          "string",
          "comment"
        ]
      },
      {
        "open": "[",
        "close": "]",
        "notIn": [
          "string",
          "comment"
        ]
      },
      {
        "open": "(",
        "close": ")",
        "notIn": [
          "string",
          "comment"
        ]
      },
      {
        "open": "\"",
        "close": "\"",
        "notIn": [
          "string",
          "comment"
        ]
      }
    ],
    "surroundingPairs": [
      {
        "open": "{",
        "close": "}"
      },
      {
        "open": "[",
        "close": "]"
      },
      {
        "open": "(",
        "close": ")"
      },
      {
        "open": "\"",
        "close": "\""
      }
    ],
    "comments": {
      "lineComment": "#"
    },
    "indentationRules": {
      "increaseIndentPattern": "\\{[^}]*${|\\[([^\\]]*${|\\([^)]*${",
      "decreaseIndentPattern": "^\\s*\\]|\\}\\s*$|\\)\\s*$"
    }
  },
  "devDependencies": {
    "vsce": "^2.10.0"
  },
  "dependencies": {
    "vscode-languageclient": "^8.0.2"
  },
  "overrides": {
    "undici": "5.11.0"
  }
}
