{
  "name": "briev-language",
  "displayName": "Briev Language",
  "description": "Syntax highlighting, folding, bracket colorization, and intelligent editing for Briev (.bv), Rendered Briev (.rbv), and Embedded Briev (.ebv) files",
  "version": "0.2.0",
  "icon": "images/extension-logo.png",
  "publisher": "randozart",
  "main": "./client/extension.js",
  "activationEvents": [
    "onLanguage:briev",
    "onLanguage:rbv",
    "onLanguage:ebv",
    "onLanguage:dbriev",
    "onLanguage:sbriev",
    "onLanguage:srbv",
    "onLanguage:abv",
    "onLanguage:sbv"
  ],
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "contributes": {
    "languages": [
      {
        "id": "briev",
        "aliases": [
          "Briev",
          "briev"
        ],
        "extensions": [
          ".bv"
        ],
        "icon": {
          "light": "./images/briev-logo.svg",
          "dark": "./images/briev-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "rbv",
        "aliases": [
          "Rendered Briev",
          "rendered-briev",
          "Briev Render",
          "briev-render"
        ],
        "extensions": [
          ".rbv"
        ],
        "icon": {
          "light": "./images/r-briev-logo.svg",
          "dark": "./images/r-briev-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "ebv",
        "aliases": [
          "Electronics Briev",
          "electronics-briev",
          "Briev Electronics",
          "briev-electronics"
        ],
        "extensions": [
          ".ebv"
        ],
        "icon": {
          "light": "./images/e-briev-logo.svg",
          "dark": "./images/e-briev-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "dbriev",
        "aliases": [
          "Data Briev",
          "dbriev",
          "Briev Data",
          "briev-data"
        ],
        "extensions": [
          ".dbv",
          ".dbvl"
        ],
        "icon": {
          "light": "./images/d-briev-logo.svg",
          "dark": "./images/d-briev-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "abv",
        "aliases": [
          "Accelerated Briev",
          "accelerated-briev",
          "Briev Accel",
          "briev-accel"
        ],
        "extensions": [
          ".abv"
        ],
        "icon": {
          "light": "./images/a-briev-logo.svg",
          "dark": "./images/a-briev-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "sbv",
        "aliases": [
          "Silicon Briev",
          "silicon-briev",
          "Briev Silicon",
          "briev-silicon"
        ],
        "extensions": [
          ".sbv"
        ],
        "icon": {
          "light": "./images/s-briev-logo.svg",
          "dark": "./images/s-briev-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "bad",
        "aliases": [
          "Briev Assembly Dialect",
          "briev-assembly",
          "BAD",
          ".bad"
        ],
        "extensions": [
          ".bad"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/bad-icon.svg",
          "dark": "./images/bad-icon.svg"
        }
      },
      {
        "id": "bld",
        "aliases": [
          "BILLD",
          "billd",
          "Briev Intermediate Low-Level"
        ],
        "extensions": [
          ".bld"
        ],
        "icon": {
          "light": "./images/billd-icon.svg",
          "dark": "./images/billd-icon.svg"
        },
        "configuration": "./language-configuration-bld.json"
      },
      {
        "id": "beast",
        "aliases": [
          "BEAST",
          "beast"
        ],
        "extensions": [
          ".beast"
        ],
        "icon": {
          "light": "./images/beast-icon.svg",
          "dark": "./images/beast-icon.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "briev",
        "scopeName": "source.briev",
        "path": "./syntaxes/briev.tmLanguage.json"
      },
      {
        "language": "rbv",
        "scopeName": "source.rbv",
        "path": "./syntaxes/rbv.tmLanguage.json"
      },
      {
        "language": "ebv",
        "scopeName": "source.ebv",
        "path": "./syntaxes/ebv.tmLanguage.json"
      },
      {
        "language": "sbv",
        "scopeName": "source.sbv",
        "path": "./syntaxes/sbv.tmLanguage.json"
      },
      {
        "language": "abv",
        "scopeName": "source.abv",
        "path": "./syntaxes/abv.tmLanguage.json"
      },
      {
        "language": "dbriev",
        "scopeName": "source.dbriev",
        "path": "./syntaxes/dbriev.tmLanguage.json"
      },
      {
        "language": "bad",
        "scopeName": "source.bad",
        "path": "./syntaxes/bad.tmLanguage.json"
      },
      {
        "language": "bld",
        "scopeName": "source.bld",
        "path": "./syntaxes/bld.tmLanguage.json"
      },
      {
        "language": "beast",
        "scopeName": "source.beast",
        "path": "./syntaxes/beast.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Briev Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/briev-dark.json"
      },
      {
        "label": "Briev Light",
        "uiTheme": "vs",
        "path": "./themes/briev-light.json"
      }
    ],
    "brackets": [
      {
        "language": "briev",
        "open": "{",
        "close": "}"
      },
      {
        "language": "briev",
        "open": "[",
        "close": "]"
      },
      {
        "language": "briev",
        "open": "(",
        "close": ")"
      }
    ],
    "autoClosingPairs": [
      {
        "open": "{",
        "close": "}",
        "notIn": [
          "string",
          "comment"
        ]
      },
      {
        "open": "[",
        "close": "]",
        "notIn": [
          "string",
          "comment"
        ]
      },
      {
        "open": "(",
        "close": ")",
        "notIn": [
          "string",
          "comment"
        ]
      },
      {
        "open": "\"",
        "close": "\"",
        "notIn": [
          "string",
          "comment"
        ]
      }
    ],
    "surroundingPairs": [
      {
        "open": "{",
        "close": "}"
      },
      {
        "open": "[",
        "close": "]"
      },
      {
        "open": "(",
        "close": ")"
      },
      {
        "open": "\"",
        "close": "\""
      }
    ],
    "comments": {
      "lineComment": "//"
    },
    "indentationRules": {
      "increaseIndentPattern": "\\{[^}]*${|\\[([^\\]]*${|\\([^)]*${",
      "decreaseIndentPattern": "^\\s*\\]|\\}\\s*$|\\)\\s*$"
    }
  },
  "devDependencies": {
    "vsce": "^2.10.0"
  },
  "dependencies": {
    "vscode-languageclient": "^8.0.2"
  },
  "overrides": {
    "undici": "5.11.0"
  }
}
