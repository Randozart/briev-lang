{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Briev Assembly Dialect",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#blocks"
    },
    {
      "include": "#ack"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#top-level"
    },
    {
      "include": "#exceptions"
    },
    {
      "include": "#contracts"
    },
    {
      "include": "#registers"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#mnemonics"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.bad",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.bad",
      "match": "\"(?:[^\"\\\\]|\\\\.)*\""
    },
    "directives": {
      "patterns": [
        {
          "name": "support.function.directive.bad",
          "match": "^\\s*(section|global)\\b|^\\s*\\.[a-zA-Z]+\\b"
        }
      ]
    },
    "top-level": {
      "patterns": [
        {
          "name": "storage.type.bad",
          "match": "^\\s*(defn|alias|import|export)\\b"
        },
        {
          "name": "support.function.directive.bad",
          "match": "^\\s*(\\.const|\\.struct|\\.field|\\.end)\\b"
        },
        {
          "name": "entity.name.function.local.bad",
          "match": "^\\s*\\.[a-zA-Z_][a-zA-Z0-9_.]*:"
        },
        {
          "name": "variable.other.register.fp.bad",
          "match": "\\bf(?:[0-9]|1[0-5])\\b"
        }
      ]
    },
    "exceptions": {
      "patterns": [
        {
          "name": "keyword.operator.exception.bad",
          "match": "=>"
        },
        {
          "name": "entity.name.tag.target.bad",
          "match": "^\\s*(default|x86_64|aarch64|riscv64|arm|thumb|ptx)(?=\\s*=>)"
        }
      ]
    },
    "contracts": {
      "patterns": [
        {
          "name": "support.type.contract.bad",
          "begin": "\\[",
          "end": "\\]"
        }
      ]
    },
    "registers": {
      "name": "variable.other.register.bad",
      "match": "\\b(r[0-9]|r1[0-5]|sp|pc)\\b"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.bad",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.bad",
          "match": "\\b-?[0-9]+\\b"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.function.label.bad",
          "match": "^\\s*[a-zA-Z_][a-zA-Z0-9_.]*:"
        }
      ]
    },
    "mnemonics": {
      "name": "keyword.other.mnemonic.bad",
      "match": "^\\s*[a-zA-Z_][a-zA-Z0-9_.]*"
    },
    "blocks": {
      "comment": "2026-10-17: block keywords — site/end site (2026-10-01 anonymous dispatch, bad-dialect.md §Sites) and raw <target> [name]/end raw (§Raw blocks). Terminators are EXACT in the parser: src/parser/bad.rs rejects bare `end` with a fix; both are line-head anchored so they win over the generic mnemonic rule.",
      "patterns": [
        {
          "match": "^\\s*(raw)\\s+(x86_64|aarch64|riscv64|arm|thumb|ptx)(\\s+[a-zA-Z_][a-zA-Z0-9_]*)?",
          "name": "meta.block.raw.bad",
          "captures": {
            "1": {
              "name": "keyword.control.block.bad"
            },
            "2": {
              "name": "entity.name.tag.target.bad"
            },
            "3": {
              "name": "entity.name.function.label.bad"
            }
          }
        },
        {
          "match": "^\\s*(end)\\s+(raw|site)\\b",
          "name": "meta.block.end.bad",
          "captures": {
            "1": {
              "name": "keyword.control.block.bad"
            },
            "2": {
              "name": "keyword.control.block.bad"
            }
          }
        },
        {
          "match": "^\\s*(site)\\b",
          "name": "keyword.control.block.bad"
        }
      ]
    },
    "ack": {
      "comment": "2026-10-17: acknowledge-tier prefixes ^/^^/^^^ + instruction (bad-dialect.md §The acknowledge tier). The mnemonic is captured here — the generic mnemonic rule is line-head anchored and would never match past the carets.",
      "patterns": [
        {
          "match": "^(\\s*)(\\^{1,3})(\\s+)([a-zA-Z_][a-zA-Z0-9_.]*)",
          "name": "meta.instruction.acknowledged.bad",
          "captures": {
            "2": {
              "name": "keyword.other.acknowledge.bad"
            },
            "4": {
              "name": "keyword.other.mnemonic.bad"
            }
          }
        }
      ]
    }
  },
  "scopeName": "source.bad",
  "fileTypes": [
    "bad"
  ]
}
