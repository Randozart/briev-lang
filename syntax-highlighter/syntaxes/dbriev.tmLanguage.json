{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Data Briev",
  "scopeName": "source.dbriev",
  "fileTypes": [
    "dbv",
    "dbvl"
  ],
  "firstLineMatch": "^//",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#schema-decl"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#module-paths"
    },
    {
      "include": "#entry-keys"
    },
    {
      "include": "#types"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.dbriev",
          "match": "//.*$"
        }
      ]
    },
    "directives": {
      "comment": "2026-10-17: retarget — source of truth src/dbriev/v2.rs::parse. Line-start `>` directives (dbvl): >schema / >import / >encoding / >version, case-insensitive (starts_with_ignore_case — folded here as char classes so the pattern compiles in BOTH Oniguruma and JS RegExp; (?i:) groups are Oniguruma-only). `>schema <Name> from \"path\"` carries the from-clause (lib/boards/stm32f407/addresses.dbvl). The old debug-IR vocabulary this grammar used to describe (sig/TXN/REGISTER/ALIAS/RULE/CHECK + uppercase Briev keywords) does not exist in v2.rs.",
      "patterns": [
        {
          "match": "^\\s*>\\s*(?:[sS][cC][hH][eE][mM][aA]|[iI][mM][pP][oO][rR][tT]|[eE][nN][cC][oO][dD][iI][nN][gG]|[vV][eE][rR][sS][iI][oO][nN])\\b",
          "name": "keyword.control.directive.dbriev"
        },
        {
          "match": "\\b[fF][rR][oO][mM]\\b",
          "name": "keyword.control.import.dbriev"
        }
      ]
    },
    "schema-decl": {
      "patterns": [
        {
          "match": "\\b[sS][cC][hH][eE][mM][aA]\\b(?=\\s+[A-Za-z_])",
          "name": "keyword.control.schema.dbriev"
        },
        {
          "match": "\\b[aA][sS]\\b(?=\\s+[A-Za-z_]\\s*\\{)",
          "name": "keyword.control.schema.dbriev"
        }
      ]
    },
    "keywords": {
      "comment": "Bare (no `>`) import for backwards compat; encoding/version at line-head without the `>` form.",
      "patterns": [
        {
          "match": "^\\s*(?:[iI][mM][pP][oO][rR][tT]|[eE][nN][cC][oO][dD][iI][nN][gG]|[vV][eE][rR][sS][iI][oO][nN])\\b",
          "name": "keyword.control.dbriev"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.dbriev",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.dbriev"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b0x[0-9a-fA-F]+\\b",
          "name": "constant.numeric.hex.dbriev"
        },
        {
          "match": "\\b[0-9]+\\.[0-9]+\\b",
          "name": "constant.numeric.float.dbriev"
        },
        {
          "match": "\\b[0-9]+\\b",
          "name": "constant.numeric.integer.dbriev"
        }
      ]
    },
    "module-paths": {
      "comment": "Dotted module-registry paths (config/targets.dbvl rows: config/address-map.dbvl, target.x86_64).",
      "patterns": [
        {
          "match": "\\b[a-z_][a-z0-9_]*(?:\\.[a-z_][a-z0-9_]*)+\\b",
          "name": "entity.name.import.dbriev"
        }
      ]
    },
    "entry-keys": {
      "comment": "Flat table keys at line head before `:` (addresses.dbvl `UART1: 0x40011000; 0x18;`), schema field names (`base_addr: String;`), and extension-keyed config rows (config/targets.dbvl `.bv: llvm; --budget 256; …` — leading dot allowed).",
      "patterns": [
        {
          "match": "^\\s*\\.?[A-Za-z_][A-Za-z0-9_]*(?=\\s*:)",
          "name": "entity.name.constant.dbriev"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b(String|Int|Float|Bool|Blob|List|Map)\\b",
          "name": "support.type.dbriev"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": "[{}]",
          "name": "punctuation.section.block.dbriev"
        },
        {
          "match": ";",
          "name": "punctuation.terminator.dbriev"
        },
        {
          "match": ":",
          "name": "punctuation.separator.dbriev"
        }
      ]
    }
  }
}
