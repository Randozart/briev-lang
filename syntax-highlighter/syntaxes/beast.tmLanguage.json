{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "BEAST",
  "scopeName": "source.beast",
  "fileTypes": ["beast"],
  "firstLineMatch": "^\\(",
  "patterns": [
    { "include": "#parens" },
    { "include": "#strings" },
    { "include": "#colon-attributes" },
    { "include": "#tag-atoms" },
    { "include": "#numbers" },
    { "include": "#atoms" }
  ],
  "repository": {
    "parens": {
      "comment": "2026-10-17: retarget — src/beast/serialize.rs has emitted S-expressions since 2026-07-14 (to_beast -> SExpr -> to_string, width-60 wrapping); every .beast file in the tree is a parenthesized list, not the retired line-tag format this grammar used to describe.",
      "patterns": [
        { "match": "[()]", "name": "punctuation.section.parens.beast" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.beast",
          "patterns": [
            { "match": "\\\\.", "name": "constant.character.escape.beast" }
          ]
        }
      ]
    },
    "colon-attributes": {
      "comment": "Atoms WITH the leading colon as emitted by src/beast/serialize.rs (:bound :lit :range :async :reactive :ref :single :choice).",
      "patterns": [
        {
          "match": ":(bound|lit|range|async|reactive|ref|single|choice)\\b",
          "name": "keyword.other.attribute.beast"
        }
      ]
    },
    "tag-atoms": {
      "comment": "2026-10-17: the exhaustive tag-atom set extracted from src/beast/serialize.rs atom() calls — the statement/expression/type tags the serializer emits as bare atoms. Data, not vocabulary guesses (Rule 3): when serialize.rs grows a tag, this list grows with it (validate_grammars.mjs diffs the two).",
      "patterns": [
        {
          "match": "\\b(addrof|alignment|assign|binop|block|body|call|capture|cast|constant|contract|defn|deref|expr|field|gate|guarded|ident|if|index|init|let|list|maxbits|member|members|metadata|method|named|none|outputs|param|params|parent|pin|pins|plugin|pos|post|post_authority|pre|properties|protocol|quantity|refs|slot|slots|state|statement|string|term!|term|toplevel|trigger|tuple|txn|typedef|unop|yield)\\b",
          "name": "support.function.tag.beast"
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "match": "\\b0x[0-9a-fA-F]+\\b", "name": "constant.numeric.hex.beast" },
        { "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b", "name": "constant.numeric.float.beast" },
        { "match": "\\b[0-9]+\\b", "name": "constant.numeric.integer.beast" }
      ]
    },
    "atoms": {
      "patterns": [
        {
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
          "name": "variable.other.atom.beast"
        },
        {
          "match": "\\b[a-z_][a-zA-Z0-9_.]*\\b",
          "name": "variable.other.atom.beast"
        }
      ]
    }
  }
}
