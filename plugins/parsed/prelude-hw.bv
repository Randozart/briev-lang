// ── Hardware Prelude — CIRCT / Cell Targets ──────────────────────────────
// 2026-07-21: Rewritten with direct AST navigation DSL.
// 2026-07-23: Added Count$ check — Before$ on empty selection causes error.
// Inserts hardware stdlib import before the first user import.
// Used by .sbv files; provides Cell, Wire, Register, Bit.

$(Parsed @ highest) {
    let anchor = Tag$("import").First$();
    when anchor.Count$() > 0 {
        anchor.Before$()
            .Insert$(Import$("std/hardware.bv"));
    };
    // No imports? Insert before the first non-import item, or skip.
    when anchor.Count$() == 0 {
        // Create a minimal result — no imports to insert before
    };
};
