// ── Native Prelude — LLVM .bv target only ─────────────────────────────────
// 2026-09-09 (Family A/B, briev-native runtime): the plain `prelude` plus
// cast_lanes.bv + float_fmt.bv (the pure-Briev casting lanes and print
// family). NOT used by .abv (SPIR-V rejects Load#/Store#/SysCall#) or
// .rbv (wasm has no write(2)) — those keep `prelude` and their own I/O
// paths. .cbv uses prelude-hw.
// Inserts all stdlib imports before the first user import in the file.
// Runs at $(Parsed) with highest priority so imports are available
// before type checking.

$(Parsed @ highest) {
    let anchor = Tag$("import").First$();
    when anchor.Count$() > 0 {
        anchor.Before$().Insert$(
            Import$("std/types/bootstrap.bv"),
            // 2026-08-14 (slice-6 unblock): collections.bv declares the
            // iteration ops (`obj List<T>` op Count/op At). Without it the
            // typechecker's name-fallback lets `List<T>` typecheck but the
            // backend has no obj_members → tier2 iteration never fires and
            // foreach silently falls back to the hardcoded List layout.
            Import$("std/collections.bv"),
            Import$("std/os/fs.bv"),
            Import$("std/os/net.bv"),
            Import$("std/os/signal.bv"),
            Import$("std/os/ipc.bv"),
            Import$("std/os/thread.bv"),
            Import$("std/os/user.bv"),
            Import$("std/os/mem.bv"),
            Import$("std/os/atomic.bv"),
            Import$("std/env.bv"),
            Import$("std/io.bv"),
            // 2026-09-09 (Family A, briev-native runtime): the casting-graph
            // lane defns (int_to_str, float_to_str, str_to_int, ...) live in
            // cast_lanes.bv + float_fmt.bv. They must be in every compilation
            // unit so the backend declare-guard skips the briev_rt.c
            // C declares and the lanes resolve to pure-Briev code.
            // (cast_lanes.bv is deliberately lean: pulling all of string.bv
            // into every unit collides on to_string with string_builder.bv.)
            Import$("std/cast_lanes.bv"),
            Import$("std/float_fmt.bv")
        );
    };
    // 2026-07-21: No imports — insert before the first txn.
    // 2026-07-23: Check Count$() before Before$() to avoid error on empty selection.
    when anchor.Count$() == 0 {
        let txn_anchor = Tag$("txn").First$();
        when txn_anchor.Count$() > 0 {
            txn_anchor.Before$().Insert$(
                Import$("std/types/bootstrap.bv"),
                // 2026-08-14 (slice-6 unblock): see the anchor branch note.
                Import$("std/collections.bv"),
                Import$("std/os/fs.bv"),
                Import$("std/os/net.bv"),
                Import$("std/os/signal.bv"),
                Import$("std/os/ipc.bv"),
                Import$("std/os/thread.bv"),
                Import$("std/os/user.bv"),
                Import$("std/os/mem.bv"),
                Import$("std/os/atomic.bv"),
                Import$("std/env.bv"),
                Import$("std/io.bv"),
                // 2026-09-09 (Family A): see the anchor branch note above.
                Import$("std/cast_lanes.bv"),
                Import$("std/float_fmt.bv")
            );
        };
    };
};
