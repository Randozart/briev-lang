let done: Bool = false;
defn inorder(tree: List<Int>, idx: Int, n: Int) -> Int {
    when idx * 2 + 1 < n {
        let left: Int = inorder(tree, idx * 2 + 1, n);
    };
    Print#(tree[idx]);
    Print#('\n');
    when idx * 2 + 2 < n {
        let right: Int = inorder(tree, idx * 2 + 2, n);
    };
    term 0;
};
node main [done == false][done] {
    let tree: List<Int> = [4, 2, 6, 1, 3, 5, 7];
    let ignored: Int = inorder(tree, 0, Count#(tree));
    done = true;
    term;
};
