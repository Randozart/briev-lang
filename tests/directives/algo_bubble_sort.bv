// P7 curated semantic corpus (2026-11-10): deterministic bounded algorithm.
// EXPECT-STDOUT: 1
// EXPECT-STDOUT: 2
// EXPECT-STDOUT: 4
// EXPECT-STDOUT: 5
// EXPECT-STDOUT: 8
let done: Bool = false;

defn bubble(xs: List<Int>) -> List<Int> {
    let n: Int = Count#(xs);
    let i: Int = 0;
    foreach ii in 0..n {
        foreach jj in 0..(n - 1 - ii) {
            when xs[jj] > xs[jj + 1] {
                let t: Int = xs[jj];
                xs[jj] = xs[jj + 1];
                xs[jj + 1] = t;
            };
        };
    };
    term xs;
};

node main [done == false][done] {
    let xs: List<Int> = [5, 1, 4, 2, 8];
    let sorted: List<Int> = bubble(xs);
    foreach v in sorted { Print#(v); Print#('\n'); };
    done = true;
    term;
};
