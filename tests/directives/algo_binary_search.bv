// P7 curated semantic corpus (2026-11-10): deterministic bounded algorithm.
// EXPECT-STDOUT: 3
// EXPECT-STDOUT: -1
let done: Bool = false;
defn search(xs: List<Int>, target: Int, lo: Int, hi: Int) -> Int {
    when lo > hi { term -1; };
    let mid: Int = (lo + hi) / 2;
    when xs[mid] == target { term mid; };
    when xs[mid] < target { term search(xs, target, mid + 1, hi); };
    term search(xs, target, lo, mid - 1);
};
node main [done == false][done] {
    let xs: List<Int> = [1, 3, 5, 7, 9, 11];
    Print#(search(xs, 7, 0, Count#(xs) - 1)); Print#('\n');
    Print#(search(xs, 4, 0, Count#(xs) - 1)); Print#('\n');
    done = true;
    term;
};
