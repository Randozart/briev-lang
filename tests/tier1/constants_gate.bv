// std/constants.bv gate — named constants compile, fold, and keep their values.
//
// Each limit is asserted at runtime against the literal it names, and the
// spec: 8.1
// golden output pins the failure count at 0, so a drifted constants module
// fails this fixture instead of silently shifting a bound. Contract folding
// is exercised too: clamp_byte's [pre][post] name U8_MAX, and the program
// compiles only if the proof engine folds the imported constant.
import { I8_MAX, I16_MAX, I32_MAX, I64_MAX } from "std/constants.bv";
import { U8_MAX, U16_MAX, U32_MAX } from "std/constants.bv";
import { KIB, MIB, PAGE_SIZE, UTF16_OFFSET, NSEC_PER_SEC } from "std/constants.bv";
import { print_int } from "std/io";

defn clamp_byte(v: Int) [v >= 0 && v <= U8_MAX][term >= 0 && term <= U8_MAX] -> Int {
    when v > 100 { term U8_MAX; };
    term v;
};

// 2026-11-20 (issue #149 fallout): the counter used to be threaded through
// `mismatches` itself (`mismatches(failures, actual, want)`), which forced the
// call site to prove `failures >= 0` — and the fact engine cannot carry a
// variable's invariant across an in-place assignment from a contracted call
// (killing `v`'s facts and re-deriving them from a postcondition that mentions
// the OLD `v` is a two-state problem). Stated as a predicate plus an arithmetic
// accumulator the same program needs no such proof, and the accumulator's
// non-negativity rides the existing `v = v + e` re-derivation.
defn mismatches(actual: Int, want: Int) [true][term == 0 || term == 1] -> Int {
    when actual != want { term 1; };
    term 0;
};

let done: Int = 0;
let failures: Int = 0;

node entry [done == 0][done == 1] {
    failures = failures + mismatches(clamp_byte(200), 255);
    failures = failures + mismatches(I8_MAX, 127);
    failures = failures + mismatches(I16_MAX, 32767);
    failures = failures + mismatches(I32_MAX, 2147483647);
    failures = failures + mismatches(I64_MAX, 9223372036854775807);
    failures = failures + mismatches(U16_MAX, 65535);
    failures = failures + mismatches(U32_MAX, 4294967295);
    failures = failures + mismatches(KIB, 1024);
    failures = failures + mismatches(MIB, 1048576);
    failures = failures + mismatches(PAGE_SIZE, 4096);
    failures = failures + mismatches(UTF16_OFFSET, 65536);
    failures = failures + mismatches(NSEC_PER_SEC, 1000000000);

    print_int(failures);
    done = 1;
    term;
};
