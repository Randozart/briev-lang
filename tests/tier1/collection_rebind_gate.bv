import "std/iterator.bv";

obj Item { id: Int; };

defn integer_rebind() -> List<Int> {
    let values: List<Int> = [];
    foreach idx in 0..2 {
        let entry: List<Int> = [idx+1];
        values = values + entry;
    };
    term values;
};

defn object_rebind() -> List<Item> {
    let values: List<Item> = [Item { id: 1 }];
    let replacement: List<Item> = [Item { id: 2 }];
    values = replacement;
    values <- Item { id: 3 };
    term values;
};

let tick: Int = 0;
node run [tick < 1][tick == 1] {
    let integers: List<Int> = integer_rebind();
    let objects: List<Item> = object_rebind();
    let valid: Bool = integers .^Length == 2 && integers[0] == 1 && integers[1] == 2 &&
        objects .^Length == 2 && objects[0].id == 2 && objects[1].id == 3;
    println!("collection_rebind_and_explicit_push={}",valid);
    when !valid { endprogram 1; };
    tick = 1; endprogram;
};
