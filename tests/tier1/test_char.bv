// Test Char type — everyday-features gate.
// Migrated 2026-10-12 from the pre-`when` `[cond] { ... }` block form
// (the old guards had not parsed on the current surface since the
// when-keyword migration; this fixture had never been compiled).
import "std/char.bv";

let done: Int = 0;

node main [done == 0][done == 1] {
    when is_whitespace(' ') && is_digit('5') && is_alpha('A') {
        println!("char-classify-ok");
    };
    when to_upper('a') == 'A' && to_lower('Z') == 'z' {
        println!("char-convert-ok");
    };
    let emoji: Int = char_to_int('\u{1F600}');
    when int_to_char(emoji) == '\u{1F600}' {
        println!("char-unicode-ok");
    };
    done = 1;
    term;
};
