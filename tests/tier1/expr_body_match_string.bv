// Expression-bodied defn returning a String from a match — 2026-11-10.
// Regression: the defn fallthrough returned `null` for ptr-typed last
// expressions (the match result was dropped: `ret ptr null`), discovered by
// spec: 11.3
// the kiosk native RPC dispatcher (BUGS.md). Golden: both arm strings.
defn pick(x: Int) -> String {
    // 2026-11-21 (wave-8 totality): the trailing expression IS the return, and
    // SPEC §11.3 spells it without a semicolon. With the `;` the statement is an
    // expression statement, the defn falls off its end, and the emitter's old
    // leniency (it returned the last expression statement anyway) hid that.
    match x {
        1 => "{\"a\":1}",
        _ => "{\"b\":1}",
    }
};

node entry [beginprogram][true] {
    Print#(pick(1));
    Print#(pick(2));
    term;
};
