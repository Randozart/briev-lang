// Net-stack helper golden fixture — PR #26 reconciliation (2026-10-20).
//
// Canonical answers end to end through the COMPILED pipeline (the interpreter
// covers the other three helpers; Base64 is compiled-path only — its encoder
// delegates to a callable `txn`, which the interpreter does not execute yet —
// BUGS.md 2026-10-20):
//   - Base64("hello") = "aGVsbG8="
//   - RFC 6455 §1.3 accept key: dGhlIHNhbXBsZSBub25jZQ==
//       -> s3pPLMBiTxaQ9kYGzzhZRbK+xOo=   (SHA-1 + Base64 end to end)
//   - incremental HTTP parse of a complete GET (method/path/consumed)
//   - ws_message on a masked client frame -> unmasked "abc"
//   - ws_encode_text round-trip -> "abc"
// Prints: aGVsbG8=|s3pPLMBiTxaQ9kYGzzhZRbK+xOo=|OK
import { ByteBuf, GrowBuf } from "std/net/bytes";
import { ws_decode, ws_message, ws_encode_text } from "std/net/websocket";
import { http_parse_request, ws_accept_key } from "std/net/http";
import { base64_encode } from "std/net/base64";
import { print_str } from "std/io";

defn str_buf(s: String) -> ByteBuf {
    let n: Int = s .^Length;
    term ByteBuf { ptr: ((s as Data) as Int) + 8, len: n, cap: n };
};

node entry [beginprogram][ok == 4] {
    let hello: String = "hello";
    let b64: String = base64_encode(str_buf(hello));
    print_str(b64);
    print_str("|");

    let accept: String = ws_accept_key("dGhlIHNhbXBsZSBub25jZQ==");
    print_str(accept);
    print_str("|");

    let ok: Int = 0;

    let req: String = "GET /x HTTP/1.1\r\nHost: h\r\n\r\n";
    let rp = http_parse_request(str_buf(req), req .^Length);
    when rp.status == 1 && rp.request.method == "GET"
        && rp.request.path == "/x" && rp.consumed == req .^Length {
        ok = ok + 1;
    };
    let cut: Int = (req .^Length) - 2;
    let partial = http_parse_request(str_buf(req), cut);
    when partial.status == 0 {
        ok = ok + 1;
    };

    let raw: Ptr<Bit<8>> = Malloc#(16) as Ptr<Bit<8>>;
    Store#(raw as Int + 0, 0x81, 1);
    Store#(raw as Int + 1, 0x83, 1);
    Store#(raw as Int + 2, 1, 1);
    Store#(raw as Int + 3, 2, 1);
    Store#(raw as Int + 4, 3, 1);
    Store#(raw as Int + 5, 4, 1);
    Store#(raw as Int + 6, (97 ^ 1), 1);
    Store#(raw as Int + 7, (98 ^ 2), 1);
    Store#(raw as Int + 8, (99 ^ 3), 1);
    let fr: ByteBuf = ByteBuf { ptr: raw as Int, len: 9, cap: 16 };
    let msg = ws_message(fr, 0);
    when msg.status == 1 && msg.payload == "abc" && msg.consumed == 9 {
        ok = ok + 1;
    };

    let g: GrowBuf = ws_encode_text("abc");
    let gv: ByteBuf = ByteBuf { ptr: g.ptr, len: g.len, cap: g.cap };
    let back = ws_message(gv, 0);
    when back.status == 1 && back.payload == "abc" && back.consumed == 5 {
        ok = ok + 1;
    };

    when ok == 4 {
        print_str("OK");
    };
    endprogram 0;
};
