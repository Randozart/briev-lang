import "std/io.bv";

defn narrow(v: Float32) -> Int {
// spec: 15.6
    term (v as Data) as Int;
};

defn widen64(v: Float64) -> Int {
    term (v as Data) as Int;
};

node entry [beginprogram][true] {
    let a: Float32 = 1.5;
    let w: Int = (a as Data) as Int;
    Print#(w as String);
    Print#("|");
    Print#(narrow(1.5) as String);
    Print#("|");
    Print#(((-0.0 as Float32) as Data) as Int as String);
    Print#("|");
    let b: Float64 = 1.5;
    Print#((b as Data) as Int as String);
    endprogram Print#("");
};
