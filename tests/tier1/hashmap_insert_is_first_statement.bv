//===----------------------------------------------------------------------===//
// hashmap_insert_is_first_statement — a collection insert as the FIRST
// statement of a guarded node body.
//
// Regression for BUGS.md 2026-11-24: `HashMap.init` allocated its occupancy
// array with `Malloc#` (uninitialized, `@malloc`) and never cleared it, so the
// first insert's probe read never-written storage. LLVM folded that load to
// `undef`, treated the probe branch as UB, and SCCP deleted the node's whole
// observable continuation: the program printed NOTHING and exited 0 at -O2+,
// while the identical source printed 7/0 at -O0. `new_occupancy` now clears
// the table.
//
// The SHAPE is the regression, not just the map: an inlined collection member
// call first in a node body. The golden pins the observable output and
// tests/opt_level_parity.rs pins that every optimization level agrees on it.
import { HashMap } from "std/collections.bv";

let m: HashMap<Int, Int> = 32;
let done: Bool = false;

node go [done == false][done == true] {
    when done == false {
        m.insert((1, 7));
        println!(m.get(1));
        println!(m.get(99));
        done = true;
    };
    term;
};
