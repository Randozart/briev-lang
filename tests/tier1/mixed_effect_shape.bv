// mixed_effect_shape — regression fixture for the effect-shape selector.
// Two sync-group loops in one program:
//   * `direct` is direct Float arithmetic -> escaped effect context;
//   * `temp`  captures old values in lets first    -> stateless SROA shape.
// The program-level selector picks escaped because `direct` is present; the
// guard checks that both loop shapes still run and produce the same multiset
// of output regardless of the effect shape.
let d0: Float = 1.0;
let d1: Float = 0.5;
let d2: Float = 0.3333333333333333;
let d3: Float = 0.25;
let d4: Float = 0.2;
let d5: Float = 0.16666666666666666;
let d6: Float = 0.14285714285714285;
let d7: Float = 0.125;
let t0: Float = 1.0;
let t1: Float = 0.5;
let t2: Float = 0.3333333333333333;
let t3: Float = 0.25;
let t4: Float = 0.2;
let t5: Float = 0.16666666666666666;
let t6: Float = 0.14285714285714285;
let t7: Float = 0.125;
let ca: Int = 0;
let cb: Int = 0;
let total: Int = get_env_int!("BOUND");

sync<mixed> node direct [ca < total][ca == total] {
    d0 = d0 * 0.999 + d1 * 0.001;
    d1 = d1 * 0.999 + d2 * 0.001;
    d2 = d2 * 0.999 + d3 * 0.001;
    d3 = d3 * 0.999 + d4 * 0.001;
    d4 = d4 * 0.999 + d5 * 0.001;
    d5 = d5 * 0.999 + d6 * 0.001;
    d6 = d6 * 0.999 + d7 * 0.001;
    d7 = d7 * 0.999 + d0 * 0.001;
    ca = ca + 1;
    when ca % 1000000 == 0 { println!(d0 + d1 + d2 + d3 + d4 + d5 + d6 + d7); };
    term;
};

sync<mixed> node temp [cb < total][cb == total] {
    let n0: Float = t0 * 0.999 + t1 * 0.001;
    let n1: Float = t1 * 0.999 + t2 * 0.001;
    let n2: Float = t2 * 0.999 + t3 * 0.001;
    let n3: Float = t3 * 0.999 + t4 * 0.001;
    let n4: Float = t4 * 0.999 + t5 * 0.001;
    let n5: Float = t5 * 0.999 + t6 * 0.001;
    let n6: Float = t6 * 0.999 + t7 * 0.001;
    let n7: Float = t7 * 0.999 + t0 * 0.001;
    t0 = n0;
    t1 = n1;
    t2 = n2;
    t3 = n3;
    t4 = n4;
    t5 = n5;
    t6 = n6;
    t7 = n7;
    cb = cb + 1;
    when cb % 1000000 == 0 { println!(t0 + t1 + t2 + t3 + t4 + t5 + t6 + t7); };
    term;
};
