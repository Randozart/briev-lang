// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// 2026-11-17 (BUGS.md 2026-11-15, "Data-to-Float width mismatch emits an
// invalid bitcast"): the Data→Float route is a REINTERPRETATION of the low 32
// bits, so `(0x40490FDB as Data) as Float` must be π. The bitcast lane used to
// fall through to `bitcast i64 %v to float`, which LLVM rejects outright (a
// bitcast may not change width), so this program did not compile at all.
//
// The value matters: 0x40490FDB is 1078530011 as an integer. A value
// conversion (sitofp) would print 1078530011; a truncation to i32 followed by a
// bitcast prints 3.14159274. Only the second is the declared contract.
import "std/io.bv";

node entry [beginprogram][true] {
    let pi: Float = (0x40490FDB as Data) as Float;
    print_float(pi);
    print_str("\n");
    endprogram 0;
};
