obj Row { done: Bool; };
defn make(done: Bool) -> Row { term Row { done: done }; };
let tick: Int = 0;
let row: Row = make(true);
txn probe [tick == 0][tick == 1] { tick = 1; term; };
<view><span b-text="tick">0</span></view>
