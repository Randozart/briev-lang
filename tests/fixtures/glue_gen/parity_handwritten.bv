// S3/G4' parity pair — variant B: the same declarations written by hand.
import "std/io.bv";
// 2026-11-18: the protocol axioms name the ops (`str_to_c` / `cstr_to_briev`)
// but nothing defines them — they live in `glue/c.bv`. The emitter fires the
// lane at the call site and emits `call @str_to_c` with no declaration, which
// is invalid IR: `--llvm` now verifies the module (`verify_ir`, default ON) and
// rejects it with "use of undefined value '@str_to_c'". Importing the ops
// module is what a user of this protocol needs to do anyway; the generator
// does not emit it yet (glue schema has types_module but no ops module).
// Added to BOTH variants at the same position so the parity gate still differs
// only in how the protocol declarations were written.
import "glue/c.bv";
import "./handwritten_glue.bv";

// The foreign signature takes the boundary type, so the meld fires the protocol's
// CastFrom (str_to_c, zero-copy) at the call site — no explicit cast needed.
frgn c_strlen(s: CStr) -> Int from #Link<libc>;

let done: Bool = false;

node main [!done][done] {
    // Direction 1 (Briev -> C): the zero-copy view lane.
    let s: String = "hi";
    let n: Int = c_strlen(s);
    // Direction 2 (C -> Briev): the copying lane through the same protocol.
    let back: String = "yo" as CStr as String;
    Print#(n + (back .^Length));
    done = true;
    endprogram;
};
