import "std/process.bv";

defn capture_byte(value: String, offset: Int) -> Int {
    term Load#(((value as Data) as Int) + 8 + offset, 1);
};

defn process_probe() -> Bool {
    when Spawn#("") != 0 { term false; };
    when run("exit 7") != 7 { term false; };
    when Spawn#("kill -TERM $$") != -1 { term false; };
    let text: String = spawn_with_output("printf 'first\\nsecond'; exit 9");
    when text != "first\nsecond" { term false; };
    let empty: String = SpawnWithOutput#("exit 0");
    when empty != "" { term false; };
    let long: String = SpawnWithOutput#("printf '%05000d' 0");
    when long .^Length != 5000 { term false; };
    when capture_byte(long, 0) != 48 || capture_byte(long, 4999) != 48 { term false; };
    let binary: String = SpawnWithOutput#("printf 'a\\000b'");
    when binary .^Length != 3 { term false; };
    term capture_byte(binary, 0) == 97 && capture_byte(binary, 1) == 0 &&
        capture_byte(binary, 2) == 98;
};

test shell_processes { expect process_probe(); };
node main [beginprogram][true] {
    when !process_probe() { endprogram 1; };
    println!("process_spawn_ok");
    endprogram;
};
