// Short-circuit guards over trapping / UB arithmetic.
//
// 2026-11-26 (BUGS.md 2026-11-09): `e != 0 && s / e > 0` was lowered with an
// eager `and`, emitting `sdiv` BEFORE the branch. With `e == 0` the division
// the left operand was meant to skip executed anyway — a trapping/UB division
// that produced corrupted output. The same class covers `Mod` (divide by
// zero) and `Shl`/`Shr` (shift by >= the bit width). These ops are not
// speculation-safe and must stay on the lazy `&&`/`||` edge.
defn and_div(s: Int, e: Int) -> Int { when e != 0 && s / e > 0 { term 1; }; term 0; };
defn or_div(s: Int, e: Int) -> Int { when e == 0 || s / e > 0 { term 1; }; term 0; };
defn and_mod(s: Int, e: Int) -> Int { when e != 0 && s % e == 0 { term 1; }; term 0; };
defn and_shl(s: Int, e: Int) -> Int { when e < 64 && (s << e) > 0 { term 1; }; term 0; };
defn and_shr(s: Int, e: Int) -> Int { when e < 64 && (s >> e) > 0 { term 1; }; term 0; };
let done: Int = 0;

node main [done == 0][done == 1] {
    println!("{} {} {} {} {} {} {} {} {} {}",
        and_div(0, 0), and_div(6, 2),
        or_div(0, 0), or_div(6, 2),
        and_mod(0, 0), and_mod(6, 2),
        and_shl(0, 64), and_shl(1, 3),
        and_shr(0, 64), and_shr(8, 1));
    done = 1;
    endprogram;
};
