coll struct FixedSlots<T> { data: T[2]; };
struct PairValue { left: Int; right: Int; };
obj ObjectValue { left: Int; right: Int; };
enum ChoiceValue { Selected(Int), Missing };
defn choice_number(choice: ChoiceValue) -> Int {
    term match choice { Selected(value) => value, Missing() => 0 };
};
let done: Bool = false;
node main [!done][done] {
    let records: FixedSlots<PairValue> = [
        PairValue { left: 1, right: 2 }, PairValue { left: 3, right: 4 }
    ];
    when records[0].left != 1 || records[1].right != 4 { endprogram 1; };
    records[1] = PairValue { left: 5, right: 6 };
    when records[0].right != 2 || records[1].left != 5 || records[1].right != 6 { endprogram 2; };
    let memory: Ptr<Int> = Malloc#(8) as Ptr<Int>;
    Store#(memory as Int,42,8);
    let pointers: FixedSlots<Ptr<Int>> = [memory,memory];
    when Load#(pointers[0] as Int,8) != 42 || Load#(pointers[1] as Int,8) != 42 { endprogram 3; };
    Free#(memory as Ptr);
    let partial: FixedSlots<Int> = [9];
    when partial[0] != 9 || partial[1] != 0 { endprogram 4; };
    let objects: FixedSlots<ObjectValue> = [
        ObjectValue { left: 1, right: 2 }, ObjectValue { left: 3, right: 4 }
    ];
    when objects[1].left != 3 { endprogram 5; };
    objects[1] = ObjectValue { left: 5, right: 6 };
    when objects[0].right != 2 || objects[1].right != 6 { endprogram 6; };
    let strings: FixedSlots<String> = ["a","bc"];
    when strings[1] .^Length != 2 { endprogram 7; };
    strings[1] = "xyz";
    when strings[0] .^Length != 1 || strings[1] .^Length != 3 { endprogram 8; };
    let choices: FixedSlots<ChoiceValue> = [Selected(7),Missing()];
    when choice_number(choices[0]) != 7 || choice_number(choices[1]) != 0 { endprogram 9; };
    choices[1] = Selected(11);
    when choice_number(choices[0]) != 7 || choice_number(choices[1]) != 11 { endprogram 10; };
    println!("fixed_collection_element_layouts_ok");
    done = true;
    endprogram;
};
