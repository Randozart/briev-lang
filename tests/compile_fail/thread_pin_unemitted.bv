// 2026-11-15 (thread-assignment plan): `on thread <N>` is parsed, validated and
// proved, but this build carries no threaded dispatch lane. Running the workers
// sequentially would reorder node firing, and dispatch order is observable —
// so the pin is refused rather than silently ignored or silently reordered.
// EXPECT-ERROR: `on thread <N>` is validated but cannot be emitted yet
let counter_a: Int = 0;
let counter_b: Int = 0;

async on thread 0 node bump_a [counter_a < 3][counter_a == 3] {
    counter_a = counter_a + 1;
    term;
};

async on thread 1 node bump_b [counter_b < 3][counter_b == 3] {
    counter_b = counter_b + 1;
    term;
};
