program
  global x ty=Some(Custom("Int")) storage=None state_decl=false modifiers=[]
    expr#NodeId(1) ty=Custom("Int") lit Int(0)
  global done ty=Some(Custom("Bool")) storage=None state_decl=false modifiers=[]
    expr#NodeId(3) ty=Custom("Bool") lit Bool(false)
  callable n kind=Transaction owner=None exported=false symbol=None result=None type_params=[] variadic=false sync=[] trait_default=false impl_fn=false outputs=[]
    params []
    contract pre
      expr#NodeId(6) ty=- binary Eq
        expr#NodeId(4) ty=- ident done
        expr#NodeId(5) ty=Custom("Bool") lit Bool(false)
    contract post
      expr#NodeId(9) ty=- binary Eq
        expr#NodeId(7) ty=- ident done
        expr#NodeId(8) ty=Custom("Bool") lit Bool(true)
    guarded#NodeId(17)
      expr#NodeId(13) ty=- binary Gt
        expr#NodeId(11) ty=- ident x
        expr#NodeId(12) ty=Custom("Int") lit Int(0)
      assign#NodeId(16)
        expr#NodeId(14) ty=- ident x
        expr#NodeId(15) ty=Custom("Int") lit Int(1)
    guarded#NodeId(24)
      expr#NodeId(20) ty=- binary Eq
        expr#NodeId(18) ty=- ident x
        expr#NodeId(19) ty=Custom("Int") lit Int(0)
      assign#NodeId(23)
        expr#NodeId(21) ty=- ident x
        expr#NodeId(22) ty=Custom("Int") lit Int(2)
    assign#NodeId(27)
      expr#NodeId(25) ty=- ident done
      expr#NodeId(26) ty=Custom("Bool") lit Bool(true)
    term#NodeId(28)
