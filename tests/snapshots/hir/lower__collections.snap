program
  type Point kind=Struct { fields: [HirField { name: "x", ty: Custom("Int") }, HirField { name: "y", ty: Custom("Int") }] } params=[] protocol=None coll=false traits=[] ops=[] binding_fns=[]
  callable f kind=Defn owner=None exported=false symbol=None result=Some(Custom("Int")) type_params=[] variadic=false sync=[] trait_default=false impl_fn=false isr=false outputs=[]
    params [p: Custom("Point"), xs: Applied("List", [Custom("Int")])]
    contract pre
      expr#NodeId(1) ty=Custom("Bool") lit Bool(true)
    contract post
      expr#NodeId(2) ty=Custom("Bool") lit Bool(true)
    term#NodeId(10)
      expr#NodeId(9) ty=- binary Add
        expr#NodeId(5) ty=- field x
          expr#NodeId(4) ty=- ident p
        expr#NodeId(8) ty=- index
          expr#NodeId(6) ty=- ident xs
          expr#NodeId(7) ty=Custom("Int") lit Int(0)
