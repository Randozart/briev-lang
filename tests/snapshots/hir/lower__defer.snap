program
  global done ty=Some(Custom("Bool")) storage=None state_decl=false modifiers=[]
    expr#NodeId(1) ty=Custom("Bool") lit Bool(false)
  callable main kind=Transaction owner=None exported=false symbol=None result=None type_params=[] variadic=false sync=[] trait_default=false impl_fn=false isr=false outputs=[]
    params []
    contract pre
      expr#NodeId(4) ty=- binary Eq
        expr#NodeId(2) ty=- ident done
        expr#NodeId(3) ty=Custom("Bool") lit Bool(false)
    contract post
      expr#NodeId(7) ty=- binary Eq
        expr#NodeId(5) ty=- ident done
        expr#NodeId(6) ty=Custom("Bool") lit Bool(true)
    defer#NodeId(12)
      expression#NodeId(11)
        expr#NodeId(10) ty=- plugin println type_args=[] chain=[]
          expr#NodeId(9) ty=Custom("Int") lit Int(7)
    expression#NodeId(15)
      expr#NodeId(14) ty=- plugin println type_args=[] chain=[]
        expr#NodeId(13) ty=Custom("Int") lit Int(1)
    assign#NodeId(18)
      expr#NodeId(16) ty=- ident done
      expr#NodeId(17) ty=Custom("Bool") lit Bool(true)
    term#NodeId(19)
