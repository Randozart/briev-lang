// ── rv64 QEMU virt profile ────────────────────────────────────────────
// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
//
// Hardware constants and reusable steps for QEMU's virt machine.
// Import explicitly: `import "std/bad/profiles/rv64-qemu-virt.bad"`.

.const UART0 0x10000000
.const UART_DR 0x00
.const UART_CR 0x30

defn uart_init(base: Ptr) {
    // QEMU virt is an NS16550A; its reset state is usable. Do not write
    // PL011 offsets (0x30 is outside the implemented 16550 window and
    // faults the bus). Keep the named step for profile symmetry.
}

defn uart_putc(base: Ptr, ch: Int) {
    Store(ch, base + UART_DR)
}
