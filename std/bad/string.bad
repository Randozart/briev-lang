// ── std/bad/string.bad — .bad stdlib, string + memory primitives ──────
// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
//
// 2026-09-21 (application-grade plan Phase D): pure-.bad stdlib — the
// expressiveness-closure proof: the dialect writes its own library with
// zero compiler help beyond the core ISA.
//
// .bad internal calling convention (documented in bad-dialect.md):
//   args in r0, r1, r2; result in r0; r3-r5 are scratch (caller-saved
//   on all three targets); frame 0; everything else preserved.
// C-ABI wrappers can layer on top via the abi_args map.

// memcpy(dst: r0, src: r1, n: r2) -> r0
memcpy: [frame: 0] [r0 valid]
    mov r3, r0
.loop:
    jz r2, 0, .done
    ldb r5, r1
    stb r5, r0
    add r0, r0, 1
    add r1, r1, 1
    sub r2, r2, 1
    jmp .loop
.done:
    mov r0, r3
    ret

// memset(dst: r0, val: r1, n: r2) -> r0
memset: [frame: 0] [r0 valid]
    mov r3, r0
.loop:
    jz r2, 0, .done
    stb r1, r0
    add r0, r0, 1
    sub r2, r2, 1
    jmp .loop
.done:
    mov r0, r3
    ret

// strlen(s: r0) -> r0
strlen: [frame: 0]
    mov r1, r0
.loop:
    ldb r2, r0
    jz r2, 0, .done
    add r0, r0, 1
    jmp .loop
.done:
    sub r0, r0, r1
    ret

// strcmp(a: r0, b: r1) -> r0  (0 equal, else the first differing pair's
// signed difference — the classic C contract)
strcmp: [frame: 0]
.loop:
    ldb r2, r0
    ldb r3, r1
    sub r4, r2, r3
    jnz r4, 0, .done
    jz r2, 0, .done
    add r0, r0, 1
    add r1, r1, 1
    jmp .loop
.done:
    mov r0, r4
    ret
