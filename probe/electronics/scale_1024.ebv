// scale_32x32 — auto-generated wildcard mass matrix
type R {
    pin a;
    pin b;
    reference "R";
    spec Tolerance: any;
};
type J {
    pin p1 = 1;
    pin p2 = 2;
    reference "J";
    spec Tolerance: any;
    spec Rating: any;
};
let j1: J = J { value: "JST-PH-2", package: "JST-PH" };
let t[i:32][j:32]: R = R { value: "100R", package: "0603" };
async node tile
    [j1.p1.voltage == t[*].a.voltage
     && j1.p2.voltage == t[*].b.voltage
     && j1.p1.voltage == 3.3Volt && j1.p2.voltage == 0.0Volt]
    [j1.p1.voltage >= 0.0Volt]
{
}
